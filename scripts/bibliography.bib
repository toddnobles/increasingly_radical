	issn = {0950-0170},
	journaltitle = {Work, Employment and Society},
	langid = {english},
	pages = {09500170221080870},
	publisher = {SAGE Publications Ltd},
	shorttitle = {Working from {{Home}} in {{Urban China}} during the {{COVID-19 Pandemic}}},
	title = {Working from {{Home}} in {{Urban China}} during the {{COVID-19 Pandemic}}: {{Assemblages}} of {{Work-Family Interference}}},
	url = {https://doi.org/10.1177/09500170221080870},
	urldate = {2022-12-10},
