	shorttitle = {Marital {{Fertility Decline}} in the {{Netherlands}}},
	title = {Marital {{Fertility Decline}} in the {{Netherlands}}: {{Child Mortality}}, {{Real Wages}}, and {{Unemployment}}, 1860--1939},
