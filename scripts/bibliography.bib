	issn = {1468-4446},
	journaltitle = {The British Journal of Sociology},
	keywords = {2016 presidential election,inequality,racism,Trump},
	langid = {english},
	number = {S1},
	pages = {S85-S104},
	shorttitle = {Racism in {{Trump}}'s {{America}}},
	title = {Racism in {{Trump}}'s {{America}}: Reflections on Culture, Sociology, and the 2016 {{US}} Presidential Election},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/1468-4446.12324},
	urldate = {2024-05-03},
	volume = {68},
