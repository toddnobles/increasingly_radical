	langid = {english},
	number = {1},
	pages = {83--117},
	shorttitle = {The {{Power}} of {{Market Intermediaries}}},
	title = {The {{Power}} of {{Market Intermediaries}}: {{From Information}} to {{Valuation Processes}}},
