	publisher = {Cambridge University Press},
	shorttitle = {Support at {{Any Distance}}?},
	title = {Support at {{Any Distance}}? {{The Role}} of {{Location}} and {{Prejudice}} in {{Public Opposition}} to the ``{{Ground Zero Mosque}}''},
