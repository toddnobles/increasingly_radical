@book{nadeauCooperativeSolutionHow,
	author = {Nadeau, E. G.},
	isbn = {978-1-4782-9826-7},
	note = {\begin{itemize} \item \par pg 77 on how cooperatives may be able to shape market practices by setting a competitive alternative for consumers to choose. For example around ATM fees where banks stopped charging them after coops dropped them \par \begin{itemize} \item a similar thing could happen with working conditions (not a final goal but at least a temporary improvement for many workers). Coops could gain a foothold in an industry and provide an appealing alternative that tradiitional firms would need to compete with to retain workers \end{itemize} \item I think I'm primarily interested in the intersection of worker owned cooperatives, wages, and time. I see the value of consumer coops, farm coops, electric coops, financial coops, etc to change the incentive structure of large organizations in our society, but there's something specific about the day to day existence of having the power to democratically determine how one's spends their time \item large piece of the appeal of coops is it removes the rent seeking middlemen of the economy (landlords, bank fees, administrative fees for utilities) \item Things that are close to cooperatives but not quite, condo associations, ESOPs \end{itemize}},
	title = {The {{Cooperative Solution}}: {{How}} the {{United States}} Can Tame Recessions, Reduce Inequality, and Protect the Environment}}

@article{nadeauInnumeracyMinorityPopulations1993,
	abstract = {We use a small but nationally representative sample to investigate the sources of innumeracy regarding the proportion of blacks, Hispanics, and Jews in the U.S. population. In addition to a number of standard demographic differences, we find that overestimates are closely related to region as well as to the density of the local black/Hispanic population. The extent to which minority populations are perceived as a kind of threat is also related to perceived proportions, though the direction of causality cannot be determined. We discuss the meaningfulness of these population estimates and speculate on whether trying to improve them would alter attitudes toward minorities.},
	annotation = {112 citations (Crossref) [2024-05-04]},
