	pages = {481--499},
	shorttitle = {The {{Five Paradoxes}} of {{Meaningful Work}}},
	title = {The {{Five Paradoxes}} of {{Meaningful Work}}: {{Introduction}} to the Special {{Issue}} `{{Meaningful Work}}: {{Prospects}} for the 21st {{Century}}'},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/joms.12422},
