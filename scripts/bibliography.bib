@article{filipalexandrescuNotNaturalIt2009,
	abstract = {This article argues against Catton and Dunlap's claims that the natural environment has been ignored or downplayed in American sociology before the emergence of environmental sociology in the 1970s. By reviewing a collection of 86 sociology textbooks between 1894 and 1980, the article provides quantitative evidence regarding the scope and types of references to the natural environment in mainstream sociology. The bulk of the article is based on an interpretive-historical analysis of the different representations of the environment in the textbook literature. This analysis is carried out from the perspective of the sociology of knowledge, whereby sociological ideas about nature are interpreted in terms of their intellectual milieu and social context. The main finding is that the `natural environment' has been interpreted in different ways and has been put to a variety of epistemological and ideological uses --- particularly positivism and functionalism --- throughout the history of the discipline.},
	author = {{Filip Alexandrescu} and {Filip Alexandrescu}},
	date = {2009},
	doi = {10.1177/0952695109347164},
	journaltitle = {History of the Human Sciences},
	keywords = {/unread},
	shortjournal = {History of the Human Sciences},
	title = {Not as Natural as It Seems: The Social History of the Environment in {{American}} Sociology:},
	bdsk-url-1 = {https://doi.org/10.1177/0952695109347164}}

@online{filippasReputationInflation2019,
	abstract = {A solution to marketplace information asymmetries is to have trading partners publicly rate each other post-transaction. Many have shown that these ratings are effective; we show that their effectiveness deteriorates over time. The problem is that ratings are prone to inflation, with raters feeling pressure to leave ``above average'' ratings, which in turn pushes the average higher. This pressure stems from raters' desire to not harm the rated seller. As the potential to harm is what makes ratings effective, reputation systems, as currently designed, sow the seeds of their own irrelevance.},
	author = {Filippas, Apostolos and Horton, John J. and Golden, Joseph M.},
	date = {2019-05},
	doi = {10.3386/w25857},
	eprint = {25857},
