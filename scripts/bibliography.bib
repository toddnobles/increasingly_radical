	publisher = {The University of Chicago Press},
	shorttitle = {Belief {{Network Analysis}}},
	title = {Belief {{Network Analysis}}: {{A Relational Approach}} to {{Understanding}} the {{Structure}} of {{Attitudes}}},
	url = {https://www-journals-uchicago-edu.offcampus.lib.washington.edu/doi/full/10.1086/691274},
