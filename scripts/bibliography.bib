	journaltitle = {Y{\"o}netim ve Ekonomi: Celal Bayar {\"U}niversitesi {\.I}ktisadi ve {\.I}dari Bilimler Fak{\"u}ltesi Dergisi},
	langid = {english},
	title = {Foucault, {{Publıc Fınance And Neolıberal Governmentalıty A Crıtıcal Socıologıcal Analysıs}}},
	url = {https://dergipark.org.tr/en/doi/10.18657/yonveek.449581},
