@article{ciroliaSiliconSavannahsMotorcycle2023,
	abstract = {The rise of digital platforms in urban Africa has been rightfully critiqued as an example of global techno-capital seeking new frontiers of profit among precarious lives and from fragile infrastructures. However, this techno-pessimistic reading of so-called ``platform urbanism'' leaves us with a bleak outlook on the future of the African city as a mere site of accumulation and exploitation. In this article, in contrast, we offer a more ambivalent analysis of a compelling trend in several African cities: the platformization of motorcycle taxis. Our focus is on Kigali and Nairobi two cities that have been celebrated as ``Silicon Savannahs'' for their commitment to digital innovation, and where motorcycle taxis have long contributed to the regular movement of people and goods. Deploying a Southern urban perspective on the digitization of these mobility systems, we make two contributions to platform urbanism debates. First, we show that this phenomenon dovetails two decades of supply-side, developmental investments in the connectivity infrastructure upon which platforms rely and are predicated. Second, we show that platform urbanism is not simply a case of global technologies landing in Africa. It is characterized by a proliferation of experiments in which domestic and international capital coalesce, platforms intersect in dynamic ways with informal economies, and local adaptations are necessary for survival. Overall, we argue that the platformization of motorcycles in these cities (and arguably others) constitutes a dynamic and evolving landscape that requires more careful conceptual and empirical attention.},
	author = {Cirolia, Liza Rose and Sitas, Rike and Pollio, Andrea and Sebarenzi, Alexis Gatoni and Guma, Prince K},
	date = {2023-05-01},
	doi = {10.1177/0308518X231170193},
	file = {Cirolia et al_2023_Silicon Savannahs and motorcycle taxis0308518X231170193.pdf},
	issn = {0308-518X},
	journaltitle = {Environment and Planning A: Economy and Space},
	keywords = {/unread},
	langid = {english},
	pages = {0308518X231170193},
	publisher = {SAGE Publications Ltd},
	shortjournal = {Environ Plan A},
	shorttitle = {Silicon {{Savannahs}} and Motorcycle Taxis},
	title = {Silicon {{Savannahs}} and Motorcycle Taxis: {{A Southern}} Perspective on the Frontiers of Platform Urbanism},
	url = {https://doi.org/10.1177/0308518X231170193},
	urldate = {2023-09-06},
	bdsk-url-1 = {https://doi.org/10.1177/0308518X231170193}}

@article{cironePressurePoliticalGeography,
	author = {Cirone, Alexandra},
	file = {Cirone_Under Pressure.pdf},
	langid = {english},
	note = {\textbf{Extracted Annotations (10/23/2021, 10:25:28 PM)} \par "Further, it is suggestive that increased electoral competition and the creation of permanent party organizations in France map closely to urbanization and economic recovery at the turn of the century (McPhee, 2004); however, this has never been empirically teste" (\href{zotero://open-pdf/library/items/RWH3GIKW?page=3}{Cirone :64}) \par "We will never witness the true counterfactual, in that we can never see how political outcomes may have been dierent if France had industrialized sooner, or had staggered enfranchisement. However, luckily in the French case, a historical agricultural crisis can help simulate a counterfactual, by providing insight into how local shifts in electoral geography provide bottom up pressures that in turn shaped political activit" (\href{zotero://open-pdf/library/items/RWH3GIKW?page=3}{Cirone :64}) \par "I exploit a signicant and exogenous shock to local population, in the form of the phylloxera wine blight that destroyed 40 percent of French vineyards between 1863 and 1890. This crisis let to signicant patterns of urbanization, as agricultural workers unable to nd work on farms migrated from the country to nearby towns. At the time, the cause of the blight was unknown and the spread of infestation was unpredictable, and thus exposure to the blight can be conceptualized \textbackslash as if" randomly assigned." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=3}{Cirone :64}) \par \mkbibemph{is it truly unpredictable? was the blight activated by certain environmental conditions or was it spread like mushroom spores in that it needs to spread to nearby areas gradually? (\href{zotero://open-pdf/library/items/RWH3GIKW?page=3}{note on p.64})} \par "he wine blight was an exogenous shock that increased the size and density of the electorate, but didn't come with the rise of a new economic class or political cleavage, allowing me to better isolate the simple mechanism of costs to coordination." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=4}{Cirone :65}) \par \mkbibemph{didn't it create a new class of urban factory workers? (\href{zotero://open-pdf/library/items/RWH3GIKW?page=4}{note on p.65})} \par "I nd that departments that were aected by the blight saw an increase in their municipal population, in particular the chief town." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=5}{Cirone :66}) \par "Yet I nd a statistically signicant and positive eect of urbanization on group formation; exogenous population shocks increased the likelihood of having a political association in 1901." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=5}{Cirone :66}) \par "This paper seeks to test the simple idea that the greater concentration of individuals in a district lowers barriers to political organization." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=9}{Cirone :70}) \par "The dependent variables measure political competition and mobilization, at the depart-r of candidates in the nal round, the number of races that went to a second ballot, the average electoral margin (\%), and average turnout (\%)." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=22}{Cirone :83}) \par "This instrument measures treatment intensity, and it also assumes that the marginal eects are constant and that the treatment eect is linear. The longer the period of exposure, the more likely French citizens would move to urban areas, and thereby increase the aggregate municipal population." (\href{zotero://open-pdf/library/items/RWH3GIKW?page=24}{Cirone :85}) \par "I restrict my sample to the 40 agricultural districts in the analysis that had both a signicant portion of its working population employed in agriculture in 1866, and that were a wine producing district (Galet, 1957)" (\href{zotero://open-pdf/library/items/RWH3GIKW?page=26}{Cirone :87}) \par "This instrument is valid only if the years of phylloxera exposure is correlated with munici-n only via changes to population (exclusion restriction). T" (\href{zotero://open-pdf/library/items/RWH3GIKW?page=28}{Cirone :89}) \par \begin{itemize} \item research question: effects of urbanization on two types of elecoral outcomes: levels of political competition, and growth of political associations \begin{itemize} \item explaining pattern in france that doesn't match other countries. it remained unorganized politically for far longer \end{itemize} \item data: \item methods: The dependent variables measure political competition and mobilization, at the department level. For competition, I rely on a number of standard measures, including the number\\ of candidates in the final round, the number of races that went to a second ballot, the average\\ electoral margin (\%), and average turnout (\%) \item findings: How might results change if the treatment effect is not linear. That is people hang around for a bit, then finally move, but a sizeable portion never leaves. (majority of movement in year 3) for example. \item reaction: \end{itemize}},
	pages = {62},
	title = {Under {{Pressure}}: {{Political Geography}} of {{Mobilization}}}}

