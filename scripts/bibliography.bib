	shortjournal = {Socio-Economic Review},
	shorttitle = {On {{Sarah L}}. {{Quinn}}'s {{American Bonds}}. {{How Credit Markets Shaped}} a {{Nation}}, {{Princeton}}, {{NJ}}},
	title = {On {{Sarah L}}. {{Quinn}}'s {{American Bonds}}. {{How Credit Markets Shaped}} a {{Nation}}, {{Princeton}}, {{NJ}}: {{Princeton University Press}}, 2019},
