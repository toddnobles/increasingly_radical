	journaltitle = {American Political Science Review},
	langid = {english},
	number = {2},
	pages = {344--361},
	shortjournal = {Am Polit Sci Rev},
	shorttitle = {Crossing the {{Line}}},
	title = {Crossing the {{Line}}: {{Local Ethnic Geography}} and {{Voting}} in {{Ghana}}},
	url = {https://www.cambridge.org/core/product/identifier/S0003055412000664/type/journal_article},
	urldate = {2021-10-29},
	volume = {107},
	bdsk-url-1 = {https://www.cambridge.org/core/product/identifier/S0003055412000664/type/journal_article},
