	number = {9},
	pages = {095007},
	publisher = {IOP Publishing},
	shortjournal = {Environ. Res. Commun.},
	shorttitle = {Connecting Physical and Social Science Datasets},
	title = {Connecting Physical and Social Science Datasets: Challenges and Pathways Forward},
