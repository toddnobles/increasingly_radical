@incollection{thomasClassicLiberalismPropertyowning2016,
	abstract = {John Tomasi has defended a free market fairness research program with one specific approach that best realizes its values: market democracy. The key to this program is that economic liberty is given a ``robust'' protection so that it is analogous to religious liberty. Tomasi argues that John Rawls failed to give the economic liberties of the individual sufficiently strong protection. In this chapter it is argued both that Tomasi was wrong about Rawls and that the only stable implementation of the free market fairness research program will be the egalitarian form of a property-owning democracy defended in this book. Like G. A. Cohen, Tomasi does not consider Rawls's views in their fully specified form. Within a liberal-republican framework economic liberty is robustly protected. Tomasi's view, by contrast, is unrealistically utopian about the historical development of capital and without the correct background context market democracy will be unstable in the long run.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0010},
