	number = {1},
	pages = {67--91},
	shorttitle = {Carbon {{Valuation}}},
	title = {Carbon {{Valuation}}: {{Alternatives}}, {{Alternations}} and {{Lateral Measures}}?},
	url = {https://valuationstudies.liu.se/article/view/835},
	urldate = {2023-09-06},
	volume = {4},
