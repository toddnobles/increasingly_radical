	pages = {397--420},
	shortjournal = {International Journal of Public Opinion Research},
	title = {How {{Issue Salience Explains}} the {{Rise}} of the {{Populist Right}} in {{Western Europe}}},
	url = {https://doi.org/10.1093/ijpor/edz022},
