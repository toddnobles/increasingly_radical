	issn = {0020-8833},
	journaltitle = {International Studies Quarterly},
	number = {1},
	pages = {117--142},
	shortjournal = {International Studies Quarterly},
	shorttitle = {Exploring the {{Subnational Dimension}} of {{Income Inequality}}},
	title = {Exploring the {{Subnational Dimension}} of {{Income Inequality}}: {{An Analysis}} of the {{Relationship Between Inequality}} and {{Electoral Turnout}} in the {{Developed Countries}}},
	url = {https://doi.org/10.1111/1468-2478.00225},
	urldate = {2021-11-16},
	volume = {46},
