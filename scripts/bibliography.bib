@article{dellHistoricalStateLocal2018,
	abstract = {This study examines how the historical state conditions long-run development, using Vietnam as a laboratory. Northern Vietnam (Dai Viet) was ruled by a strong, centralized state in which the village was the fundamental administrative unit. Southern Vietnam was a peripheral tributary of the Khmer (Cambodian) Empire, which followed a patron-client model with more informal, personalized power relations and no village intermediation. Using a regression discontinuity design, the study shows that areas exposed to Dai Viet administrative institutions for a longer period prior to French colonization have experienced better economic outcomes over the past 150 years. Rich historical data document that in Dai Viet villages, citizens have been better able to organize for public goods and redistribution through civil society and local government. We argue that institutionalized village governance crowded in local cooperation and that these norms persisted long after the original institutions disappeared.},
	author = {Dell, Melissa and Lane, Nathan and Querubin, Pablo},
	date = {2018},
	doi = {10.3982/ECTA15122},
	file = {Dell et al_2018_The Historical State, Local Collective Action, and Economic Development in.pdf;../../../Zotero/storage/JBP2W3MZ/ECTA15122.html},
	issn = {1468-0262},
	journaltitle = {Econometrica},
	keywords = {Collective action,economic development,governance},
	langid = {english},
	number = {6},
	pages = {2083--2121},
	title = {The {{Historical State}}, {{Local Collective Action}}, and {{Economic Development}} in {{Vietnam}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.3982/ECTA15122},
	urldate = {2021-11-22},
	volume = {86},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/abs/10.3982/ECTA15122},
	bdsk-url-2 = {https://doi.org/10.3982/ECTA15122}}

@article{dellWhatWeLearn2014,
	abstract = {A rapidly growing body of research applies panel methods to examine how temperature, precipitation, and windstorms influence economic outcomes. These studies focus on changes in weather realizations over time within a given spatial area and demonstrate impacts on agricultural output, industrial output, labor productivity, energy demand, health, conflict, and economic growth, among other outcomes. By harnessing exogenous variation over time within a given spatial unit, these studies help credibly identify (i) the breadth of channels linking weather and the economy, (ii) heterogeneous treatment effects across different types of locations, and (iii) nonlinear effects of weather variables. This paper reviews the new literature with two purposes. First, we summarize recent work, providing a guide to its methodologies, datasets, and findings. Second, we consider applications of the new literature, including insights for the "damage function" within models that seek to assess the potential economic effects of future climate change.},
	author = {Dell, Melissa and Jones, Benjamin F. and Olken, Benjamin A.},
	date = {2014-09},
	doi = {10.1257/jel.52.3.740},
	file = {Dell et al_2014_What Do We Learn from the Weather.pdf;../../../Zotero/storage/ZP3J7QHN/articles.html},
	issn = {0022-0515},
	journaltitle = {Journal of Economic Literature},
	keywords = {Energy,Environment,Global Warming,Model Construction and Estimation Political Processes: Rent-seeking Lobbying Elections Legislatures and Voting Behavior Economic Development: Agriculture,Natural Disasters,Natural Resources,Other Primary Products Valuation of Environmental Effects Climate},
	langid = {english},
	number = {3},
	pages = {740--798},
	shorttitle = {What {{Do We Learn}} from the {{Weather}}?},
	title = {What {{Do We Learn}} from the {{Weather}}? {{The New Climate-Economy Literature}}},
	url = {https://www.aeaweb.org/articles?id=10.1257/jel.52.3.740},
	urldate = {2021-11-15},
	volume = {52},
	bdsk-url-1 = {https://www.aeaweb.org/articles?id=10.1257/jel.52.3.740},
	bdsk-url-2 = {https://doi.org/10.1257/jel.52.3.740}}

@article{demilNeitherMarketHierarchy2006,
	abstract = {A growing body of literature describes the open source phenomenon in the software industry. Drawing on transaction cost economics, we propose that open source projects illustrate a new generic governance structure ? which we label bazaar governance ? based on a specific legal contract: the open licence. We characterize this structure in terms of its strengths and weaknesses and compare it to market, firm and network forms. Low levels of control and weak incentives intensity are distinctive features of bazaar, lending a high uncertainty to governed transactions. However, bazaar governance promotes the openness of open source communities, which can generate strong positive network externalities and subsequent efficiency in cumulative transactions. Our theoretical developments offer a potential basis for future research.},
	author = {Demil, Beno{\^\i}t and Lecocq, Xavier},
	date = {2006-10-01},
	doi = {10.1177/0170840606067250},
	file = {Demil_Lecocq_2006_Neither Market nor Hierarchy nor Network1447-1466.pdf},
	issn = {0170-8406},
	journaltitle = {Organization Studies},
	langid = {english},
	number = {10},
	pages = {1447--1466},
	publisher = {SAGE Publications Ltd},
	shorttitle = {Neither {{Market}} nor {{Hierarchy}} nor {{Network}}},
	title = {Neither {{Market}} nor {{Hierarchy}} nor {{Network}}: {{The Emergence}} of {{Bazaar Governance}}},
	url = {https://doi.org/10.1177/0170840606067250},
	urldate = {2022-11-14},
	volume = {27},
	bdsk-url-1 = {https://doi.org/10.1177/0170840606067250}}

@article{dennisonBasicHumanValues2020,
	abstract = {This article considers what types of strategic communication messaging regarding migration policy are likely to be more or less effective. To do so, the article summarizes the literature to, first, note the broadly postulated effectiveness of value-based messaging and, second, note how underdefined this concept remains. To overcome this shortcoming, I introduce Schwarz's psychological theory of ``basic human values'' and use European Social Survey data to visualize the relationship between these values and attitudes to immigration. I argue that messaging with a value-basis that is concordant with that of its audience is more likely to elicit sympathy, whereas that which is discordant with the values of its audience is more likely to elicit antipathy. Given the value-balanced orientations of those with moderate attitudes to immigration, persuasive migration messaging should attempt to mobilize values of its opposition; that is pro-migration messaging should mobilize Schwarz's values of conformity, tradition, security, and power, whereas anti-migration messaging should mobilize values of universalism, benevolence, self-direction, and stimulation. I then turn to an inventory of 135 migration communication campaigns provided by the International Centre for Migration Policy Development. I show that few pro-migration campaigns contained value-based messaging, whereas all anti-migration campaigns did. Similarly, very few pro-migration campaigns included values besides ``universalism'' and ``benevolence,'' whereas anti-migration campaigns included values associated with both pro- and anti-migration attitudes. I visually demonstrate examples of each case before discussing ramifications for policy communication.},
	annotation = {4 citations (Crossref) [2024-05-04]},
	author = {Dennison, James},
	date = {2020-01},
	doi = {10.1017/dap.2020.17},
	file = {Dennison_2020_A basic human values approach to migration policy communicatione18.pdf},
	issn = {2632-3249},
	journaltitle = {Data \& Policy},
	keywords = {Attitudes to immigration,basic human values,migration policy,persuasive messaging,strategic communication},
	langid = {english},
	pages = {e18},
	title = {A Basic Human Values Approach to Migration Policy Communication},
	url = {https://www.cambridge.org/core/journals/data-and-policy/article/basic-human-values-approach-to-migration-policy-communication/4B85E13E98876C739ECF9BC2F42A3927},
	urldate = {2024-03-04},
	volume = {2},
	bdsk-url-1 = {https://www.cambridge.org/core/journals/data-and-policy/article/basic-human-values-approach-to-migration-policy-communication/4B85E13E98876C739ECF9BC2F42A3927},
	bdsk-url-2 = {https://doi.org/10.1017/dap.2020.17}}

@article{dennisonHowIssueSalience2020,
	abstract = {This article tests whether variation in issue salience can explain the rise of the populist right in Western Europe. By taking a novel cross-country and cross-time approach at both the aggregate- and individual levels using panel data, I robustly demonstrate that the salience of immigration positively affects electoral support for the populist right. I also find, using a structural equation modeling approach, that the salience of immigration, in turn, is partially caused by immigration rates. I do not find evidence of a positive effect of the salience of the issues of crime, unemployment, the economy, or terrorism. I find evidence of a positive effect of the salience of Europe at the individual level, which is of a similar scale to immigration.},
	annotation = {42 citations (Crossref) [2024-05-04]},
	author = {Dennison, James},
	date = {2020-09-01},
	doi = {10.1093/ijpor/edz022},
	file = {../../../Zotero/storage/4M65RD9C/5549978.html},
	issn = {1471-6909},
	journaltitle = {International Journal of Public Opinion Research},
	keywords = {/unread},
