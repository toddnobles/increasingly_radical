	langid = {english},
	number = {1},
	pages = {816},
	publisher = {Nature Publishing Group},
	shortjournal = {Sci Data},
	title = {Bilateral Flows and Rates of International Migration of Scholars for 210 Countries for the Period 1998-2020},
