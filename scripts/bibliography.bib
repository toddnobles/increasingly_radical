@article{cannizzoBasicIncomeComplex2023,
	abstract = {Proposals for a Universal Basic Income (UBI) have a long history, but a surge of interest since the global financial crisis suggests a connection to growing inequality and insecurity. The pandemic intensified interest through the global explosion in the use of cash transfers. This special issue arose from pre-pandemic debates among Australian sociologists connecting global interest around UBI to emerging patterns of inequality and insecurity stemming from Australia's precarious labour market and expensive housing market. Those discussions broadened to reflect on Australia's colonial history and patriarchal economy, and the potential to recognise more diverse contributions and values. Evolving through the Covid crisis, the issue now incorporates the remarkable alternatives that were, briefly, made possible. The articles reflect both scepticism and optimism towards UBI, but all reveal how basic income can provide a useful lens for Australian sociology -- a simple tool responding to an increasingly complex society.},
	author = {Cannizzo, Fabian and Spies-Butcher, Ben},
	date = {2023-07-06},
	doi = {10.1177/14407833231183988},
	file = {Cannizzo_Spies-Butcher_2023_A basic income for a complex society14407833231183988.pdf},
	issn = {1440-7833},
	journaltitle = {Journal of Sociology},
	keywords = {/unread},
	langid = {english},
	pages = {14407833231183988},
	publisher = {SAGE Publications Ltd},
	shorttitle = {A Basic Income for a Complex Society},
	title = {A Basic Income for a Complex Society: {{Introduction}}},
	url = {https://doi.org/10.1177/14407833231183988},
	urldate = {2023-09-06},
	bdsk-url-1 = {https://doi.org/10.1177/14407833231183988}}

@article{cansunarGrowthInequalityRedistribution,
	author = {Cansunar, Asli and Kosmidis, Spyros},
	file = {Cansunar_Kosmidis_Growth, Inequality and Redistribution Preferences.pdf},
	keywords = {⛔ No DOI found,local conditions,reviewed},
	langid = {english},
	note = {\textbf{Extracted Annotations (11/16/2021, 8:47:51 PM)} \par "Meltzer and Richard (1981), for example, suggest that poorer voters are more likely to support redistribution and thus the levels of income inequality determine the size of the welfare state" (\href{zotero://open-pdf/library/items/ENM4TT2I?page=2}{Cansunar and Kosmidis :19}) \par "The primary demand for a strong welfare state, on this account, is not redistribution per se, but a demand for insurance that is independent to income and its distribution (Cusack, Iversen and Rehm, 2006; Iversen and Soskice, 2001; Rehm, Hacker and Schlesinger, 2012; Moene and Wallerstein, 2001; Swenson, 2002; Mares, 2003)" (\href{zotero://open-pdf/library/items/ENM4TT2I?page=2}{Cansunar and Kosmidis :19}) \par "We examine the direct effect of growth on demands for redistribution." (\href{zotero://open-pdf/library/items/ENM4TT2I?page=3}{Cansunar and Kosmidis :20}) \par "(2), that the effects of growth or decline are conditional on how unequal the locality of the individual is." (\href{zotero://open-pdf/library/items/ENM4TT2I?page=3}{Cansunar and Kosmidis :20}) \par "How does a change in the economy affect tax preferences across different levels of inequality?" (\href{zotero://open-pdf/library/items/ENM4TT2I?page=4}{Cansunar and Kosmidis :21}) \par "Thus, we argue that individuals feel frustrated not only when there is a decrease in their income but also when there is a substantial difference in the economic performance between them and other people in their locality. In this case we focus on post-taxes and transfers income levels" (\href{zotero://open-pdf/library/items/ENM4TT2I?page=5}{Cansunar and Kosmidis :22}) \par "From the same data source, we have collected the county level Gini coefficient (Income Inequality for 2016, and we have also collected county level GDP per capita for almost 3,145 counties in the United States. For our analyses the GDP per capita was also recorded in 2012 to be able to transform it to a growth rate (i.e., GDP pc2016GDP pc2012 ). Our micro level data come from the Comparative Congressional Election Study CCES (Ansolabehere and Schaffner, 2017). The CCES has a pool of almost 65,000 respondents. The questionnaire was administered before the 2016 election and has questions about demographics (age, gender, education, income), recordings of policy preferences and voting behavior. What is more, the CCES provides geographical information about each respondent, and thus our sample can be linked to the county level data" (\href{zotero://open-pdf/library/items/ENM4TT2I?page=7}{Cansunar and Kosmidis :24}) \par "The results for the rich individuals can be explained in -at leasttwo ways. The first one relates altruism on the part of the rich that also stems from the externalities of income inequality that often include fear of crime, negative attitudes towards homelessness and other related phenomena observed in unequal societies. The second explanation relates to risk and its possible confounding role in this relationship" (\href{zotero://open-pdf/library/items/ENM4TT2I?page=11}{Cansunar and Kosmidis :28}) \par "Like rich individuals in the previous figures, we find that individuals living in unequal counties, are more likely to support redistribution only if their locality grew economically from 2012 to 2016." (\href{zotero://open-pdf/library/items/ENM4TT2I?page=11}{Cansunar and Kosmidis :28}) \par "In this paper, we produced theoretical predictions regarding spending preferences by specifying utilities that are a function of both local growth and the dispersion of income distribution.In general, our aim was to investigate how growth and income inequality interact to change the utilities of individuals with respect to their optimal level of redistribution. Our empirical results show that individuals who experience unequal growth have higher demands for welfare spending4 . However, we report results that are, to a great extent, at odds with previous work on the topic and, particularly, those works that examine the impact of income and risk on preferences for welfare provision. Future research should revisit this strand of research and examine whether the combination of growth and income inequality alters the conclusions." (\href{zotero://open-pdf/library/items/ENM4TT2I?page=15}{Cansunar and Kosmidis :32})},
	pages = {18},
	title = {Growth, {{Inequality}} and {{Redistribution Preferences}}}}

