	number = {4},
	pages = {999--1042},
	publisher = {The University of Chicago Press},
	shorttitle = {The {{Citizenship Advantage}}},
	title = {The {{Citizenship Advantage}}: {{Immigrant Socioeconomic Attainment}} in the {{Age}} of {{Mass Migration}}},
