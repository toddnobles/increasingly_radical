	issn = {1319-1578},
	journaltitle = {Journal of King Saud University - Computer and Information Sciences},
	keywords = {/unread,Artificial intelligence,Financial technology,Financial trading},
	number = {3},
	pages = {102015},
	shortjournal = {Journal of King Saud University - Computer and Information Sciences},
	shorttitle = {Artificial Intelligence Techniques in Financial Trading},
	title = {Artificial Intelligence Techniques in Financial Trading: {{A}} Systematic Literature Review},
	url = {https://www.sciencedirect.com/science/article/pii/S1319157824001046},
	urldate = {2024-10-25},
