	shorttitle = {Does the {{American Dream Matter}} for {{Members}} of {{Congress}}?},
	title = {Does the {{American Dream Matter}} for {{Members}} of {{Congress}}?: {{Social-Class Backgrounds}} and {{Roll-Call Votes}}},
