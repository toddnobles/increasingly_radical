@article{macleodUrbanPoliticsReconsidered2011,
	abstract = {Over the past three decades, research in urban politics or increasingly urban governance reveals a landscape powerfully reflecting what might now be defined as a post-political consensus. Following a waning of the community power, urban managerialist and collective consumption debates, this `new urban politics' has appeared conspicuously absorbed with analysing a purported consensus around economic growth alongside a proliferation of entrepreneurially oriented governing regimes. More recent contributions, acknowledging the role of the state and governmentalities of criminal justice, uncover how downtown renaissance is inscribed through significant land privatisations and associated institutionalised expressions like Business Improvement Districts and other `primary definers' of `public benefit': all choreographed around an implicit consensus to `police' the circumspect city, while presenting as ultra-politics anything that might disturb the strict ethics of consumerist citizenship. Beyond downtown, a range of shadow governments, secessionary place-makings and privatisms are remaking the political landscape of post-suburbia. It is contended that the cumulative effect of such metropolitan splintering may well be overextending our established interpretations of urban landscapes and city politics, prompting non-trivial questions about the precise manner in which political representation, democracy and substantive citizenship are being negotiated across metropolitan regions, from downtown streetscape to suburban doorstep. This paper suggests that recent theorisations on post-democracy and the post-political may help to decode the contemporary landscape of urban politics beyond governance, perhaps in turn facilitating a better investigation of crucial questions over distributional justice and metropolitan integrity.},
	author = {MacLeod, Gordon},
	date = {2011-09},
	doi = {10.1177/0042098011415715},
	file = {MacLeod 2011 Urban politics reconsidered.pdf},
	issn = {0042-0980, 1360-063X},
	journaltitle = {Urban Studies},
	keywords = {ObsCite},
	langid = {english},
	note = {\section{Annotations\\ (4/3/2022, 10:23:17 PM)} \par ``These include an intensified regulation of downtown via privatised agencies epitomised by the Business Improvement District (Ward, 2007); a related securitisation and revanchist policing of downtowns (Smith, 1996; MacLeod, 2002; Coleman, 2009); a transformation of suburbia vis-a`-vis edge city `shadow governments' and an eruption of territorialising gated `communities' eager to secede from the formal urban political arena (McKenzie, 2005; Knox, 2008).'' (MacLeod, 2011, p. 2631) \par ``urban regime theory'' (MacLeod, 2011, p. 2634) \par (MacLeod, 2011, p. 2635) how is this change with the internet and media in add based with no specific geographic loyalty \par ``boomburbs have typically been unravelling along interstate freeways and are defined as having more than 100 000 residents, maintaining doubledigit rates of population growth for each census since 1970 but without being the core regional city'' (MacLeod, 2011, p. 2639) \par ``The US is estimated to have 286 000 HOAs (less than 500 existed in 1965) covering over 20 per cent of households or 57 million people. And with four out of five homes built since 2000 located within HOA sub-divisions (Knox, 2008), concerns are mounting that this common interest housing revolution represents the `forced obsolescence' of traditional neighbourhoods featuring individually owned homes on public streets with public services in favour of privately governed common interest communities with private streets, services and governments (McKenzie, 2006, p. 17'' (MacLeod, 2011, p. 2640) \par ```privatopia': it enables a `civic secession' or `secession from responsibility'---with considerable implications for political secession---where the well-off isolate themselves from those of lesser means while in turn eschewing any commitment to collective consumption and thereby reconfiguring their territorial dependencies'' (MacLeod, 2011, p. 2640) \par ``One lived-in neighbourhood, Bonanza Village, was literally refashioned into a walled community by city authorities---in the face of dissenting protests from residents---to make it resemble the newer fashionable gated enclaves and integrate it more in accordance with glitzy downtown redevelopment (McKenzie, 2005).'' (MacLeod, 2011, p. 2641) who's interested being advanced by this change and who has the power to decide that that is the proper course \par ``Indeed, the mayors of certain boomburbs are content for such a reconfiguration of scalar dependencies: for the HOAs performing labour-intensive neighbourhood-level service provision and management thereby free the city-wide government to concentrate on big infrastructure, economic development and long-range master planning (Lang and Nelson, 2007). This is a folding of the `growth first' consensus with the practice of `privatism', in turn enabling the assemblages of the post-democratic urban landscape.'' (MacLeod, 2011, p. 2651)},
	number = {12},
	pages = {2629--2660},
	shortjournal = {Urban Studies},
	shorttitle = {Urban {{Politics Reconsidered}}},
	title = {Urban {{Politics Reconsidered}}: {{Growth Machine}} to {{Post-democratic City}}?},
	url = {http://journals.sagepub.com/doi/10.1177/0042098011415715},
	urldate = {2022-03-30},
	volume = {48},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1177/0042098011415715},
	bdsk-url-2 = {https://doi.org/10.1177/0042098011415715}}

@article{maeshimaMentalHealthStigma2022,
	abstract = {Objective: To examine the relationship between stigma and mental health help-seeking among Asian American and Asian international college students. Participants: Asian American college students (401 men, 858 women) and Asian international college students (384 men, 428 women). Methods: Data from the 2018--2019 Healthy Minds Study were used to assess perceived stigma, personal stigma, and help-seeking behaviors of college students. Results: Personal stigma mediated the relationship between perceived stigma and professional help-seeking intentions. The relationship between perceived stigma and personal stigma differed by international status, such that the relationship between perceived stigma and personal stigma was stronger for Asian international students. The indirect effect between perceived stigma and professional help-seeking via personal stigma also differed by international status. Conclusions: These results suggest that, consistent with prior work, stigma impacts help-seeking among Asian college students and international student status affects the strength of the key relationship between perceived stigma and personal stigma.},
	author = {Maeshima, Lindsey S. and Parent, Mike C.},
	date = {2022-08-24},
	doi = {10.1080/07448481.2020.1819820},
	eprint = {33048652},
