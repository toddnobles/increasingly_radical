	journaltitle = {Social Forces},
	keywords = {reviewed,use,voter turnout},
	note = {\textbf{Extracted Annotations (3/14/2022, 4:43:24 PM)} \par "The results suggest that increasing shares of immigrants does not affect natives' propensity to vote to any substantive extent, irrespective of how the size of the neighborhood is specified." (\href{zotero://open-pdf/library/items/UJH4TYFE?page=1}{Bhatti et al 2017:1127})},
	number = {3},
	pages = {1127--1154},
	shortjournal = {Social Forces},
	shorttitle = {The {{Context}} of {{Voting}}},
	title = {The {{Context}} of {{Voting}}: {{Does Neighborhood Ethnic Diversity Affect Turnout}}?},
