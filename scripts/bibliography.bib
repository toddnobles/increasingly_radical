@article{hoodGiveUsYour1998,
	abstract = {Although few controversies in our political environment are as contentious as the current debate over immigration policy, the research on public opinion toward immigration is quite limited. In particular, we know relatively little about the contextual determinants of opinions on immigration issues. We address this issue by investigating the impact of migrant context on Anglo opinions toward immigration. We find that Anglo support for increased immigration is directly related to the size of the documented migrant population. Conversely, as the relative size of the undocumented migrant population increases, Anglo support for increased immigration decreases. We conclude with a discussion of the relevance of our findings for the study of immigration opinion, in particular, and the study of intergroup relations more generally.},
	annotation = {108 citations (Crossref) [2024-05-04]},
	author = {Hood, M. V. and Morris, Irwin L.},
	date = {1998-03-01},
	doi = {10.1023/A:1024839032001},
	file = {Hood_Morris_1998_Give Us Your Tired, Your Poor, 1-15.pdf},
	issn = {1573-6687},
	journaltitle = {Political Behavior},
	keywords = {group threat,legal status,reviewed,use},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/14/2022, 5:02:10 PM)} \par "Rothbart and John describe the rationale behind the contact hypothesis as follows: The contact hypothesis itself has a number of variants, but the basic idea is that antagonistic groups generate unrealistically negative expectations of one another and simultaneously avoid contact. To the extent that contact occurs, the unrealistically negative perceptions of the group members are modified by experience. In other words, hostility is reduced as a result of increasingly favorable attitudes toward individual group members, which then generalize to the group as a whole. (1993, p. 42)" (\href{zotero://open-pdf/library/items/4Q57HURX?page=3}{Hood and Morris 1998:3}) \par "Other research suggests that intergroup contact intensifies conflict. This is the expectation of realistic group conflict theory (RGCT) (Blumer, 1958; Campbell, 1965; Sherif and Sherif, 1953; Van den Berghe, 1967). Put simply, RGCT posits that competition for scarce resources---economic, social, or cultural---leads to conflict among groups (Sherif et al., 1961; Campbell, 1965; Levine and Campbell, 1972). Proximity among competing groups will accentuate such conflict (Kinder and Mendelberg, 1995)." (\href{zotero://open-pdf/library/items/4Q57HURX?page=3}{Hood and Morris 1998:3}) \par "The following question from the 1992 NES serves as our dependent variable:' Do you think the number of immigrants from foreign countries who are permitted to come to the United States to live should be increased a little, increased a lot, decreased a little, decreased a lot, or left the same as it is now? The question was left as a live-point scale---with "increased a lot" coded 1 and "decreased a lot" coded 5---as it had originally appeared in the study." (\href{zotero://open-pdf/library/items/4Q57HURX?page=6}{Hood and Morris 1998:6}) \par "As the relative size of the documented migrant population in a particular area increases, Anglo aversion to increased lega! immigration decreases.7 But as the relative size of the undocumented migrant population increases, Anglo discontent with increased immigration also increases." (\href{zotero://open-pdf/library/items/4Q57HURX?page=7}{Hood and Morris 1998:7}) \par "Finally, we also find that education and ideology influence opinion formation on immigration. The greater the level of education, the more amenable the respondent to an increase in legal immigration. Likewise, the more liberal the respondent, the greater the respondents support for increased immigration. Those with limited educational attainment or those with a staunchly conservative viewpoint were more likely to be suspicious of further increases in legal immigration. We found no evidence that age, gender, economic circumstances (either personal or communal), or migrant status had any effect on opinions toward immigration policy among Anglos" (\href{zotero://open-pdf/library/items/4Q57HURX?page=10}{Hood and Morris 1998:10}) \par \subsubsubsection{Major question:} \par how does size of documented/undocumented immigrant population impact attitudes towards immigration \par \subsubsubsection{Data and Method: 1992 ANES} \subsubsubsection{Variables and definitions:} \subsubsubsection{Findings:} \subsubsubsection{Conclusions:} \par undocumented immigrants can't integrate because of fear of deportation so they don't have the "long-term, high quality interaction" that "development of positive intergroup attitudes" requires \par impact of authority support as signal \par \subsubsubsection{Comments}},
	number = {1},
	pages = {1--15},
	shortjournal = {Political Behavior},
	shorttitle = {Give {{Us Your Tired}}, {{Your Poor}}, ... {{But Make Sure They Have}} a {{Green Card}}},
	title = {Give {{Us Your Tired}}, {{Your Poor}}, ... {{But Make Sure They Have}} a {{Green Card}}: {{The Effects}} of {{Documented}} and {{Undocumented Migrant Context}} on {{Anglo Opinion Toward Immigration}}},
	url = {https://doi.org/10.1023/A:1024839032001},
	urldate = {2022-03-10},
	volume = {20},
	bdsk-url-1 = {https://doi.org/10.1023/A:1024839032001}}

@article{hoodiiiAmigoEnemigoContext1997,
	abstract = {This article examines the effects of racial and ethnic context and various attitudinal and demographic variables on Anglo public opinion toward immigration. Methods. We use ordered probit to analyze nationwide survey and census data relating to immigration. Results. Anglos living in close proximity to large Asian populations are more likely than racially and ethnically isolated Anglos to favor increased immigration. Likewise, Anglos who have more positive impressions of Asians and Hispanics and their potential impact on society favor more liberal immigration policies than do other Anglos. We also find that Californians favor more restrictive immigration policies than do other Americans. Conclusions. Our findings demonstrate that Anglo public opinion on immigration has prominent racial and ethnic components. Although the policy implications of these findings are rather unclear, it is obvious that we can no longer ignore the impact of racial and ethnic context on public opinion toward immigration. [ABSTRACT FROM AUTHOR]},
