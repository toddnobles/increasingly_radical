	file = {Borzaga_Tortia_2017_Co-operation as Co-ordination Mechanism0.pdf;../../../Zotero/storage/7X6YUNDX/295147874.html},
	isbn = {978-0-19-968497-7},
	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	shorttitle = {Co-Operation as {{Co-ordination Mechanism}}},
	title = {Co-Operation as {{Co-ordination Mechanism}}: A New Approach to the Economics of Co-Operative Enterprises},
