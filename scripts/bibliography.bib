	issn = {1841-0413},
	journaltitle = {Europe's Journal of Psychology},
	keywords = {guilt actually used},
	note = {\section{Annotations\\ (6/6/2022, 11:29:33 AM)} \par ``Shame is an unpleasant emotion implying a self-evaluation of inadequacy to meet the standards of one's ideal self. The self-attributed inadequacy may or may not imply a global negative self-view'' (Miceli and Castelfranchi, 2018, p. 724) \par ``Guilt is an unpleasant emotion implying a negative self-evaluation against one's moral standards, that is, the standards concerning those behaviors, goals, beliefs or traits for which one regards oneself as responsible. The evaluation is negative in that such behaviors, goals, etc. are viewed as harmful'' (Miceli and Castelfranchi, 2018, p. 725)},
	number = {3},
	pages = {710--733},
	pmcid = {PMC6143989},
	shortjournal = {Eur J Psychol},
	title = {Reconsidering the {{Differences Between Shame}} and {{Guilt}}},
