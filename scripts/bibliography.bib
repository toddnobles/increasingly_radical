	keywords = {Biocultural anthropology,Debt,Health inequality,http://www.ssrn.com/abstract=2043657,Neoliberalism},
	langid = {english},
	pages = {86--93},
	shortjournal = {Social Science \& Medicine},
	shorttitle = {``{{Like}} You Failed at Life''},
	title = {``{{Like}} You Failed at Life'': {{Debt}}, Health and Neoliberal Subjectivity},
	url = {https://www.sciencedirect.com/science/article/pii/S0277953618303745},
