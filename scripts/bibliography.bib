	bdsk-url-1 = {https://doi.org/10.1080/10350330.2013.777594}}

@article{mayorgaColorblindnessFreeMarket2025,
	abstract = {This study explores the interplay between colorblindness and free-market beliefs and their role in justifying inequality. Despite extensive research on racial attitudes, the material impacts of colorblindness remain underexplored. By employing the concept of racecraft, the study posits that these ideologies mutually reinforce the denial of structural racism and sustain economic disparities. Analyzing data from the American National Election Study (ANES), it reveals a strong correlation between colorblind beliefs and free-market ideologies, which coincides with the rejection of equal opportunity policies. The findings suggest that these beliefs work together to obscure the effects of racism, framing inequality as a product of individual failure. This research underscores the need to consider both the material and ideological facets of racism to effectively address social inequality, highlighting the significant influence of colorblindness and free-market philosophies on policy formation.},
	author = {Mayorga, Oscar J.},
	date = {2025-03-25},
	doi = {10.1177/08969205251325947},
	file = {../../../Zotero/storage/TTBYYGYV/Mayorga - 2025 - Colorblindness and Free Market Ideologies as Racecraft.pdf},
	issn = {0896-9205},
	journaltitle = {Critical Sociology},
	langid = {english},
	pages = {08969205251325947},
	publisher = {SAGE Publications Ltd},
	title = {Colorblindness and {{Free Market Ideologies}} as {{Racecraft}}},
	url = {https://doi.org/10.1177/08969205251325947},
	urldate = {2025-03-31},
	bdsk-url-1 = {https://doi.org/10.1177/08969205251325947}}

