	issn = {0197-3533},
	journaltitle = {Basic and Applied Social Psychology},
	number = {2},
	pages = {111--124},
	publisher = {Routledge},
	shorttitle = {Empathy, {{Awareness}} of {{Others}}, and {{Action}}},
	title = {Empathy, {{Awareness}} of {{Others}}, and {{Action}}: {{How Feeling Empathy}} for {{One-Among-Others Motivates Helping}} the {{Others}}},
	url = {https://doi.org/10.1080/01973533.2013.856787},
