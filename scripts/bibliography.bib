	shortjournal = {Annu. Rev. Sociol.},
	shorttitle = {{{US Labor Studies}} in the {{Twenty-First Century}}},
	title = {{{US Labor Studies}} in the {{Twenty-First Century}}: {{Understanding Laborism Without Labor}}},
