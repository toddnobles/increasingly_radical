@article{mcclainBLACKAMERICANSLATINO2007,
	abstract = {Abstract             Dramatic demographic changes are occurring in the United States, and some of the most dramatic changes are occurring in the South from Latino immigration. Latinos, by and large, are an entirely new population in the region. How are Black southerners reacting to this new population? Using survey data gathered from a southern location, this article explores several questions related to whether Blacks see these new residents as friendly neighbors or economic competitors. Results suggest that Blacks and non-Blacks perceive a potential economic threat from continued Latino immigration, but Blacks are more concerned about the effects of Latino immigration than are Whites.},
	annotation = {26 citations (Crossref) [2022-03-14]},
	author = {McClain, Paula D. and Lyle, Monique L. and Carter, Niambi M. and Soto, Victoria M. DeFrancesco and Lackey, Gerald F. and Cotton, Kendra Davenport and Nunnally, Shayla C. and Scotto, Thomas J. and Grynaviski, Jeffrey D. and Kendrick, J. Alan},
	date = {2007},
	doi = {10.1017/S1742058X07070063},
	file = {McClain et al_2007_BLACK AMERICANS AND LATINO IMMIGRANTS IN A SOUTHERN CITY97-117.pdf},
	issn = {1742-058X, 1742-0598},
	journaltitle = {Du Bois Review: Social Science Research on Race},
	keywords = {black-latino,reviewed,use},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/14/2022, 5:01:43 PM)} \par "Despite the lack of consensus in the economics literature on whether immigrants, in general, and Latino immigrants, in particular, are taking jobs from Blacks, the fact remains that Blacks may perceive the loss of jobs and deleterious economic effects from Latino immigrants. Based on racial threat and competition theory, along with the limited evidence that Latinos are taking jobs from southern Blacks, we pose the following hypotheses: H1: Southern Black Americans will perceive Latino immigrants as threats to their own economic well-being, such that H2: Southern Black Americans will be more opposed to immigration than their White counterparts." (\href{zotero://open-pdf/library/items/K3HIK8UI?page=5}{McClain et al 2007:101}) \par "Our analyses in this article are based on the 2003 Durham Survey of Intergroup Relations\textasciitilde DSIR!\textasciitilde n 500!" (\href{zotero://open-pdf/library/items/K3HIK8UI?page=9}{McClain et al 2007:105}) \par "Our data also confirm what we had suspected---the Latino population in Durham is basically an immigrant population, primarily from Mexico. Of the 93\% \textasciitilde n 156! of Latino respondents who were born outside the United States, only about 19\% were naturalized citizens. While Mexicans were the largest portion of the Latino sample \textasciitilde 63\%!, Latinos from Central America were the next largest group \textasciitilde 23\%!, followed by South Americans \textasciitilde 5\%!, Puerto Ricans \textasciitilde 4\%!, Spanish \textasciitilde 2\%!, Cubans \textasciitilde 1\%!, and other Latinos \textasciitilde 2\%!." (\href{zotero://open-pdf/library/items/K3HIK8UI?page=11}{McClain et al 2007:107}) \par "According to the results of our analysis \textasciitilde results not shown!, Blacks were more likely than were non-Blacks to feel that continued immigration would lead to decreased economic opportunities for members of their racial group" (\href{zotero://open-pdf/library/items/K3HIK8UI?page=11}{McClain et al 2007:107}) \par "The interaction between race and stereotypic views, however, did achieve statistical significance, which implies that having high levels of negative stereotypic views of Latinos appears to matter in Blacks' attitudes toward the rapid growth in the Latino population, but it does not appear to matter for Whites." (\href{zotero://open-pdf/library/items/K3HIK8UI?page=13}{McClain et al 2007:109}) \par "Contrary to our expectation, having highly negative stereotypic views predicted greater concern about Latino population growth among the White respondents as well, and the effect was even more pronounced than it was among Blacks." (\href{zotero://open-pdf/library/items/K3HIK8UI?page=15}{McClain et al 2007:111}) \par "Whites, those with less education, and women were also more likely to be concerned about Latino population growth." (\href{zotero://open-pdf/library/items/K3HIK8UI?page=15}{McClain et al 2007:111}) \par "This indicator is measured using an index of two separate variables:\textasciitilde 1! perception of the number of Latinos in their neighborhood, and\textasciitilde 2! social contact with Latinos. Question wording: In your neighborhood, how many of the residents are Latinos?\textasciitilde 1! none of the residents; \textasciitilde 2! a few of the residents; \textasciitilde 3! some of the residents; \textasciitilde 4! most of the residents; \textasciitilde 5! all of the residents. Question wording: In your social life, including your friends and people you know from church and other social activities, do you have\textasciitilde 4! a lot of contact,\textasciitilde 3! some contact,\textasciitilde 2! little contact, or \textasciitilde 1! no contact at all, with Blacks (Latinos)?" (\href{zotero://open-pdf/library/items/K3HIK8UI?page=18}{McClain et al 2007:114})},
	number = {1},
	pages = {97--117},
	shortjournal = {Du Bois Rev.},
	shorttitle = {{{BLACK AMERICANS AND LATINO IMMIGRANTS IN A SOUTHERN CITY}}},
	title = {{{BLACK AMERICANS AND LATINO IMMIGRANTS IN A SOUTHERN CITY}}: {{Friendly Neighbors}} or {{Economic Competitors}}?},
	url = {https://www.cambridge.org/core/product/identifier/S1742058X07070063/type/journal_article},
	urldate = {2022-03-09},
	volume = {4},
	bdsk-url-1 = {https://www.cambridge.org/core/product/identifier/S1742058X07070063/type/journal_article},
	bdsk-url-2 = {https://doi.org/10.1017/S1742058X07070063}}

@article{mcclainRacialDistancingSouthern2006,
	abstract = {The United States is undergoing dramatic demographic change, primarily from immigration, and many of the new Latino immigrants are settling in the South. This paper examines hypotheses related to attitudes of Latino immigrants toward black Americans in a Southern city. The analyses are based on a survey of black, white, and Latino residents (n = 500). The results show, for the most part, Latino immigrants hold negative stereotypical views of blacks and feel that they have more in common with whites than with blacks. Yet, whites do not reciprocate in their feelings toward Latinos. Latinos' negative attitudes toward blacks, however, are modulated by a sense of linked fate with other Latinos. This research is important because the South still contains the largest population of African Americans in the United States, and no section of the country has been more rigidly defined along a black-white racial divide. How these new Latino immigrants situate themselves vis-{\`a}-vis black Americans has profound implications for the social and political fabric of the South.},
	author = {McClain, Paula D. and Carter, Niambi M. and DeFrancesco Soto, Victoria M. and Lyle, Monique L. and Grynaviski, Jeffrey D. and Nunnally, Shayla C. and Scotto, Thomas J. and Kendrick, J. Alan and Lackey, Gerald F. and Cotton, Kendra Davenport},
