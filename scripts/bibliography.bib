	isbn = {978-0-19-968497-7},
	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	title = {Workers---and {{Consumers}}---of the {{World Unite}}! {{Opportunities}} for {{Hybrid Co-operativism}}},
	url = {https://doi.org/10.1093/oxfordhb/9780199684977.013.26},
	urldate = {2024-11-26},
