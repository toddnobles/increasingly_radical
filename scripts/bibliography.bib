	urldate = {2023-05-22},
	volume = {112},
	bdsk-url-1 = {https://www.journals.uchicago.edu/doi/10.1086/507856},
	bdsk-url-2 = {https://doi.org/10.1086/507856}}

@article{brunnschweilerCursingBlessingsNatural2008,
	abstract = {Since Sachs and Warner's [Sachs, J. D., \& Warner, A. M. (1995a). Natural resource abundance and economic growth. NBER working paper, no. 5398] contribution, there has been a lively debate on the so-called natural resource curse. This paper re-examines the effects of natural resource abundance on economic growth using new measures of resource endowment and considering the role of institutional quality. We find a positive direct empirical relationship between natural resource abundance and economic growth. In both OLS and 2SLS regressions, the positive resource effects are particularly strong for subsoil wealth. Our results also show no evidence of negative indirect effects of natural resources through the institutional channel.},
	author = {Brunnschweiler, Christa N.},
	date = {2008-03},
	doi = {10.1016/j.worlddev.2007.03.004},
	file = {Brunnschweiler_2008_Cursing the Blessings.pdf;Brunnschweiler_2008_Cursing the Blessings2.pdf},
	issn = {0305750X},
	journaltitle = {World Development},
	keywords = {economic growth,institutional quality,natural resources,resource curse},
	langid = {english},
	note = {\begin{itemize} \item adjust traditional research curse aproach by using per capita minieral and total natural resource wealth rather than primary exports in GDP \end{itemize} \par \textbf{Extracted Annotations (10/23/2021, 10:24:37 PM)} \par "World Bank (1997, 2005) and measuring per carespectively---which in our view better capture a country's natural resource abundance" (\href{zotero://open-pdf/library/items/C2XVFEYN?page=2}{Brunnschweiler 2008:400})},
	number = {3},
	pages = {399--419},
	shortjournal = {World Development},
	shorttitle = {Cursing the {{Blessings}}?},
	title = {Cursing the {{Blessings}}? {{Natural Resource Abundance}}, {{Institutions}}, and {{Economic Growth}}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0305750X07002100},
	urldate = {2021-10-21},
	volume = {36},
