@article{flanaganPrivateNeedsPublic2014,
	abstract = {As part of the reconstruction of their built environments at the beginning of the twentieth century, London, Dublin, Toronto and Chicago confronted the question of whether to provide public toilets. In comparing the arguments and decisions over this question, this article demonstrates how the male leadership of each city sought to preserve the centuries-old patriarchal tradition of separate public and private spheres and limit women's access to public spaces. It also reveals the gendered dimension of ideas and experiences of the city that underlay the rhetoric surrounding this question.},
	author = {family=FLANAGAN, given=MAUREEN, given-i=MAUREEN},
	date = {2014},
