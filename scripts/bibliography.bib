@article{diaz-boneSocialResearchTimes2020,
	abstract = {The phenomenon of big data does not only deeply affect current societies but also poses crucial challenges to social research. This article argues for moving towards a sociology of social research in order to characterize the new qualities of big data and its deficiencies. We draw on the neopragmatist approach of economics of convention (EC) as a conceptual basis for such a sociological perspective. This framework suggests investigating processes of quantification in their interplay with orders of justifications and logics of evaluation. Methodological issues such as the question of the ``quality of big data'' must accordingly be discussed in their deep entanglement with epistemic values, institutional forms, and historical contexts and as necessarily implying political issues such as who controls and has access to data infrastructures. On this conceptual basis, the article uses the example of health to discuss the challenges of big data analysis for social research. Phenomena such as the rise of new and massive privately owned data infrastructures, the economic valuation of huge amounts of connected data, or the movement of ``quantified self'' are presented as indications of a profound transformation compared to established forms of doing social research. Methodological and epistemological, but also institutional and political, strategies are presented to face the risk of being ``outperformed'' and ``replaced'' by big data analysis as they are already done in big US American and Chinese Internet enterprises. In conclusion, we argue that the sketched developments have important implications both for research practices and methods teaching in the era of big data.},
	author = {Diaz-Bone, Rainer and Horvath, Kenneth and Cappel, Valeska},
	date = {2020},
	eprint = {26918415},
	eprinttype = {jstor},
	file = {Diaz-Bone et al_2020_Social Research in Times of Big Data314-341.pdf},
	issn = {0172-6404},
	journaltitle = {Historical Social Research / Historische Sozialforschung},
	keywords = {/unread},
	number = {3},
	pages = {314--341},
	publisher = {GESIS - Leibniz Institute for the Social Sciences},
	title = {Social {{Research}} in {{Times}} of {{Big Data}}. {{The Challenges}} of {{New Data Worlds}} and the {{Need}} for a {{Sociology}} of {{Social Research}}},
	url = {https://www.jstor.org/stable/26918415},
	urldate = {2023-03-02},
	volume = {45},
	bdsk-url-1 = {https://www.jstor.org/stable/26918415}}

@article{diazEconomicDynamicsChanges2011,
	abstract = {Mexican immigration to the United States comprises an important social issue in contemporary public policy debate, particularly given the recent passage of Arizona's Senate Bill 1070 (SB 1070). The current study investigated how individuals' sentiments toward undocumented Mexican immigrants shifted between 2006 and 2009 in Arizona, and also examined economic concomitants to these shifts. Participants included 3,195 culturally diverse students attending a state university in Arizona. They reported their attitudes toward undocumented Mexican immigrants regarding housing, employment, values, social welfare, citizenship, health care, and education issues. Results show less-positive attitudes as each year progressed among European and Latino Americans, as well as other ethnic minorities. Further, anti-undocumented immigrant sentiment increased as unemployment increased and gross domestic product real growth rate decreased. Ethnic differences emerged in the relative negativity toward undocumented immigrants such that European Americans were less positive towards undocumented Mexican immigrants than Latinos over 4 years. These findings suggest that economic dynamics may beget anti-immigrant sentiment, leading to contentious legislation, such as Arizona's recent immigration law.},
	annotation = {33 citations (Crossref) [2024-05-04]},
	author = {Diaz, Priscila and Saenz, Delia S. and Kwan, Virginia S.Y.},
	date = {2011},
	doi = {10.1111/j.1530-2415.2011.01255.x},
	file = {Diaz et al_2011_Economic Dynamics and Changes in Attitudes Toward Undocumented Mexican300-313.pdf;../../../Zotero/storage/QI72CP8P/j.1530-2415.2011.01255.html},
	issn = {1530-2415},
	journaltitle = {Analyses of Social Issues and Public Policy},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/15/2022, 4:40:40 PM)} \par "o address the relationships between economic conditions and attitudes toward undocumented Mexican immigrants, we examined bivariate correlations among relevant variables (GDP, national and state unemployment, attitudes toward undocumented Mexican immigrants). As predicted, as GDP real growth rate decreased, participants had less positive attitudes towards undocumented Mexican immigrants (r = -.41, p {$<$} .001). Also as predicted, negative bias was positively correlated with national unemployment rates (r = .48, p {$<$} .001) and statewide unemployment rates (r = .44, p {$<$} .001), indicating that as unemployment increased, participants had less-positive attitudes towards undocumented Mexican immigrants. These correlations were consistent across ethnic groups, whether considered independently or in combination." (\href{zotero://open-pdf/library/items/HRUFRM6D?page=9}{Diaz et al 2011:308}) \par "his indicates attitudes specifically regarding the resources taken and given by undocumented Mexican immigrants strongly relate to the fluctuations in the economy. These findings suggest that current economic conditions may be one of possibly multiple factors that lead to the less-positive sentiments against undocumented immigrants." (\href{zotero://open-pdf/library/items/HRUFRM6D?page=10}{Diaz et al 2011:309})},
	number = {1},
	pages = {300--313},
	title = {Economic {{Dynamics}} and {{Changes}} in {{Attitudes Toward Undocumented Mexican Immigrants}} in {{Arizona}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1530-2415.2011.01255.x},
	urldate = {2022-03-10},
	volume = {11},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1530-2415.2011.01255.x},
	bdsk-url-2 = {https://doi.org/10.1111/j.1530-2415.2011.01255.x}}

@article{diazmcconnellItCouldBe2022,
	abstract = {Recent changes in the sociopolitical US landscape calls for the examination of the level of quantitative misperception about undocumented immigration and its connection with immigration attitudes. Nationally representative survey data are used to analyze whether being misinformed about the proportion of US immigrants that are undocumented in 2015 is linked with abstract immigration attitudes and four immigration policy options in 2016. The results reveal that people who overestimated undocumented immigration---a common misperception---are more likely to report that all immigrants present symbolic threats to the country than are their accurately informed peers. Consistent with the especially high salience of the US--Mexico wall in this period, overestimators also place more importance on building the wall but not on other policy options. These findings have important theoretical and real-world implications, given the current social and political context and spillover effects on Latinx and other racialized communities.},
	annotation = {3 citations (Crossref) [2024-05-04]\\ 0 citations (Semantic Scholar/DOI) [2022-03-14]},
	author = {D{\'\i}az McConnell, Eileen},
	date = {2022-02-23},
	doi = {10.1057/s41276-022-00351-w},
	file = {Diaz McConnell_2022_``It could be 3 million, it could be 30 million''.pdf},
	issn = {1476-3443},
	journaltitle = {Latino Studies},
	keywords = {_MA_reviewed},
	langid = {english},
	note = {\section{Annotations\\ (2/23/2024, 10:26:29 AM)} \par ``Why does it matter if the US public is misinformed about immigration and immigrants, such as what proportion of immigrants are undocumented? Research going back more than fifty years finds that a majority group's perceptions (and misperceptions) of the size of minority groups often generates a threat response among the majority, fostering hostility and a push to exclude the minority group (e.g., Alba et~al. 2005; Blalock 1967; Blumer 1958; Bobo 1983; Quillian 1995). Scholars report that being misinformed about immigration similarly generates negative reactions, with work focused predominantly on overestimators. Indeed, studies in the United States and Europe show that people who overestimate the proportion of all immigrants also hold more negative views about immigrants and their social impacts (e.g., Herda 2013; Hjerm 2007; Sides and Citrin 2007; Strabac 2011). These quantitative misperceptions are influential. In fact, it is the perceived, not actual, immigrant group size that has the ``largest and most consistent effect on [anti-immigrant] prejudice,'' according to a meta-analysis of the immigration attitudes literature (Pottie-Sherman and Wilkes 2017, p. 244).'' (D{\'\i}az McConnell, 2022, p. 3) Review these sources \par ``Is being misinformed about the proportion of US immigrants that are undocumented also associated with contemporary immigration attitudes? The handful of studies that have been carried out on the topic, either a one-time survey (Herda 2018) or experiments over a short time horizon, offer inconsistent, mixed results about whether being wrong (or being provided with the correct information) about unauthorized immigrant demographics affects US immigration attitudes and policy preferences (e.g., Alesina et~ al. 2018; Grigorieff et~ al. 2018; Hopkins et~ al. 2019; Transatlantic Trends 2014).'' (D{\'\i}az McConnell, 2022, p. 3) \par ``Building a border wall between Mexico and the United States was one of Donald Trump's key political platforms (Rivers and Ross 2020) and the ``linchpin'' of his anti-immigrant rhetoric and immigration agenda as president (e.g., Santa Ana 2017; Schuchs Carr et~al. 2020).'' (D{\'\i}az McConnell, 2022, p. 4) \par ``Ceobanu and Escandell 2010; Hainmueller and Hiscox 2007).'' (D{\'\i}az McConnell, 2022, p. 6) \par ``Studies also demonstrate that holding anti-immigrant views is meaningful, as it relates to current political divides, the increasing sway of Whites toward the Republican Party (Abrajano and Hajnal 2015; Jardina 2019; Wong 2018), the election of President Trump in 2016, and strong support for his agenda throughout his administration (e.g.,Mutz 2018; Salda{\~n}a et~al. 2018).'' (D{\'\i}az McConnell, 2022, p. 6) \par ``Group threat theory, the primary theoretical framework used to explain this relationship, contends that the majority group's interests in conserving their power and resources underlies hostile responses regarding the growth of minority groups (e.g., Alba et~al. 2005; Herda 2013; Hopkins et~al. 2019; Quillian 1995; Sides and Citrin 2007). However, recent work suggests that these processes may be more complicated for specific US groups (e.g., Carter 2019; Jardina 2019). For example, Whites vary in the strength of their racial consciousness and racial solidarity, which in turn is associated with variations in White support for exclusionary immigration policies (Jardina 2019).'' (D{\'\i}az McConnell, 2022, p. 7) \par ``In total, Trump mentioned the US--Mexico wall about one thousand times in recorded speeches and on Twitter in 2015--2016, dwarfing the total mentions for the other immigration policy options examined in this study.14 This focused attention confirms that the wall was an especially salient and politicized topic, relative to the other options, before he took office in 2017. In this specific sociopolitical context, having outsized misperceptions of the relative size of undocumented immigration is likely to be associated with more salient immigration policy options than with less salient ones.'' (D{\'\i}az McConnell, 2022, p. 11) \par (D{\'\i}az McConnell, 2022, p. 29) Cite this for data on what we know about Trump effect on border wall policy views},
	shortjournal = {Lat Stud},
	shorttitle = {``{{It}} Could Be 3 Million, It Could Be 30 Million''},
	title = {``{{It}} Could Be 3 Million, It Could Be 30 Million'': {{Quantitative}} Misperceptions about Undocumented Immigration and Immigration Attitudes in the {{Trump}} Era},
	url = {https://doi.org/10.1057/s41276-022-00351-w},
	urldate = {2022-03-14},
	bdsk-url-1 = {https://doi.org/10.1057/s41276-022-00351-w}}

