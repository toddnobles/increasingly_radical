	pages = {449--463},
	shorttitle = {Economic {{Voting}} and {{Multilevel Governance}}},
	title = {Economic {{Voting}} and {{Multilevel Governance}}: {{A Comparative Individual-Level Analysis}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1540-5907.2006.00194.x},
