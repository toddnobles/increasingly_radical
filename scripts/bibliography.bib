	issn = {1468-4446},
	journaltitle = {The British Journal of Sociology},
	keywords = {Populist vote,social status,working class},
	langid = {english},
	number = {S1},
	pages = {S57-S84},
	shorttitle = {The Politics of Social Status},
	title = {The Politics of Social Status: Economic and Cultural Roots of the Populist Right},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/1468-4446.12319},
	urldate = {2024-05-03},
	volume = {68},
