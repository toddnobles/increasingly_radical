	urldate = {2024-11-26},
	bdsk-url-1 = {https://doi.org/10.1093/oxfordhb/9780199684977.013.4}}

@article{herdaHOWMANYIMMIGRANTS2010,
	abstract = {Individuals frequently perceive immigrant and minority population sizes to be much larger than they are in reality. To date, little is understood about the extent or causes of this phenomenon, known as innumeracy, which may have consequences for inter-group relations. However, before the literature can assess these consequences, a better understanding of the development of these misperceptions is needed. The extant literature focuses only on the United States and lacks a clear understanding of how innumeracy arises. Drawing from the 2002 European Social Survey (ESS), this study attempts to make sense of this phenomenon by proposing and testing a framework that views innumeracy among majority group members as developing in two ways: as cognitive mistakes and emotional responses. I establish the existence and extent of the phenomenon across 21 European nations, test new key predictors such as media exposure and socio-economic status, and find independent associations with cognitive and emotional factors using multi-level regression analyses.},
	annotation = {93 citations (Crossref) [2024-05-04]},
	author = {family=HERDA, given=DANIEL, given-i=DANIEL},
	date = {2010},
	doi = {10.1093/poq/nfq013},
	eprint = {40927164},
	eprinttype = {jstor},
	file = {HERDA_2010_HOW MANY IMMIGRANTS674-695.pdf},
	issn = {0033-362X},
	journaltitle = {The Public Opinion Quarterly},
	number = {4},
	pages = {674--695},
	shorttitle = {{{HOW MANY IMMIGRANTS}}?},
	title = {{{HOW MANY IMMIGRANTS}}? {{FOREIGN-BORN POPULATION INNUMERACY IN EUROPE}}},
	url = {http://www.jstor.org/stable/40927164},
	urldate = {2022-03-10},
	volume = {74},
	bdsk-url-1 = {http://www.jstor.org/stable/40927164},
	bdsk-url-2 = {https://doi.org/10.1093/poq/nfq013}}

@article{herdaTooManyImmigrants2013,
	abstract = {The tendency to overestimate immigrant population sizes has garnered considerable scholarly attention for its potential link to antiimmigrant policy support. However, this existing innumeracy research has neglected other forms of ignorance, namely underestimation and nonresponse. Using the 2002 European Social Survey, the current study examines the full scope of innumeracy for the first time. Results indicate that underestimation and nonresponse occur commonly across twenty-one countries and that overestimation is far from ubiquitous. Nonresponders in particular are found to represent a distinct innumeracy form associated with low cognitive availability and high negative affect. Multilevel models indicate that underestimation associates with greater opposition to anti-immigrant policy, while overestimation and nonresponse associate with greater support. Much of these associations are explained by affective factors. However, significant under- and overestimation coefficients remain net of controls, suggesting that innumeracy may be more important than initially thought. Overall, the results highlight the multifaceted character of innumeracy.},
	annotation = {31 citations (Crossref) [2024-05-04]},
	author = {Herda, Daniel},
	date = {2013-06},
	doi = {10.1525/sop.2013.56.2.213},
	file = {Herda_2013_Too Many Immigrants213-240.pdf},
	issn = {0731-1214, 1533-8673},
	journaltitle = {Sociological Perspectives},
	keywords = {group threat,perceptions,reviewed,use},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/14/2022, 4:54:23 PM)} \par "Interestingly, nonresponse seems to constitute a unique innumeracy category. For one, these individuals exhibit the lowest levels of all types of immigrant contact. Aside from television, nonresponders also experience significantly less media exposure. Thus, they have fewer sources of cognitive availability with which to formulate estimates. This may explain their reticence to provide an answer. Despite minimal contact, these individuals perceive the most threat from immigrants compared to all other groups, including overestimators. On average, nonresponders are also older, more likely to be female, have less education, less income, and live in countries with few immigrants and a lower GNP compared to the other categories" (\href{zotero://open-pdf/library/items/NPDY4DVY?page=13}{Herda 2013:225}) \par "Further, nonresponders represent a unique form of innumeracy characterized by low levels of all forms of cognitive availability, save for television and high levels of negative affect. The lack of retrievable evidence regarding immigrants likely explains their reticence to estimate. Limited contact seems particularly important as it serves to differentiate nonresponders from both overand underestimators. The contact hypothesis views intergroup interaction as a way to promote understanding of out-groups, which may also be necessary for respondents to feel confident enough to offer size estimates (Allport 1954/1979; Miller and Brewer 1984; Pettigrew 1988b). Regardless, the findings suggest that nonresponders are unique and should be considered by future innumeracy studies alongside overand underestimators." (\href{zotero://open-pdf/library/items/NPDY4DVY?page=20}{Herda 2013:232}) \par "Following existing research (Alba et al. 2005; Semyonov et al. 2008; Sides and Citrin 2007), overestimation is associated with greater anti-immigrant policy support in initial models. This is true of nonresponders as well, before introducing the full list of availability and affect controls. Conversely, underestimators express comparatively less support for both outcomes. This unique finding suggests that innumeracy is associated both with negative and positive immigrant policy orientations, depending on its direction. This again highlights that innumeracy is more nuanced and multifaceted than portrayed in the existing literature." (\href{zotero://open-pdf/library/items/NPDY4DVY?page=20}{Herda 2013:232}) \par "Building on this finding, it appears that both the negative perceptions of overestimators and the positive perceptions of underestimators work to explain these innumeracy associations. However, the significant innumeracy slopes remaining net of all controls are contrary to Semyonov et al. (2004), whose coefficients were explained completely by threat perceptions." (\href{zotero://open-pdf/library/items/NPDY4DVY?page=20}{Herda 2013:232}) \par \subsubsubsection{Summary Note} \subsubsubsection{Major question:} \par What is the extent of underestimation and\\ innumeracy nonresponse? (2) What factors distinguish underestimators and nonresponders from overestimators? And (3) are these alternative innumeracy forms\\ associated with support for anti-immigrant policies? \par \subsubsubsection{Method:} \par multinomial logistic regression \par \subsubsubsection{Data, Variables and definitions:} \par 2002 European Social Survey \par \subsubsubsection{Findings:} \subsubsubsection{Conclusions} \subsubsubsection{Comments}},
	number = {2},
	pages = {213--240},
	shortjournal = {Sociological Perspectives},
	shorttitle = {Too {{Many Immigrants}}?},
	title = {Too {{Many Immigrants}}? {{Examining Alternative Forms}} of {{Immigrant Population Innumeracy}}},
	url = {http://journals.sagepub.com/doi/10.1525/sop.2013.56.2.213},
	urldate = {2022-03-10},
	volume = {56},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1525/sop.2013.56.2.213},
	bdsk-url-2 = {https://doi.org/10.1525/sop.2013.56.2.213}}

@article{hernandez-leonMakingCarpetMile2000,
	abstract = {This paper presents a case study of an emerging Mexican immigrant community in a small city of the U.S. historic South. Within the bounds of the case, the paper shows how new destinations of immigration are established in the post-IRCA era. Methods. Using ethnographic and Census data, the authors examine immigrant community demographic and labor market characteristics. The authors analyze survey data on the trajectories and time line that newcomer men and women have followed to form a permanent settlement in an atypical location. Results. The results indicate the rapid and sizable growth of a Mexican immigrant settlement and the incorporation of its members into local industrial labor markets. Origins, trajectories, and timing of arrival are differentiated for men and women. Men have arrived first, some of them as secondary migrants, leaving the traditional Mexican Southwestern homeland. Women and children have come next, some of them directly from Mexico. Conclusions. Findings suggest that a new array of post-IRCA destinations are rising as a consequence of the secondary migrations of amnestied Mexicans. Permanent settlement is a feature of these new destinations as family reunification is taking place in such nontraditional receiving areas.},
	author = {Hernandez-Le{\'o}n, Ruben and Zuniga, Victor},
	date = {2000-03},
	file = {Hernandez-Leon_Zuniga_2000_Making Carpet by the Mile.pdf},
	issn = {00384941},
	journaltitle = {Social Science Quarterly (University of Texas Press)},
	keywords = {Emigration & immigration,Immigrants,Immigration law -- United States,Mexicans},
	note = {\textbf{Extracted Annotations (2/6/2022, 10:30:32 PM)} \par "The main purpose of this article is twofold: first, to analytically describe, using the methods of the case study (Burawoy et al., 1991; Hammersley, 1992; Hammersley and Atkinson, 1995), the rise of a Mexican immigrant community in an industrial region of the U.S. historic South. This community is located in a small city of northwest Georgia, where members are employed in the carpet and poultry processing industries. The sudden and large inflow of Mexican immigrants has had a great impact on the demographic and ethnic composition, the educational services, and the economic and political life of the place that from now on we will call Carpet City" (\href{zotero://open-pdf/library/items/AE6XF3LX?page=4}{Hernandez-Le{\'o}n and Zuniga 2000:52}) \par "ng question: How are new destinations of Mexican immigration established in a post-IRCA era? In order to respond to these questions, we look at the differentiated trajectories and time lines that migrant men and women follow to arrive in Carpet City, a destination situated outside the traditional receiving states where large Mexican settlements have historically been located." (\href{zotero://open-pdf/library/items/AE6XF3LX?page=5}{Hernandez-Le{\'o}n and Zuniga 2000:53}) \par "or example, while nearly half of the mothers lived in Mexico before coming to Carpet City, less than 40\% of the fathers arrived here directly from their country of origin. T" (\href{zotero://open-pdf/library/items/AE6XF3LX?page=12}{Hernandez-Le{\'o}n and Zuniga 2000:60})},
	number = {1},
