	keywords = {/unread},
	langid = {english},
	pages = {23780231231171581},
	publisher = {SAGE Publications},
	title = {Unjust {{Income Inequality Prevails Across}} 29 {{Countries}}},
	url = {https://doi.org/10.1177/23780231231171581},
