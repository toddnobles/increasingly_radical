@article{millward-hopkinsLargeInequalitiesClimate2024,
	abstract = {Existing global climate mitigation scenarios perpetuate large inequalities in energy and income between countries and regions for the rest of the century, and modellers have recently begun to assess these dynamics in light of distributive justice theories. However, these theories are intended to describe inequalities within nations and cannot straightforwardly be applied to inequalities between nations or world regions. Indeed, an analysis of key distributive justice theories suggests that, in contexts of international or interregional inequalities, moral justifications for inequality cannot be sustained, while arguments in favour of egalitarianism become stronger.},
	author = {Millward-Hopkins, Joel and Saheb, Yamina and Hickel, Jason},
	date = {2024-12-01},
	doi = {10.1016/j.erss.2024.103813},
	file = {../../../Zotero/storage/N4JHCBZ9/Millward-Hopkins et al. - 2024 - Large inequalities in climate mitigation scenarios are not supported by theories of distributive jus.pdf;../../../Zotero/storage/D2H3NHVD/S2214629624004043.html},
	issn = {2214-6296},
	journaltitle = {Energy Research \& Social Science},
	keywords = {Climate mitigation,Distributional justice,Energy inequality,Integrated assessment modelling},
	pages = {103813},
	shortjournal = {Energy Research \& Social Science},
	title = {Large Inequalities in Climate Mitigation Scenarios Are Not Supported by Theories of Distributive Justice},
	url = {https://www.sciencedirect.com/science/article/pii/S2214629624004043},
	urldate = {2025-03-31},
	volume = {118},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S2214629624004043},
	bdsk-url-2 = {https://doi.org/10.1016/j.erss.2024.103813}}

@article{milnerPopulationTrendsTransition2023,
	abstract = {Agriculture---specifically an intensification of the production of readily stored food and its distribution---has supported an increase in the global human population throughout the Holocene. Today, with greatly accelerated of growth during recent centuries, we have reached about 8 billion people. Human skeletal and archaeobotanical remains clarify what occurred over several millennia of profound societal and population change in small-scale societies once distributed across the North American midcontinent. Stepwise, not gradual, changes in the move toward an agriculturally based life, as indicated by plant remains, left a demographic signal reflecting age-independent ( 𝛼 2 ) mortality as estimated from skeletons. Designated the age-independent component of the Siler model, it is tracked through the juvenility index (JI), which is increasingly being used in studies of archaeological skeletons. Usually interpreted as a fertility indicator, the JI is more responsive to age-independent mortality in societies that dominated most of human existence. In the midcontinent, the JI increased as people transitioned to a more intensive form of food production that prominently featured maize. Several centuries later, the JI declined, along with a reversion to a somewhat more diverse diet and a reduction in overall population size. Changes in age-independent mortality coincided with previously recognized increases in intergroup conflict, group movement, and pathogen exposure. Similar rises and falls in JI values have been reported for other parts of the world during the emergence of agricultural systems.},
	author = {Milner, George R. and Boldsen, Jesper L.},
	date = {2023-01-24},
	doi = {10.1073/pnas.2209478119},
	file = {Milner_Boldsen_2023_Population trends and the transition to agriculturee2209478119.pdf},
	journaltitle = {Proceedings of the National Academy of Sciences},
	number = {4},
	pages = {e2209478119},
	publisher = {Proceedings of the National Academy of Sciences},
	shorttitle = {Population Trends and the Transition to Agriculture},
	title = {Population Trends and the Transition to Agriculture: {{Global}} Processes as Seen from {{North America}}},
	url = {https://www.pnas.org/doi/10.1073/pnas.2209478119},
	urldate = {2024-04-09},
	volume = {120},
	bdsk-url-1 = {https://www.pnas.org/doi/10.1073/pnas.2209478119},
	bdsk-url-2 = {https://doi.org/10.1073/pnas.2209478119}}

@article{mindischneiderDeepeningRepairingMetabolic2010,
	abstract = {This paper critically assesses the metabolic rift as a social, ecological, and historical concept describing the disruption of natural cycles and processes and ruptures in material human-nature relations under capitalism. As a social concept, the metabolic rift presumes that metabolism is understood in relation to the labour process. This conception, however, privileges the organisation of labour to the exclusion of the practice of labour, which we argue challenges its utility for analysing contemporary socio-environmental crises. As an ecological concept, the metabolic rift is based on outmoded understandings of (agro) ecosystems and inadequately describes relations and interactions between labour and ecological processes. Historically, the metabolic rift is integral to debates about the definitions and relations of capitalism, industrialism, and modernity as historical concepts. At the same time, it gives rise to an epistemic rift, insofar as the separation of the natural and social worlds comes to be e...},
	author = {{Mindi Schneider} and {Mindi Schneider} and {Philip McMichael} and {Philip McMichael}},
	date = {2010},
	doi = {10.1080/03066150.2010.494371},
	journaltitle = {The Journal of Peasant Studies},
	keywords = {/unread},
	shortjournal = {The Journal of Peasant Studies},
	title = {Deepening, and Repairing, the Metabolic Rift.},
	bdsk-url-1 = {https://doi.org/10.1080/03066150.2010.494371}}

@article{minkoffLivingInequalityNeighborhood2019,
	abstract = {This article explores whether the places where people live---and specifically the diversity of incomes where people live---influence views about income inequality. Using a unique survey of New York City that contains geographic identifiers and questions about attitudes toward inequality, coupled with a rich array of Census data, we assess the degree to which the income diversity within spatially customized neighborhood boundaries influences beliefs about inequality. We find consistent evidence that attitudes about inequality are influenced by the places where people live---those who are exposed to more income diversity near their homes perceive larger gaps between the rich and everybody else, and are more likely to believe that the gap should be smaller. Moreover, this effect appears to be especially pronounced among those with lower educational attainment and at either end of the income spectrum.},
	annotation = {43 citations (Crossref) [2024-05-04]},
	author = {Minkoff, Scott L. and Lyons, Jeffrey},
	date = {2019-03-01},
	doi = {10.1177/1532673X17733799},
