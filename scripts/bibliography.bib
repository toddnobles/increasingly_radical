	pages = {1185--1206},
	shorttitle = {Issue {{Voting}} and {{Immigration}}},
	title = {Issue {{Voting}} and {{Immigration}}: {{Do Restrictionist Policies Cost Congressional Republicans Votes}}?},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/ssqu.12000},
