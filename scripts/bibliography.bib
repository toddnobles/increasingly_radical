@article{haConsequencesMultiracialContexts2010,
	abstract = {This study examines how racial contexts relate to Americans' opinion toward immigration. Survey data analysis reveals that racial surroundings correspond to public attitudes differently, depending on race and geographic unit. For non-Hispanic white Americans, proximity to Asians correlates with positive attitudes toward immigrants, whereas those living with Hispanics are more likely to harbor negative stereotypes. Conversely, African Americans living with Asians are more likely to be prejudiced against immigrants. Furthermore, the positive effects of racial contexts are more salient in the neighborhoods than in larger areas. These findings suggest the significance of racial integration in alleviating interethnic tension.},
