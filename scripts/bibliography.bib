@article{rogersCommunotropicTheoryEconomic2014,
	abstract = {Within the social sciences, there is a long and storied history of the effect of economic conditions on vote choice. The traditional arguments are that voters have personal (egotropic) and/or other-regarding (sociotropic) preferences and that they reward and punish politicians electorally based on economic conditions at these levels. However, there is a third option. As industries, employment, and economic conditions are not uniformly distributed across the country, preferences may be locally based. This project combines unique survey data with Metropolitan Statistical Area unemployment numbers and finds evidence of distinct preferences at a third ``communotropic'' level.},
	annotation = {28 citations (Crossref) [2024-05-04]},
	author = {Rogers, Jonathan},
	date = {2014-12},
	doi = {10.1016/j.electstud.2014.08.004},
	file = {Rogers_2014_A communotropic theory of economic voting107-116.pdf},
	issn = {02613794},
	journaltitle = {Electoral Studies},
	keywords = {local conditions,reviewed},
	langid = {english},
	note = {\textbf{Extracted Annotations (11/17/2021, 11:30:17 AM)} \par "Let us define'communotropic' voting to be the electoral rewarding or punishing of incumbents for general economic conditions within a particular community or region" (\href{zotero://open-pdf/library/items/LQWB2KMT?page=2}{Rogers 2014:108}) \par "A communotropic theory of economic voting is not so strict. All it requires is that voters have a sense of community and can perceive whether times are good or poor. In order to study this, it is necessary to assess the effects of both objective local conditions and perceptions thereof." (\href{zotero://open-pdf/library/items/LQWB2KMT?page=2}{Rogers 2014:108}) \par "Hypothesis 1. Increases in the local unemployment rate will be negatively associated with perceptions of local conditions, but will not be related to perceptions of personal or national conditions." (\href{zotero://open-pdf/library/items/LQWB2KMT?page=2}{Rogers 2014:108}) \par "Hypothesis 2. Improvements (decline) in local economic conditions will increase (decrease) approval of officials at all levels of government" (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "Hypothesis 3. Perceived changes in national economic conditions will not affect approval of state level officials" (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "Hypothesis 4. Improvements in both perceived and objective economic conditions will positively affect approval" (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "FSU module A of the 2010 Cooperative Congressional Election Study (CCES). These include perceptions of personal, local, and national economic conditions. Each yields the respective variable Personal, Community, and Nation, which are ordinal variables coded from 0 to 4. 0 means that the respondent believes economic conditions at the given level to have gotten much worse over the past year, while 4 means they have gotten much better. Exact question wording can be found in the Appendix. Responsible is a dichotomous variable, coded 1 if the respondent believes the federal government to be primarily responsible for local economic conditions, 0 otherwise" (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "Next, using the zip codes collected as part of the CCES, respondents are coded based on the Metropolitan Statistical Area (MSA) in which they live" (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "While other levels of aggregation, like the county, are possible, MSA unemployment is used here for several reasons. The lowest disaggregation of unemployment data commonly reported in the media is MSA unemployment. MSAs are also the most likely to be the broadcasting point for local media. Smaller units, such as towns and counties, may also have media sources, but this is less uniform." (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "A third, less formal reason for using MSA level unemployment is how individuals may self identify their residences to outsiders. Proximity to a metropolitan area provides an informative reference point." (\href{zotero://open-pdf/library/items/LQWB2KMT?page=3}{Rogers 2014:109}) \par "While further research is needed, particularly with validated vote and observational data, there is reason to believe that voters possess distinct communotropic preferences and that these preferences affect political attitudes with respect to all levels of government." (\href{zotero://open-pdf/library/items/LQWB2KMT?page=8}{Rogers 2014:114})},
	pages = {107--116},
	shortjournal = {Electoral Studies},
	title = {A Communotropic Theory of Economic Voting},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0261379414000936},
	urldate = {2021-11-16},
	volume = {36},
	bdsk-url-1 = {https://linkinghub.elsevier.com/retrieve/pii/S0261379414000936},
	bdsk-url-2 = {https://doi.org/10.1016/j.electstud.2014.08.004}}

@article{rogersInformationEconomicVoting2018,
	abstract = {The connection between the economy and vote choice continues to garner interest both in the academic and popular press. To isolate the effects of economic considerations, we develop a laboratory experiment that allows us to vary these considerations at three levels: the individual, community, and national economy. Choices by policymakers directly affect outcomes at each of these levels, allowing us to test for egotropic, ``communotropic,'' and sociotropic voting, as well as examine information search. We observe significant demand for information and that demand decreases with the complexity of the environment. Moreover, information demand is positively associated with other-regarding behavior.},
	annotation = {7 citations (Crossref) [2024-05-04]},
	author = {Rogers, Jonathan and Tyszler, Marcelo},
	date = {2018-10},
	doi = {10.1017/psrm.2016.27},
