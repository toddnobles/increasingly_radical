@article{kornrichEgalitarianismHouseworkSexual2013,
	abstract = {Changes in the nature of marriage have spurred a debate about the consequences of shifts to more egalitarian relationships, and media interest in the debate has crystallized around claims that men who participate in housework get more sex. However, little systematic or representative research supports the claim that women, in essence, exchange sex for men?s participation in housework. Although research and theory support the expectation that egalitarian marriages are higher quality, other studies underscore the ongoing importance of traditional gender behavior and gender display in marriage. Using data from Wave II of the National Survey of Families and Households, this study investigates the links between men?s participation in core (traditionally female) and non-core (traditionally male) household tasks and sexual frequency. Results show that both husbands and wives in couples with more traditional housework arrangements report higher sexual frequency, suggesting the importance of gender display rather than marital exchange for sex between heterosexual married partners.},
	author = {Kornrich, Sabino and Brines, Julie and Leupp, Katrina},
	date = {2013-02-01},
	doi = {10.1177/0003122412472340},
	file = {Kornrich et al_2013_Egalitarianism, Housework, and Sexual Frequency in Marriage.pdf},
	issn = {0003-1224},
	journaltitle = {American Sociological Review},
	number = {1},
	pages = {26--50},
	publisher = {SAGE Publications Inc},
	shortjournal = {Am Sociol Rev},
	title = {Egalitarianism, {{Housework}}, and {{Sexual Frequency}} in {{Marriage}}},
	url = {https://doi.org/10.1177/0003122412472340},
	urldate = {2021-11-23},
	volume = {78},
	bdsk-url-1 = {https://doi.org/10.1177/0003122412472340}}

@article{korver-glennCompoundingInequalitiesHow2018,
	abstract = {Despite numerous legal interventions intended to mitigate racial discrimination in the United States, racial inequality persists in virtually every domain that matters for human well-being. To better understand the processes enabling this durable inequality, I undertake a case study of the housing market---a domain centrally linked to persistent, systemic disparity. I examine how racial stereotypes permeate the distinct but serially linked stages of the housing exchange process; the conditions under which stereotypes are deployed in each stage; and how such dynamics accumulate to affect ultimate processes of exclusion and inclusion. Drawing on one year of ethnographic fieldwork and more than 100 in-depth interviews in the Houston housing market, my findings demonstrate that widely shared, hierarchical stereotypes about race, supported by conditions such as network-necessitated rapport-building and discretion, compound discrimination across discrete stages of housing exchange. I argue that as this accumulation occurs, inequality between minorities and minority neighborhoods and whites and white neighborhoods is rendered durable.},
	author = {Korver-Glenn, Elizabeth},
	date = {2018-08},
	doi = {10.1177/0003122418781774},
	file = {Korver-Glenn_2018_Compounding Inequalities627-656.pdf},
	issn = {0003-1224, 1939-8271},
	journaltitle = {American Sociological Review},
	keywords = {ObsCite},
	langid = {english},
	note = {\section{Annotations\\ (5/19/2023, 1:14:53 PM)} \par ``Because this real estate agent understood that Daniel had discretion in selecting comps and, ultimately, determining the home's value, she asked him to select lower-value comps so the appraised value would not meet the contract price. In turn, this would mean the contract with the prospective black buyer would not be binding, and she could find a different, non-black buyer for the home'' (Korver-Glenn, 2018, p. 649) \par ``Finally, once an appraiser calculates a home's value, the appraisal must go through a final risk assessment at the mortgage lending company. I found that one way lenders assess appraisal risk is by using a Fannie Maedeveloped software called Collateral Underwriter. Collateral Underwriter, an automated risk-assessment software, flags appraiserselected comps deemed as dissimilar, using similarity in location, home size, year built, and style as important factors in its formula. Thus, lenders' and underwriters' use of Collateral Underwriter indirectly reinforced appraisers' racialized comp selection and'' (Korver-Glenn, 2018, p. 649) \par ``assumptions about prospective buyers by penalizing appraisers who chose comps across neighborhood lines, once again reflecting historical and contemporary neighborhood racial divisions back into the appraisal and mortgage underwriting process'' (Korver-Glenn, 2018, p. 650) \par ``Even if contemporary appraisal practices were devoid of racial stereotyping and bias (a conclusion my data do not support), the widely shared practice of selecting comps from what are already racially homogenous neighborhoods would continue to reproduce the historic legacy of appraising home values through the lens of neighborhood racial composition'' (Korver-Glenn, 2018, p. 651)},
	number = {4},
	pages = {627--656},
	shortjournal = {Am Sociol Rev},
	shorttitle = {Compounding {{Inequalities}}},
	title = {Compounding {{Inequalities}}: {{How Racial Stereotypes}} and {{Discrimination Accumulate}} across the {{Stages}} of {{Housing Exchange}}},
	url = {http://journals.sagepub.com/doi/10.1177/0003122418781774},
	urldate = {2022-04-21},
	volume = {83},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1177/0003122418781774},
	bdsk-url-2 = {https://doi.org/10.1177/0003122418781774}}

@article{kossekWorkLifeFlexibilityWhom2017,
	abstract = {We define work-life flexibility as employment scheduling practices that are designed to give employees greater control over when, where, how much or how continuously work is done. Research has under-examined how work-life flexibility is stratified across occupations. We review how occupational status and flexibility experiences vary and shape work-life inequality, which we identify as a form of job inequality. We investigate the range of definitions, measurement approaches and theorizing regarding work-life flexibility. We find that employees across occupational groups experience different work-life flexibility outcomes from different flexibility types. Providing employee control over scheduling variation (flextime) may benefit lower-level workers the most, yet many are unable to access this flexibility form. Part-time work permitting control over work volume/workload hurts lower-level employees the most (due to involuntary income and benefits loss). Yet these same part-time practices enhance recruitment and retention for upper-level jobs, but harm promotion and pay. Work continuity control (leaves) benefits upper and middle-level employees, but is largely unavailable to lower-level workers. Flexibility to control work location is rarely available for lower-level jobs; but benefits middle and upper-level employees, provided that are able to control separation from work when desired and self-regulate complexity. We offer implications for research and practice.},
	annotation = {107 citations (Crossref) [2022-12-10]},
	author = {Kossek, Ellen and Lautsch, Brenda},
	date = {2017-05-19},
	doi = {10.5465/annals.2016.0059},
	journaltitle = {Academy of Management Annals},
	pages = {annals.2016.0059},
	shortjournal = {Academy of Management Annals},
	shorttitle = {Work-{{Life Flexibility}} for {{Whom}}?},
	title = {Work-{{Life Flexibility}} for {{Whom}}? {{Occupational Status}} and {{Work-Life Inequality}} in {{Upper}}, {{Middle}}, and {{Lower Level Jobs}}},
	volume = {12},
	bdsk-url-1 = {https://doi.org/10.5465/annals.2016.0059}}

