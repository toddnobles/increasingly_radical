	shortjournal = {City \& Community},
	shorttitle = {Community {{Lost}} or {{Transformed}}?},
	title = {Community {{Lost}} or {{Transformed}}? {{Urbanization}} and {{Social Ties}}},
	url = {http://journals.sagepub.com/doi/10.1111/1540-6040.00053},
	urldate = {2022-04-08},
