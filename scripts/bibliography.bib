	number = {4},
	pages = {959--978},
	shorttitle = {What {{Triggers Public Opposition}} to {{Immigration}}?},
	title = {What {{Triggers Public Opposition}} to {{Immigration}}? {{Anxiety}}, {{Group Cues}}, and {{Immigration Threat}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1540-5907.2008.00353.x},
	urldate = {2022-03-09},
