@article{beramendiDisparateGeographyOrigins2021,
	abstract = {We establish a conceptual and empirical link between the geographic distribution of economic endowments within a nation and long-run fiscal capacity. Economic geography informs elites' incentives to facilitate large-scale central taxing bureaucracies. Sectoral economic advantage also provides them with leverage to transform these state-building incentives into policy and stable institutional equilibria. We argue that unequal economic endowments across the geography of a nation exacerbate distributive tensions. Political disagreement over the size and the scope of the state hinder centralized investments in state capacity to collect taxes. Using detailed sub-national data and indicators of geographic distribution, we demonstrate global patterns of sub-national economic geography, and how these patterns are related to sub-national variation in economic productivity. We show that divergence in sub-national economies varies across the world and is related to predictable differences in the size of the fiscal state.},
	author = {Beramendi, Pablo and Rogers, Melissa},
	date = {2021-01-01},
	doi = {10.1007/s11558-018-9319-2},
	file = {Beramendi_Rogers_2021_Disparate geography and the origins of tax capacity.pdf},
	issn = {1559-744X},
	journaltitle = {The Review of International Organizations},
	langid = {english},
	note = {\begin{itemize} \item Relationship/Hypothesis: examine geographic distribution of economic endowments within a nation and the long-run fiscal capacity. Argue that unequal economic endowments across the geography of a nation exacerbate distributive tensions. \item Data: use sub-national soil quality and agricultural suitability variables \item Methods: PCA to combine those two measures (The first component picks up mainly variation associated with the precipitation and nation size and the second component picking up mainly soil quality and elevation.). Regions are states/provinces or equivalents. \begin{itemize} \item Our main independent variables, sub-national variation in agricultural suitability, are time invariant. While we do have time varying dependent\\ variables (central and general tax revenue, government consumption) and co-variates,\\ we argue that the patterns that we observe are largely stable over long periods of time,\\ including the cross-national differences in tax collection. In each regression model\\ we collapse all of our variables to their mean value, for a country cross-section structure, and we limit the number of controls given our small sampl \end{itemize} \item Findings: \item Implications: differences in endowmnets lead to differences in productivity and then areas with high productiviity imay nvest less in central fiscal state thinking that it will be redistributed to less productive regions (pg 233). \item Reactions: they assume competitive nature of sub national regions rather than willingness to aid and distribute gains \end{itemize}},
	number = {1},
	pages = {213--237},
	shortjournal = {Rev Int Organ},
	title = {Disparate Geography and the Origins of Tax Capacity},
	url = {https://doi.org/10.1007/s11558-018-9319-2},
	urldate = {2021-10-15},
	volume = {16},
	bdsk-url-1 = {https://doi.org/10.1007/s11558-018-9319-2}}

