@article{brubakerReturnAssimilationChanging2001,
	abstract = {This article argues that the massive differentialist turn of the last third of the twentieth century may have reached its peak, and that one can discern signs of a modest ``return of assimilation''. The article presents evidence of this from the domain of public discourse in France, public policy in Germany, and scholarly research in the US. Yet what has ``returned'' is not the old, analytically discredited and politically disreputable ``assimilationist'' understanding of assimilation, but a more analytically complex and normatively defensible understanding. The article concludes by specifying the ways in which the concept of assimilation has been transformed.},
	author = {Brubaker, Rogers},
	date = {2001-01},
	doi = {10.1080/01419870120049770},
	file = {Brubaker - 2001 - The return of assimilation Changing perspectives .pdf},
	issn = {0141-9870, 1466-4356},
	journaltitle = {Ethnic and Racial Studies},
	langid = {english},
	note = {\textbf{Extracted Annotations (1/3/2022, 1:29:09 PM)} \par "It is no longer true that assimilation (or integration, a term that often, especially in the European context, refers to much the same thing) is 'inevitably' conceptualized as occurring 'into one, single, indivisible (national) "state", and one, simple, unitary (national) "society"' (Favell 2000)" (\href{zotero://open-pdf/library/items/IEMKKE39?page=11}{Brubaker 2001:541}) \par "This has entailed a shift from the monodimensional question, 'how much assimilation?' to the multidimensional question, 'assimilation in what respect, over what period of time, and to what reference population?' It has also entailed a shift from an assimilationist understanding of assimilation - a global empirical expectation and normative endorsement of assimilation - to an agnostic stance, varying by domain and reference population, concerning both the likelihood and the desirability of assimilation. Reformulated in" (\href{zotero://open-pdf/library/items/IEMKKE39?page=15}{Brubaker 2001:545})},
	number = {4},
	pages = {531--548},
	shortjournal = {Ethnic and Racial Studies},
	shorttitle = {The Return of Assimilation?},
	title = {The Return of Assimilation? {{Changing}} Perspectives on Immigration and Its Sequels in {{France}}, {{Germany}}, and the {{United States}}},
	url = {http://www.tandfonline.com/doi/abs/10.1080/01419870120049770},
	urldate = {2022-01-03},
	volume = {24},
	bdsk-url-1 = {http://www.tandfonline.com/doi/abs/10.1080/01419870120049770},
	bdsk-url-2 = {https://doi.org/10.1080/01419870120049770}}

@article{bruchNeighborhoodChoiceNeighborhood2006,
	abstract = {This article examines the relationships between the residential choices of individuals and aggregate segregation patterns. Analyses based on computational models show that high levels of segregation occur only when individuals' preferences follow a threshold function. If individuals make finer‐grained distinctions among neighborhoods that vary in racial composition, preferences alone do not lead to segregation. Vignette data indicate that individuals respond in a continuous way to variations in the racial makeup of neighborhoods rather than to a threshold. Race preferences alone may be insufficient to account for the high levels of segregation observed in American cities.},
	annotation = {202 citations (Crossref) [2023-05-22]},
	author = {Bruch, Elizabeth~E. and Mare, Robert~D.},
	date = {2006-11},
	doi = {10.1086/507856},
