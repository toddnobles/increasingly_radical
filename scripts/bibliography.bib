@book{adamsLegalConceptWork2022,
	author = {Adams, Zoe},
	date = {2022},
	edition = {First edition},
	isbn = {978-0-19-285777-4},
	keywords = {/listened,Great Britain,Labor laws and legislation,ObsCite},
	location = {Oxford, United Kingdom},
	note = {listened to podcast from new books network. A very marxist angle on the role of law in society and the manner in which it is created and shaped. \par Traces the history of the definition of work in law. Emphasizes the historical roots of routinized work at a place that employer owns as much of the basis for our definition of what types of work are codified. Has some interesting extensions to the interplay between management styles and techniques in the algorithmic economy and gig worker. \par The above definition of work centered around factory work leads to work being gendered and the law being gendered to prioritize power for men in the capitalist system (as they earn money for their labor) while women and their work is not valued in the same way. \par highlights the difficulty in defining work for knowledge workers and in particular in her case study of academics and whether writing garbage at your desk is work but thinking on a walk is not. \par implications worth exploring: \par \begin{itemize} \item First picking up on the key theme that measuring and controlling capabilities of employers as critical in something being considered work in the legal definition. We've seen certain pieces of care work be measured and controlled (some hospital work or health care aides), but as they point out care work as inherently non-scarce (given that it's what we need to reproduce society on a daily basis) so deemed less valuable, even though it is critical to reproducing society \item We've seen some new efforts to track care work and other labor traditionally not considered work (see the DisCO model) \item How does the desire for control and measurability on the part of managers influence the debates around remote work? \end{itemize} \par There's something else here that I'm not quite articulating fully},
	pagetotal = {399},
	publisher = {Oxford University Press},
	title = {The Legal Concept of Work}}

@incollection{adamsStrategiesCollectingSocial2021,
	abstract = {This chapter provides an overview of social network data collection strategies. We begin by outlining the primary principles of sampling and measurement design, then describing how those combine into what is labeled the ``boundary specification problem'' for social network research. We accompany these definitions with examples of how these elements are applied across ego, partial, and complete network designs. Next, the chapter turns to the primary ways that network data have been evaluated, highlighting both the implications of those evaluations for their use in network analyses and various strategies for how the identified limitations can be leveraged for optimal data and analytic quality. The chapter concludes by addressing some of the ethical considerations that are unique to the gathering and analyses of social network data.},
	author = {{adams}, jimi and Santos, Tatiane and Williams, Venice Ng},
