@book{rosenfeldYouRePaid2021,
	abstract = {"Setting wages isn't an exact science, but we like to think that our workplace performance provides an objective basis for pay. You're Paid What You're Worth offers a bold theory to the contrary, arguing that pay is decided in contests over interests and ideals-that social conflicts, not economic metrics, determine who gets how much"--},
