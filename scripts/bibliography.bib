	file = {Hurst_Lusardi_2004_Liquidity Constraints, Household Wealth, and Entrepreneurship319-347.pdf},
	issn = {0022-3808},
	journaltitle = {Journal of Political Economy},
	number = {2},
	pages = {319--347},
	publisher = {The University of Chicago Press},
	title = {Liquidity {{Constraints}}, {{Household Wealth}}, and {{Entrepreneurship}}},
	url = {https://www.jstor.org/stable/10.1086/381478},
	urldate = {2024-03-27},
