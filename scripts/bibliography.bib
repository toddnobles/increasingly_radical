	issn = {1467-9221},
	journaltitle = {Political Psychology},
	keywords = {Authoritarianism,prejudice,punitiveness,societal threat},
	langid = {english},
	number = {4},
	pages = {741--770},
	title = {Perceived {{Threat}} and {{Authoritarianism}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/0162-895X.00077},
