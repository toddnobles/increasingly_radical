	issn = {0190-9320},
	journaltitle = {Political Behavior},
	number = {2},
	pages = {117--150},
	publisher = {Springer},
	shorttitle = {Beyond the {{Running Tally}}},
	title = {Beyond the {{Running Tally}}: {{Partisan Bias}} in {{Political Perceptions}}},
	url = {http://www.jstor.org/stable/1558352},
	urldate = {2021-11-17},
	volume = {24},
