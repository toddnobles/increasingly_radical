	keywords = {/unread},
	langid = {english},
	number = {6},
	pages = {e12795},
	shorttitle = {Digital Technologies and Power Dynamics in the Organization},
	title = {Digital Technologies and Power Dynamics in the Organization: {{A}} Conceptual Review of Remote Working and Wearable Technologies at Work},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/soc4.12795},
	urldate = {2023-06-05},
