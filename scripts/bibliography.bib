	number = {1},
	pages = {16--38},
	publisher = {[American Sociological Association, Sage Publications, Inc.]},
	shorttitle = {The {{Soviet Transition}} from {{Socialism}} to {{Capitalism}}},
	title = {The {{Soviet Transition}} from {{Socialism}} to {{Capitalism}}: {{Worker Control}} and {{Economic Bargaining}} in the {{Wood Industry}}},
	url = {https://www.jstor.org/stable/2096142},
	urldate = {2024-11-26},
	volume = {57},
	bdsk-url-1 = {https://www.jstor.org/stable/2096142},
