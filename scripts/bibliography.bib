@article{thomsenWhenDoesSuperficial2018,
	abstract = {This article expands intergroup contact research by examining how negative and positive contact experiences outside the private sphere condition the impact of superficial intergroup contact. Analyses show that (1) superficial intergroup contact spurs anti-foreigner sentiment among in-group members with very negative contact experiences, whereas (2) superficial intergroup contact reduces anti-foreigner sentiment among in-group members with positive contact experiences. Thus, the impact of superficial contact is highly conditioned by the characteristics of subjective contact experiences. These results were generated in a fixed-effects regression analysis of 21 countries and 27,404 individuals from the most recent 2014--European Social Survey (ESS) (round 7). In terms of theoretical implications, the findings suggest that the characteristics of contact experiences are essential for the ability of superficial intergroup contact to produce positive outcomes.},
	author = {Thomsen, Jens Peter Fr{\o}lund and Rafiqi, Arzoo},
	date = {2018-02-01},
	doi = {10.1177/0020715217744598},
	file = {Thomsen_Rafiqi_2018_When does superficial intergroup contact reduce anti-foreigner sentiment25-43.pdf},
	issn = {0020-7152},
	journaltitle = {International Journal of Comparative Sociology},
	keywords = {Anti-foreigner sentiment,contact experiences,fixed-effects regression,moderation,superficial intergroup contact},
	langid = {english},
	number = {1},
	pages = {25--43},
	publisher = {SAGE Publications Ltd},
	shortjournal = {International Journal of Comparative Sociology},
	shorttitle = {When Does Superficial Intergroup Contact Reduce Anti-Foreigner Sentiment?},
	title = {When Does Superficial Intergroup Contact Reduce Anti-Foreigner Sentiment? {{Negative}} Contact as an Essential Condition},
