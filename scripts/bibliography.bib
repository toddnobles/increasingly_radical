	issn = {1065-9129},
	journaltitle = {Political Research Quarterly},
	keywords = {immigration,Latino politics,racial context,segregation},
	number = {2},
	pages = {415--426},
	publisher = {SAGE Publications Inc},
	shortjournal = {Political Research Quarterly},
	title = {Racial {{Threat}}, {{Residential Segregation}}, and the {{Policy Attitudes}} of {{Anglos}}},
