@article{groenendykHowNormsShape2023,
	abstract = {How should ideology be understood, and should we be concerned if Americans lack it? Combining widely used survey questions with an incentivized coordination game, we separately measure individuals' own policy preferences and their knowledge of what other ideological group members expect them to believe. This allows us to distinguish knowledge of ideological norms---what liberals and conservatives believe ought to go with what---from adherence to those norms. We find that a nontrivial portion of those reporting ideologically inconsistent preferences do so knowingly, suggesting their lack of ideological constraint can be attributed to pragmatism rather than innocence. Additionally, a question order experiment reveals that priming ideological norms before measuring policy preferences promotes ideological adherence, suggesting ideological constraint is at least partially attributable to norm-conformity pressure. Together, these findings raise the question whether ideology is actually desirable or if it instead allows elites to reverse the direction of accountability.},
	author = {Groenendyk, Eric and Kimbrough, Erik O. and Pickup, Mark},
	date = {2023},
	doi = {10.1111/ajps.12717},
	file = {Groenendyk et al_2023_How Norms Shape the Nature of Belief Systems in Mass Publics623-638.pdf},
	issn = {1540-5907},
	journaltitle = {American Journal of Political Science},
	keywords = {/unread},
	langid = {english},
	number = {3},
	pages = {623--638},
	title = {How {{Norms Shape}} the {{Nature}} of {{Belief Systems}} in {{Mass Publics}}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12717},
	urldate = {2023-09-06},
	volume = {67},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12717},
	bdsk-url-2 = {https://doi.org/10.1111/ajps.12717}}

