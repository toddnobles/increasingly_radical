@incollection{braunAssetManagerCapitalism2021,
	abstract = {For too long, students of the political economy of corporate governance have been enthralled by the language of ownership and control. This language stems from Berle and Means (1932), who observed that trust-busting policies and the diversification of robber-baron fortunes had dispersed stock ownership in the United States, while concentrating corporate control in the hands of a small class of managers.1 Jensen and Meckling's (1976) agency theory, while reiterating the notions of shareholder dispersion and weakness, conceptualized shareholders as principals -- the only actors with a strong material interest in the economic performance of the corporation. Offering a simple solution to what Berle and Means had considered a complex political problem, agency theory reduced corporate governance to the problem of protecting outside minority shareholders against ``expropriation'' by insiders, namely corporate managers and workers (La Porta et al. 2000: 4).},
	author = {Braun, Benjamin},
	booktitle = {The {{American Political Economy}}: {{Politics}}, {{Markets}}, and {{Power}}},
	date = {2021},
	doi = {10.1017/9781009029841.010},
	editor = {Hertel-Fernandez, Alexander and Hacker, Jacob S. and Thelen, Kathleen and Pierson, Paul},
	file = {Braun_2021_Asset Manager Capitalism as a Corporate Governance Regime270-294.pdf;../../../Zotero/storage/SE2E94KA/3AD6C80F112EBDCA77DE228E408F3F49.html},
	isbn = {978-1-316-51636-2},
	keywords = {asset management,corporate governance,finance,ObsCite},
	location = {Cambridge},
	pages = {270--294},
	publisher = {Cambridge University Press},
	series = {Cambridge {{Studies}} in {{Comparative Politics}}},
	title = {Asset {{Manager Capitalism}} as a {{Corporate Governance Regime}}},
	url = {https://www.cambridge.org/core/books/american-political-economy/asset-manager-capitalism-as-a-corporate-governance-regime/3AD6C80F112EBDCA77DE228E408F3F49},
