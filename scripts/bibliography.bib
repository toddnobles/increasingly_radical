	shortjournal = {The ANNALS of the American Academy of Political and Social Science},
	shorttitle = {Political {{Polarization}} along the {{Rural-Urban Continuum}}?},
	title = {Political {{Polarization}} along the {{Rural-Urban Continuum}}? {{The Geography}} of the {{Presidential Vote}}, 2000--2016},
