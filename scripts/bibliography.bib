	pages = {519--542},
	shorttitle = {Leapfrog {{Representation}} and {{Extremism}}},
	title = {Leapfrog {{Representation}} and {{Extremism}}: {{A Study}} of {{American Voters}} and {{Their Members}} in {{Congress}}},
	url = {https://www.jstor.org/stable/40863767},
	urldate = {2024-01-08},
