@article{griesbachAlgorithmicControlPlatform2019,
	abstract = {Building on an emerging literature concerning algorithmic management, this article analyzes the processes by which food delivery platforms control workers and uncovers variation in the extent to which such platforms constrain the freedoms?over schedules and activities?associated with gig work. Drawing on in-depth interviews with 55 respondents working on food delivery platforms, as well as a survey of 955 platform food delivery workers, we find that although all of the food delivery platforms use algorithmic management to assign and evaluate work, there is significant cross-platform variation. Instacart, the largest grocery delivery platform, exerts a type of control we call ?algorithmic despotism,? regulating the time and activities of workers more stringently than other platform delivery companies. We conclude with a discussion of the implications of the spectrum of algorithmic control for the future of work.},
	author = {Griesbach, Kathleen and Reich, Adam and Elliott-Negri, Luke and Milkman, Ruth},
	date = {2019-01-01},
	doi = {10.1177/2378023119870041},
	file = {Griesbach et al_2019_Algorithmic Control in Platform Food Delivery Work2378023119870041.pdf},
	issn = {2378-0231},
	journaltitle = {Socius},
	pages = {2378023119870041},
	publisher = {SAGE Publications},
	title = {Algorithmic {{Control}} in {{Platform Food Delivery Work}}},
	url = {https://doi.org/10.1177/2378023119870041},
	urldate = {2022-12-10},
	volume = {5},
	bdsk-url-1 = {https://doi.org/10.1177/2378023119870041}}

@book{grinkerNobodyNormalHow2022,
	abstract = {""In this 'beautifully written... remarkable history' (Alix Spiegel), anthropologist Roy Richard Grinker chronicles the progress and setbacks in the struggle against mental illness stigma--from the eighteenth century, through America's major wars, and into today's high-tech economy. Nobody's Normal argues that stigma is a social process that began the moment we defined mental illness, but one that we ultimately have the power to change. Combining cutting-edge science, cross-cultural research, and Grinker's own family history, Nobody's Normal explores how communities throughout the world respond to neurodiversity and offers a path to end the shadow of stigma."--Back cover},
