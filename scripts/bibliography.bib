@article{chalelaDebtEntanglementsRethinking2025,
	abstract = {The creation of debt has been a constitutive process of the developmental state. While most studies of debt and development focus on the creation of neoliberal individual indebtedness or foreign debt as a constitutive element of global power, this paper seeks to understand how debt became entangled with the ideological-structural nexus that characterizes the developmental state. We explore the case of the Colombian Agrarian Bank during the mid-twentieth century to unpack the entanglements of debt that sustained state intervention and capitalist development in those years across Latin America. In particular, we examine the formation of national-level institutional credit infrastructure and the promotion of indebted subjects and credit-and-debt relationships as part of a distinctive regime of accumulation. Thinking about debt as a set of entangled dimensions can help reconsider the relationship between state formation, ideology and capitalist development in the global South.},
	author = {Chalela, Mariana D{\'\i}az and family=G{\'o}mez-Delgado, given=Juli{\'a}n, prefix=and, useprefix=true},
	date = {2025-01-02},
	doi = {10.1080/03085147.2025.2450146},
	issn = {0308-5147},
	journaltitle = {Economy and Society},
	keywords = {Colombia,debt,development,developmental state,Latin America},
	number = {1},
	pages = {70--91},
	publisher = {Routledge},
	shorttitle = {Debt Entanglements},
	title = {Debt Entanglements: {{Rethinking}} the Developmental State in the Global {{South}}},
	url = {https://doi.org/10.1080/03085147.2025.2450146},
	urldate = {2025-03-31},
	volume = {54},
	bdsk-url-1 = {https://doi.org/10.1080/03085147.2025.2450146}}

@article{chandrashekeranMakingMarketsData2022,
	abstract = {This paper shows how the capture and circulation of data about social lives are enabled through digitalisation and market logics and practices. Drawing on Australia's new Consumer Data Right, a state-led initiative that creates access rights to personal data, we distinguish between market promises and the translation of market models in actually existing markets and regulatory frameworks. `Life's work' is brought to market through promises to fix the problems of essential service markets by harnessing data. We argue that the Consumer Data Right is underpinned by a more ambitious vision to create future markets that transcend individual sectors through aggregation across the economy. These visions are silent on how the data, which cannot be owned and therefore cannot be commoditised, is capitalised. We show the Consumer Data Right's discursive, administrative, regulatory and technical aspects through which the previously hard-to-penetrate spaces of the home and everyday life become enrolled in circuits of value, both present and future. This involves technical standard setting by state agencies for accreditation, consent and approval processes; discourses of trust and calculative devices to promote consumer control; and weak de-identification and deletion requirements that grant data an afterlife beyond the original agreed use. This paper calls for greater attention to the enabling role of the state in digital markets as a counterbalance to the focus on the state's regulatory and constraining role. We argue for a more staged approach to market-making analysis to show how the state lays the market foundations that can then be deepened through practices of intermediation and capitalisation by private firms.},
	author = {Chandrashekeran, Sangeetha and Keele, Svenja},
	date = {2022-03-21},
	doi = {10.1177/0308518X221083985},
	file = {Chandrashekeran_Keele_2022_Making markets from the data of everyday life0308518X221083985.pdf},
	issn = {0308-518X},
	journaltitle = {Environment and Planning A: Economy and Space},
	keywords = {/unread},
	langid = {english},
	pages = {0308518X221083985},
	publisher = {SAGE Publications Ltd},
	shortjournal = {Environ Plan A},
	title = {Making Markets from the Data of Everyday Life},
	url = {https://doi.org/10.1177/0308518X221083985},
	urldate = {2023-09-06},
	bdsk-url-1 = {https://doi.org/10.1177/0308518X221083985}}

