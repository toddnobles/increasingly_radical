	number = {1},
	pages = {84--99},
	shortjournal = {Sociological Theory},
	shorttitle = {Shame and the {{Social Bond}}},
	title = {Shame and the {{Social Bond}}: {{A Sociological Theory}}},
	url = {http://journals.sagepub.com/doi/10.1111/0735-2751.00089},
	urldate = {2023-01-17},
