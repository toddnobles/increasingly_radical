@incollection{knappettNetworksArchaeology2021,
	abstract = {This chapter reviews the prolific recent uptake of network concepts and methods in archaeology. Quite different kinds of models have proven popular---some use theoretical propositions to create their network outputs, while others build their networks from the bottom up based on material evidence. These can be called theory models and data models, respectively. This chapter argues that the former typically focus on dyadic links, often across some spatial divide, and the latter are better equipped for identifying triadic social relations. Therefore, these key scalar differences need to be recognized when trying to understand different archaeological approaches to network analysis. The chapter further suggests that the considerable archaeological interest in exploring the complex relations between humans and artifacts in topological rather than geographical terms is only just gaining traction in network analysis, with considerable future potential.},
	author = {Knappett, Carl},
	booktitle = {The {{Oxford Handbook}} of {{Social Networks}}},
	date = {2021-01-14},
