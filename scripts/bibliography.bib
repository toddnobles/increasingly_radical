@article{albaRethinkingAssimilationTheory1997,
	abstract = {Assimilation theory has been subject to intensive critique for decades. Yet no other framework has provided the social science community with as deep a corpus of cumulative findings concerning the incorporation of immigrants and their descendants. We argue that assimilation theory has not lost its utility for the study of contemporary immigration to the United States. In making our case, we review critically the canonical account of assimilation provided by Milton Gordon and others; we refer to Shibutani and Kwan's theory of ethnic stratification to suggest some directions to take in reformulating assimilation theory. We also examine some of the arguments frequently made to distinguish between the earlier mass immigration of Europeans and the immigration of the contemporary era and find them to be inconclusive. Finally, we sift through some of the evidence about the socioeconomic and residential assimilation of recent immigrant groups. Though the record is clearly mixed, we find evidence consistent with the view that assimilation is taking place, albeit unevenly.},
	author = {Alba, Richard and Nee, Victor},
	date = {1997},
	doi = {10.2307/2547416},
	eprint = {2547416},
	eprinttype = {jstor},
	file = {Alba_Nee_1997_Rethinking Assimilation Theory for a New Era of Immigration.pdf},
	issn = {0197-9183},
	journaltitle = {The International Migration Review},
	note = {\textbf{Extracted Annotations (1/3/2022, 1:52:18 PM)} \par "Assimilation theory has been subject to i" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=2}{Alba and Nee 1997:827}) \par "Assimilation theory has been subject to intensive critique for decade" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=2}{Alba and Nee 1997:827}) \par "Europeans and the immigration of th" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=2}{Alba and Nee 1997:827}) \par "guments frequently made to distinguish between the earli? er mass immigration of Europeans and the imm" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=2}{Alba and Nee 1997:827}) \par "nd find them to be inconclusive. Finally, we s" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=2}{Alba and Nee 1997:827}) \par "rch. Although Gordon conceived of even dimensions in all, the critical distinction in his conceptual scheme lay which he meant the entry of members of an ethnic minority into primaryroup relationships with the majority group. This distinction, and its empha? is in particular on the character of an individual's primary-group affiliations, uggests one of the limitations of Gordon's scheme, namely, that it is orient? d to a microsociological account of assimilation not conceptually integrated o larger social processes (e.g., the dynamics of ethnic boundaries, Barth, 1956). Nevertheless, Gordons conceptual scheme proved to be useful to on ssimilation and ethnic change." (\href{zotero://open-pdf/library/items/C6BVHMGL?page=5}{Alba and Nee 1997:830}) \par "Another limitation of Gordon's account was that it conceived of assimila? tion within a two-group framework of analysis (the "Sylvanians" and "Mundovians") and thus did not take account of the multigroup nature of American society." (\href{zotero://open-pdf/library/items/C6BVHMGL?page=6}{Alba and Nee 1997:831}) \par ". Although Gordon left little oubt that, in his view, acculturation was inevitable to a large degree, he did not see structural assimilation as similarly foreordained. His analysis ofan ultural pluralism was the more accurate description. He envisioned thens nd social networks most individuals spend the major portions of their social ives, literally from cradle to grave in many cases (Gordon, 1964:159)." (\href{zotero://open-pdf/library/items/C6BVHMGL?page=8}{Alba and Nee 1997:833}) \par "ven when extended as above, Gordon's analysis, the touchstone for all sub? equent studies of assimilation, remains limited. Most important, it lacks a pecification of the causal mechanisms giving rise to assimilation." (\href{zotero://open-pdf/library/items/C6BVHMGL?page=13}{Alba and Nee 1997:838}) \par "The causal mechanisms that bring about the reduction of social distance tem from changes in "life conditions" that occur at the ecological level. In he absence of such changes, ethnic stratification orders tend towards stable quilibrium. In explaining the transformation of such orders, Shibutani and which in turn induces alterations in the mode of production. As an illustra? ion, they cite the invention of the automatic cotton picker, which dimin? shed the demand for cheap labor in the south and sparked the migration of oor blacks and whites to the industrial north, altering the pattern of racial tratification throughout the United States. C" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=15}{Alba and Nee 1997:840}) \par "Systems of ethnic stratification begin to break down when minority peoples devel? op new self-conceptions and refuse to accept subordinate roles. As they become more aware of their worth in comparison to members of the dominant group, what they had once accepted as natural becomes unbearable. (Shibutani and Kwan, 1965:350)" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=16}{Alba and Nee 1997:841}) \par "aising the prospect of a future decline in the general level of immigration s admittedly speculative. We are on firmer ground, we believe, in predicting hat the immigration of some groups will decline and will not live up to theer words, will hold selectively, not uniformly. One reason for suspecting such eclines is that the level of economic development of some sending nationsa rincipal motive for immigration. This has happened in the case of Japan, which sent many immigrants around the turn of the century, but currently is he source for few immigrants, other than managers in Japanese companies ases of Korea and Taiwan. Indeed, there are signs of an incipient decline in isas allocated to Koreans fell by 60 percent while the number returning bates, the prediction of ethnic communities continually revitalized by new" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=20}{Alba and Nee 1997:845}) \par "rom the standpoint of spatial-assimilation theory, the most intriguing eature of the residential patterns of new immigrants is frequent settlement in uburbs immediately upon, or soon after, arrival in the United States (Alba nd Logan, 1991; Alba etal, 1997; Waldinger, 1989). This hallmark of the new immigration presents a remarkable contrast to the process of spatial ssimilation as experienced by earlier, European immigrant groups, whose d as individuals and families to the suburbs, typically after spending a gen? ration or more in citie" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=37}{Alba and Nee 1997:862}) \par "he evidence on residential patterns exhibits a contradictory quality that s probably inevitable at an early stage in the unfolding of the consequences f large-scale immigration. Immigrant groups are rather strongly concentrat? d in a small number of metropolitan regions, which continue to receive the ulk of the immigration stream. Within these regions, these groups are not trongly segregated from the majority population, and their exposure to nonispanic whites through their neighborhoods increases rather predictably with improvements in English-language proficiency, income, education, and with the purchase of a home or movement to the suburb" (\href{zotero://open-pdf/library/items/C6BVHMGL?page=38}{Alba and Nee 1997:863})},
	number = {4},
