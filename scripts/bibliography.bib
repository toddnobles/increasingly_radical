@article{clarkeBiomedicalizationTechnoscientificTransformations2003,
	abstract = {The first social transformation of American medicine institutionally established medicine by the end of World War II. In the next decades, medicalization-the expansion of medical jurisdiction, authority, and practices into new realms-became widespread. Since about 1985, dramatic changes in both the organization and practices of contemporary biomedicine, implemented largely through the integration of technoscientific innovations, have been coalescing into what the authors call biomedicalization, a second transformation of American medicine. Biomedicalization describes the increasingly complex, multisited, multidirectional processes of medicalization, both extended and reconstituted through the new social forms of highly technoscientific biomedicine. The historical shift from medicalization to biomedicalization is one from control over biomedical phenomena to transformations of them. Five key interactive processes both engender biomedicalization and are produced through it: (1) the political economic reconstitution of the vast sector of biomedicine; (2) the focus on health itself and the elaboration of risk and surveillance biomedicines; (3) the increasingly technological and scientific nature of biomedicine; (4) transformations in how biomedical knowledges are produced, distributed, and consumed, and in medical information management; and (5) transformations of bodies to include new properties and the production of new individual and collective technoscientific identities.},
	annotation = {1057 citations (Crossref) [2023-05-16]\\ MAG ID: 2107078676},
	author = {Clarke, Adele E. and Clarke, Adele E. and Shim, Janet K. and Mamo, Laura and Fosket, Jennifer Ruth and Fishman, Jennifer R.},
	date = {2003-04-01},
	doi = {10.2307/1519765},
	journaltitle = {American Sociological Review},
	keywords = {/unread},
	number = {2},
	pages = {161--194},
	title = {Biomedicalization: {{Technoscientific}} Transformations of Health, Illness, and {{U}}.{{S}}. Biomedicine.},
	volume = {68},
	bdsk-url-1 = {https://doi.org/10.2307/1519765}}

@article{clarkePartySubBrandsAmerican2020,
	abstract = {Scholars and pundits have long noted the dominance of the American two-party system, but we know relatively little about new, endogenous institutions that have emerged within the two major parties. I argue that ideological factions provide party sub-brands, which allow legislators to more precisely define their partisan type and capture faction-specific resources. To support this claim, I analyze new data on nine ideological factions in the House of Representatives (1995--2018). I find that (1) faction voting is distinct, suggesting a product ripe for party sub-branding, and (2) joining a faction changes the ideological composition of a candidate's donor base---conditional on the strength of the faction's institutions. Party sub-branding is effective only when factions possess organizational features that induce coordinated and disciplined position taking (e.g., whips, PACs, membership restrictions). These results suggest that, even within highly polarized parties, American political ideology is more than a dichotomous choice, and factions target niche markets of political donors as a means of blunting financial instruments of party power.},
	annotation = {19 citations (Crossref) [2024-05-04]},
	author = {Clarke, Andrew J.},
	date = {2020},
	doi = {10.1111/ajps.12504},
	file = {Clarke_2020_Party Sub-Brands and American Party Factions.pdf;../../../Zotero/storage/C4LDF93F/ajps.html},
	issn = {1540-5907},
	journaltitle = {American Journal of Political Science},
	langid = {english},
	number = {3},
	pages = {452--470},
	title = {Party {{Sub-Brands}} and {{American Party Factions}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12504},
	urldate = {2021-12-15},
	volume = {64},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12504},
	bdsk-url-2 = {https://doi.org/10.1111/ajps.12504}}

@article{clarkGeneralAgeSpecificMortality2019,
	abstract = {The majority of countries in Africa and nearly one-third of all countries require mortality models to infer the complete age schedules of mortality that are required to conduct population estimates, projections/forecasts, and other tasks in demography and epidemiology. Models that relate child mortality to mortality at other ages are important because almost all countries have measures of child mortality. A general, parameterizable component model (SVD-Comp) of mortality is defined using the singular value decomposition and calibrated to the relationship between child or child/adult mortality and mortality at other ages in the observed mortality schedules of the Human Mortality Database. Cross-validation is used to validate the model, and the predictive performance of the model is compared with that of the log-quadratic (Log-Quad) model, which is designed to do the same thing. Prediction and cross-validation tests indicate that the child mortality--calibrated SVD-Comp is able to accurately represent the observed mortality schedules in the Human Mortality Database, is robust to the selection of mortality schedules used for calibration, and performs better than the Log-Quad model. The child mortality--calibrated SVD-Comp can be used where and when child mortality is available but mortality at other ages is unknown.},
	author = {Clark, Samuel J.},
	date = {2019-05-28},
	doi = {10.1007/s13524-019-00785-3},
	file = {Clark_2019_A General Age-Specific Mortality Model With an Example Indexed by Child1131-1159.pdf},
	issn = {0070-3370},
	journaltitle = {Demography},
	number = {3},
	pages = {1131--1159},
	shortjournal = {Demography},
	title = {A {{General Age-Specific Mortality Model With}} an {{Example Indexed}} by {{Child Mortality}} or {{Both Child}} and {{Adult Mortality}}},
	url = {https://doi.org/10.1007/s13524-019-00785-3},
	urldate = {2024-04-09},
	volume = {56},
	bdsk-url-1 = {https://doi.org/10.1007/s13524-019-00785-3}}

@article{clarkLegitimacyExtraordinaryGrowth2023,
	abstract = {ESG metrics are increasingly important in the global investment management industry. Why this came to pass given the limited appetite for responsible investing in the industry is the subject of this paper. Although the business case for ESG provides an explanation for its increasing uptake whereby market actors are increasingly convinced of the merits of ESG as a profit centre, this explanation is insufficient. By contrast, the adoption the ESG programme offers a means of rewriting the terms of risk management and value creation that while grounded in the business case also serve to address challenges to the legitimacy of the global asset management industry. These developments are illustrated in a case study of the establishment and growth of TruCost and its purchase by S\&P Global in 2016.},
	author = {Clark, Gordon L and Dixon, Adam D},
	date = {2023-02-28},
	doi = {10.1177/0308518X231155484},
	file = {Clark_Dixon_2023_Legitimacy and the extraordinary growth of ESG measures and metrics in the0308518X231155484.pdf},
	issn = {0308-518X},
