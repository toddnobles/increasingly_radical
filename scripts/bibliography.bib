	shorttitle = {The Effect of Feedback on Support for a Sanctioning System in a Social Dilemma},
	title = {The Effect of Feedback on Support for a Sanctioning System in a Social Dilemma: {{The}} Difference between Installing and Maintaining the Sanction},
