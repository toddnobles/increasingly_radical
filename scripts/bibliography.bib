	pages = {7--26},
	publisher = {GESIS - Leibniz Institute for the Social Sciences},
	shorttitle = {Introduction},
	title = {Introduction: {{The Sociology}} of {{Quantification}} - {{Perspectives}} on an {{Emerging Field}} in the {{Social Sciences}}},
	url = {https://www.jstor.org/stable/43798480},
