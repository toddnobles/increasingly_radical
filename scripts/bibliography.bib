	pages = {168--185},
	shorttitle = {Lawlessness and Economic Governance},
	title = {Lawlessness and Economic Governance: The Case of {\mkbibemph{Hawala}} System in {{Somalia}}},
	url = {https://www.emerald.com/insight/content/doi/10.1108/14468950710843415/full/html},
	urldate = {2022-11-15},
