	publisher = {The University of Chicago Press},
	shorttitle = {Rethinking the {{Risks}} of {{Poverty}}},
	title = {Rethinking the {{Risks}} of {{Poverty}}: {{A Framework}} for {{Analyzing Prevalences}} and {{Penalties}}},
	url = {https://www.journals.uchicago.edu/doi/10.1086/693678},
