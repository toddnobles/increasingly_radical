@article{childReviewSympatheticConsumer2022,
	abstract = {In The Sympathetic Consumer, Tad Skotnicki tells us two stories. One is about moments in history when consumer activists organized and campaigned for causes they cared about. In the late 18th century, abolitionists in Britain encouraged consumers to abstain from slave-produced sugar and rum. They wanted to disrupt the demand for these goods, which would in turn interfere with the high demand for enslaved labor. At the turn of the 20th century, consumer activists took aim at exploitative working conditions and unfair trading practices by creating a league of conscious consumers in the US and supporting the co-operative movement in Britain.},
