	journaltitle = {Annual Review of Sociology},
	langid = {english},
	number = {1},
	pages = {105--128},
	shortjournal = {Annu. Rev. Sociol.},
	title = {The {{Sociology}} of {{Markets}}},
	url = {https://www.annualreviews.org/doi/10.1146/annurev.soc.33.040406.131736},
	urldate = {2023-04-12},
	volume = {33},
	bdsk-url-1 = {https://www.annualreviews.org/doi/10.1146/annurev.soc.33.040406.131736},
	bdsk-url-2 = {https://doi.org/10.1146/annurev.soc.33.040406.131736}}

