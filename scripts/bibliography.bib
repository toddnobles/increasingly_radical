	pages = {143--163},
	shortjournal = {Polit Behav},
	shorttitle = {Decoding {{Prejudice Toward Hispanics}}},
	title = {Decoding {{Prejudice Toward Hispanics}}: {{Group Cues}} and {{Public Reactions}} to {{Threatening Immigrant Behavior}}},
	url = {https://doi.org/10.1007/s11109-013-9231-7},
	urldate = {2022-03-10},
