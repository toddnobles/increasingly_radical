	bdsk-url-2 = {https://doi.org/10.1515/for-2017-0030}}

@article{dietzClimateChangeSociety2020,
	abstract = {Climate change is one of the greatest ecological and social challenges of the twenty-first century. Sociologists have made important contributions to our knowledge of the human drivers of contemporary climate change, including better understanding of the effects of social structure and political economy on national greenhouse gas emissions, the interplay of power and politics in the corporate sector and in policy systems, and the factors that influence individual actions by citizens and consumers. Sociology is also poised to make important contributions to the study of climate justice across multiple lines of stratification, including race, class, gender, indigenous identity, sexuality and queerness, and disability, and to articulate the effects of climate change on our relationship to nonhuman species. To realize its potential to contribute to the societal discourse on climate change, sociology must become theoretically integrated, engage with other disciplines, and remain concerned with issues related to environmental and climate inequalities.},
	author = {Dietz, Thomas and Shwom, Rachael L. and Whitley, Cameron T.},
	date = {2020-07-30},
	doi = {10.1146/annurev-soc-121919-054614},
	file = {Dietz et al_2020_Climate Change and Society135-158.pdf;../../../Zotero/storage/JJV7ZVCH/annurev-soc-121919-054614.html},
	issn = {0360-0572, 1545-2115},
	issue = {Volume 46, 2020},
	journaltitle = {Annual Review of Sociology},
	keywords = {/unread},
	langid = {english},
	pages = {135--158},
	publisher = {Annual Reviews},
	title = {Climate {{Change}} and {{Society}}},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-soc-121919-054614},
	urldate = {2024-04-10},
	volume = {46},
	bdsk-url-1 = {https://www.annualreviews.org/content/journals/10.1146/annurev-soc-121919-054614},
	bdsk-url-2 = {https://doi.org/10.1146/annurev-soc-121919-054614}}

