	pmcid = {PMC7301291},
	shortjournal = {Health Educ Behav},
	shorttitle = {Racial {{Capitalism}}},
	title = {Racial {{Capitalism}}: {{A Fundamental Cause}} of {{Novel Coronavirus}} ({{COVID-19}}) {{Pandemic Inequities}} in the {{United States}}},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7301291/},
