@article{asadIndigenousPlacesMaking2019,
	abstract = {The uneven distribution of economic and social resources across communities often falls along ethno-racial dimensions. Few demographers have considered whether such axes of place stratification in a migrant-sending country relate to individuals' access to economic and social resources in a migrant-receiving country. Taking Mexico-US migration flows as our focus, we examine if having origins in an indigenous place, a primary axis of stratification in Mexico, is associated with migrants' documentation status when crossing the border, a primary dimension of stratification in the United States. We rely on individual-level data from the Mexican Migration Project merged with municipal-level data from the Mexican Census. Using multilevel models, we find that migrants from communities in indigenous municipalities in Mexico are more likely to migrate undocumented than documented to the United States compared with those from communities in non-indigenous municipalities, net of the economic and social resources identified in prior work as useful for international movement. We discuss why indigenous places --- marked by a set of correlated conditions of economic and social disadvantage --- disproportionately channel migrants into an undocumented status. This study contributes to understandings of stratification processes in cross-border contexts and has implications for the production of inequality in the United States.},
	author = {Asad, Asad L. and Hwang, Jackelyn},
	date = {2019-12-01},
	doi = {10.1177/0197918318801059},
	file = {Asad_Hwang_2019_Indigenous Places and the Making of Undocumented Status in Mexico-US Migration.pdf},
	issn = {0197-9183},
	journaltitle = {International Migration Review},
	keywords = {soc 590 migration week 4},
	langid = {english},
	note = {\textbf{Extracted Annotations (1/23/2022, 10:30:26 PM)} \par "Taking Mexico-US migration flows as our focus, we examine if having origins in an indigenous place, a primary axis of stratification in Mexico, is associated with migrants' documentation status when crossing the border, a primary dimension of stratification in the United States. We rely on individuallevel data from the Mexican Migration Project merged with municipal-level data from the Mexican Census. Using multilevel models, we find that migrants from communities in indigenous municipalities in Mexico are more likely to migrate undocumented than documented to the United States compared with those from communities in nonindigenous municipalities, net of the economic and social resources identified in prior work as useful for international movement" (\href{zotero://open-pdf/library/items/NN4DY72H?page=1}{Asad and Hwang 2019:1032}) \par "We test this claim with the Mexican Migration Project (MMP) --- a large-scale dataset of migrants and non-migrants across 143 communities in Mexico --- and municipal-level data from the Mexican Census. Using multilevel models, we find that the context of indigeneity is a significant sorting mechanism of migrants' documentation status, net of conventional microand macrolevel indicators of economic and social resources." (\href{zotero://open-pdf/library/items/NN4DY72H?page=2}{Asad and Hwang 2019:1033}) \par "Differences in documentation may thus stem from a networked process: those lacking family members with domestic or US migration experience may be more likely to migrate undocumented than those with such ties." (\href{zotero://open-pdf/library/items/NN4DY72H?page=4}{Asad and Hwang 2019:1035}) \par "The smaller share of migrants and more limited history of migration from indigenous areas, coupled with this stream's mobilization during an era of slower economic development and restrictive immigration policy, may make undocumented relative to documented migration more likely when compared with individuals from non-indigenous communities." (\href{zotero://open-pdf/library/items/NN4DY72H?page=9}{Asad and Hwang 2019:1040}) \par "Between 1982 and 2013, the MMP surveyed 143 communities in 24 of the 32 Mexican states during the winter months, when many US migrants return home to visit their families. Each community is located within a municipality, which is roughly equivalent to a US county. In some cases, one or two communities within the same municipality were surveyed. Some communities are villages or towns in small municipalities, while others are neighborhoods in mid-sized and large urban municipalities. Municipalities each have their own governing body over public services and had an average population in 2010 of about 41,000 residents.8" (\href{zotero://open-pdf/library/items/NN4DY72H?page=9}{Asad and Hwang 2019:1040}) \par "Our primary independent variable is a categorical indicator of the proportion of people who speak an indigenous language in individuals' municipality of residence." (\href{zotero://open-pdf/library/items/NN4DY72H?page=12}{Asad and Hwang 2019:1043}) \par "We also find that migrants working in the second (i.e., manufacturing) and third (i.e., transportation) occupational sectors have higher odds of migrating undocumented compared with those in the first (i.e., agricultural) sector. Despite these differences, documented migration is associated with social class, individual networks, and community migration histories, even when we consider individuals who decide not to migrate. Most importantly, the context of indigeneity remains an important predictor of documentation status, net of these other factors. Further, when we compare our results with a model that excludes the indigeneity variables, we find that over 5 percent of additional variation in documentation status between communities is unexplained." (\href{zotero://open-pdf/library/items/NN4DY72H?page=32}{Asad and Hwang 2019:1063}) \par "Second, migrants born in highbut surveyed in low-indigenous municipalities were less likely to migrate undocumented than did those born and surveyed in high-indigenous municipalities; the reverse was true for migrants born in lowbut surveyed in high-indigenous municipalities. Finally, the association between indigeneity and undocumented migration is significantly weaker in fully adjusted models when we measure indigeneity based on individuals' birth rather than survey place" (\href{zotero://open-pdf/library/items/NN4DY72H?page=34}{Asad and Hwang 2019:1065}) \par \mkbibemph{couldn this first difference just be capturing the economic factors of people who were born in indigenous areas but made it out to more prosperous areas that for. variety of reasons were less indigenous? (\href{zotero://open-pdf/library/items/NN4DY72H?page=34}{note on p.1065})}},
	number = {4},
	pages = {1032--1077},
	publisher = {SAGE Publications Inc},
	shortjournal = {International Migration Review},
	title = {Indigenous {{Places}} and the {{Making}} of {{Undocumented Status}} in {{Mexico-US Migration}}},
	url = {https://doi.org/10.1177/0197918318801059},
	urldate = {2022-01-20},
	volume = {53},
	bdsk-url-1 = {https://doi.org/10.1177/0197918318801059}}

@article{asadRacializedLegalStatus2018,
	abstract = {This article advances the concept of racialized legal status (RLS) as an overlooked dimension of social stratification with implications for racial/ethnic health disparities. We define RLS as a social position based on an ostensibly race-neutral legal classification that disproportionately impacts racial/ethnic minorities. To illustrate the implications of RLS for health and health disparities in the United States, we spotlight existing research on two cases: criminal status and immigration status. We offer a conceptual framework that outlines how RLS shapes disparities through (1) primary effects on those who hold a legal status and (2) spillover effects on racial/ethnic in-group members, regardless of these individuals' own legal status. Primary effects of RLS operate by marking an individual for material and symbolic exclusion. Spillover effects result from the vicarious experiences of those with social proximity to marked individuals, as well as the discredited meanings that RLS constructs around racial/ethnic group members. We conclude by suggesting multiple avenues for future research that considers RLS as a mechanism of social inequality with fundamental effects on health.},
	author = {Asad, Asad L. and Clair, Matthew},
	date = {2018-02},
	doi = {10.1016/j.socscimed.2017.03.010},
	file = {Asad_Clair_2018_Racialized legal status as a social determinant of health2.pdf},
	issn = {02779536},
	journaltitle = {Social Science \& Medicine},
	keywords = {soc 590 migration week 4},
	langid = {english},
	pages = {19--28},
	shortjournal = {Social Science \& Medicine},
	title = {Racialized Legal Status as a Social Determinant of Health},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0277953617301508},
	urldate = {2022-01-20},
	volume = {199},
	bdsk-url-1 = {https://linkinghub.elsevier.com/retrieve/pii/S0277953617301508},
	bdsk-url-2 = {https://doi.org/10.1016/j.socscimed.2017.03.010}}

@article{ashendenGuiltIntroduction2014,
	annotation = {0 citations (Crossref) [2022-06-07]},
	author = {Ashenden, Samantha and Brown, James},
	date = {2014-01-02},
	doi = {10.1080/03085147.2014.893076},
	file = {Ashenden_Brown_2014_Guilt1-18.pdf},
	issn = {0308-5147, 1469-5766},
	journaltitle = {Economy and Society},
	keywords = {guilt actually used,guilt reviewed,reviewed},
	langid = {english},
	note = {\section{Annotations\\ (6/3/2022, 3:00:48 PM)} \par ``Guilt and shame are especially tricky. Ruth Benedict's well known distinction between shame and guilt cultures, identifying the former as an essentially social relation, a matter of losing face that is felt only if the cause of shame is witnessed by others, while guilt is a matter of one's judgement upon oneself, is by no means the only way of distinguishing these terms (Benedict, 1946; see Osborne in this collection for an alternative; see also Leys, 2009).'' (Ashenden and Brown, 2014, p. 1) \par ``. But at the same time, guilt cannot be only a legal concept, for the reasons Osborne explores in discussing Gabriele Taylor, whose example of Macbeth Osborne takes up to identify the ways in which guilt might prompt a refashioning of the self to accommodate it (horrified by his bloody crimes, Macbeth deals with them by redefining himself as a bloody criminal), or an overwhelming of the self (unable to live with her crimes, Lady Macbeth goes mad)'' (Ashenden and Brown, 2014, p. 7) \par ``Looked at this way, to reconstruct the implicit logic of liberal individualism and law in Kantian terms is from the first to concede the possibility of universal guilt, in that we are all, by virtue of our material insertion in the world, liable to will partially in our own favour. Indeed, in that ethical subjects, in the nature of things, come inextricably tied to agents whose acts are necessarily particular and in some degree egotistically motivated, the risk might seem high, and the categorical imperative to be so high-minded a test that one is doomed to fail it (or so abstract as to allow almost anything).'' (Ashenden and Brown, 2014, p. 8) \par ``art of Ashenden's discussion may be summarized by saying that it starts from one way (a Kantian one) of accounting for the constitution of the individual, and proceeds from there to probe the constitution of political community, and thus of the state, registering as it goes the implications of different ways of constituting an agent (individual or collective) for an understanding of guilt. If one assumes that the individual is in some sense prior to the state, then one will assume that guilt is inherently individual. But if the individual is produced by social and political processes, then so too might be the practices that endorse and naturalize an individual conception of guilt.'' (Ashenden and Brown, 2014, p. 9)},
	number = {1},
	pages = {1--18},
	shortjournal = {Economy and Society},
	shorttitle = {Guilt},
	title = {Guilt: Introduction},
	url = {https://www.tandfonline.com/doi/full/10.1080/03085147.2014.893076},
	urldate = {2022-06-03},
	volume = {43},
	bdsk-url-1 = {https://www.tandfonline.com/doi/full/10.1080/03085147.2014.893076},
	bdsk-url-2 = {https://doi.org/10.1080/03085147.2014.893076}}

@article{assaImputingAwayLadder2021,
	abstract = {What are the implications of changes in measurement standards of GDP for global convergence debates? What are the political economy implications? To answer the former question, we examine the changes in national accounting standards from the early 1990s. Revisions to the System of National Accounts (SNA) -- the international standard for constructing GDP -- include several major changes to how production is measured, including the reclassification of financial intermediation services, R\&D, and weapons systems as productive activities -- all areas in which countries in the West has had an advantage in recent decades. In addition, there has been an increase in the proportion of imputations in the 1993 and 2008 revisions, which privileges the economic structures of the West. Overall, we find that these changes have had the effect of boosting the GDP of the West relative to the rest of the world and thus to an underestimation of global convergence compared to previous measures of GDP. To answer the second question, the paper unpacks the political economy implications of national accounting standards favouring Western economies along several axes, including the impacts on voting shares in international institutions, domestic policy incentives and epistemological debates about sustainable development.},
	author = {Assa, Jacob and Kvangraven, Ingrid Harvold},
	date = {2021-11-02},
	doi = {10.1080/13563467.2020.1865899},
	file = {Assa_Kvangraven_2021_Imputing Away the Ladder985-1014.pdf},
	issn = {1356-3467},
	journaltitle = {New Political Economy},
	keywords = {/unread,convergence,Economic statistics,GDP,global growth,Rise of the South},
	number = {6},
	pages = {985--1014},
	publisher = {Routledge},
	shorttitle = {Imputing {{Away}} the {{Ladder}}},
	title = {Imputing {{Away}} the {{Ladder}}: {{Implications}} of {{Changes}} in {{GDP Measurement}} for {{Convergence Debates}} and the {{Political Economy}} of {{Development}}},
	url = {https://doi.org/10.1080/13563467.2020.1865899},
	urldate = {2023-09-12},
	volume = {26},
	bdsk-url-1 = {https://doi.org/10.1080/13563467.2020.1865899}}

@article{augusteDemocratizingEconomyIntroducing2023,
	abstract = {Though the growth of the gig economy has coincided with increased economic precarity in the new economy, we know less about the extent to which gig work (compared with other self-employment arrangements and non-gig work) may fuel economic insecurity among American households. We fill this gap in the literature by drawing on a sample of 4,756 workers from a unique national survey capturing economic hardships among non-standard workers like app- and platform-based gig and other self-employed workers during the COVID-19 pandemic. Results from generalized boosted regression modeling, utilizing machine learning to account for potential endogeneity, demonstrated that gig workers experienced significantly greater economic hardship than non-gig and other self-employed workers during the pandemic. For example, gig workers were more likely to experience food insecurity, miss bill payments, and suffer income loss compared with non-gig and other self-employed workers during the pandemic. While household liquid assets endowment prior to the pandemic reduced the effect of gig work on experiencing economic hardships, having dependent children in the household increased this effect. Thus, contrary to democratizing entrepreneurship opportunities, these findings suggest that the expansion of the gig economy may exacerbate labor market inequality, where wealth-endowed families are protected against adverse economic consequences of the gig economy. We discuss the implications of these findings for inequality-reducing labor market policies, including policies that account for the interconnectedness of family and the labor market.},
	author = {Auguste, Daniel and Roll, Stephen and Despard, Mathieu},
	date = {2023-09-20},
	doi = {10.1177/07308884231202032},
	file = {Auguste et al_2023_Democratizing the Economy or Introducing Economic Risk07308884231202032.pdf},
	issn = {0730-8884},
	journaltitle = {Work and Occupations},
	langid = {english},
	pages = {07308884231202032},
	publisher = {SAGE Publications Inc},
	shorttitle = {Democratizing the {{Economy}} or {{Introducing Economic Risk}}?},
	title = {Democratizing the {{Economy}} or {{Introducing Economic Risk}}? {{Gig Work During}} the {{COVID-19 Pandemic}}},
	url = {https://doi.org/10.1177/07308884231202032},
	urldate = {2023-09-25},
	bdsk-url-1 = {https://doi.org/10.1177/07308884231202032}}

@article{augusteIncomeInequalityGlobalization2018,
	abstract = {The debate regarding the welfare state---weakening effect and the income inequality-increasing effect of globalization remains a contentious issue among stratification scholars. For some, globalization increases income inequality, while for others, globalization has no, or a negligible, effect on income inequality. This study brings new evidence to bear on this debate by separately investigating effects of multiple indicators of globalization (international trade, foreign direct investment [FDI] and immigration), and of welfare state generosity (government social-protection spending) on (1) income inequality before taxes and transfers and (2) income inequality after taxes and transfers, using data from 23 Organisation for Economic Co-operation and Development (OECD) countries over 1990--2009. First, results show a positive effect of international trade, a negative effect of immigration, but no effect of FDI and government social-protection spending on income inequality before taxes and transfers. Second, results show no effect of the globalization indicators but a negative effect of government social-protection spending on income inequality after taxes and transfers. These findings suggest that (1) globalization has inequality-increasing effects depending on measures of income inequality; (2) the welfare state, in many OECD countries, continues to shape income distribution; and (3) in contrast with the popular narrative, immigration may decrease income inequality.},
	author = {Auguste, Daniel},
	date = {2018},
	eprint = {26625944},
	eprinttype = {jstor},
	file = {Auguste_2018_Income Inequality, Globalization, and the Welfare State666-689.pdf},
	issn = {0884-8971},
	journaltitle = {Sociological Forum},
	keywords = {/unread},
	number = {3},
	pages = {666--689},
	publisher = {[Wiley, Springer]},
	shorttitle = {Income {{Inequality}}, {{Globalization}}, and the {{Welfare State}}},
	title = {Income {{Inequality}}, {{Globalization}}, and the {{Welfare State}}: {{Evidence}} from 23 {{Industrial Countries}}, 1990--2009},
	url = {https://www.jstor.org/stable/26625944},
	urldate = {2023-01-13},
	volume = {33},
	bdsk-url-1 = {https://www.jstor.org/stable/26625944}}

@article{augustePrecaritySelfEmploymentLow2023,
	abstract = {Abstract             Many people in the United States have achieved economic stability through self-employment and are often seen as embracing the entrepreneurial spirit and seizing opportunity. Yet, research also suggests that self-employment may be precarious for many people in the lower socioeconomic strata. Drawing on a unique dataset that combines longitudinal survey data with administrative tax data for a sample of low- and moderate-income (LMI) workers, we bring new evidence to bear on this debate by examining the link between self-employment and economic insecurity. Overall, our results show that self-employment is associated with greater economic insecurity among LMI workers compared with wage-and-salary employment. For instance, compared with their wage-and-salary counterparts, the self-employed have 78, 168, and 287 percent greater odds of having an income below basic expenses, and experiencing an unexpected income decline and high levels of income volatility, respectively. We also find that differences in financial endowment and access to health insurance are key drivers in explaining the relationship between employment type and economic insecurity, as being able to access \$2,000 in an emergency greatly lowers the odds of budgetary constraint, whereas lack of health insurance increases those odds. These findings suggest that formal work arrangements with wages and benefits offered by an employer promotes greater economic stability among LMI workers compared with informal work arrangements via self-employment. We discuss implications of these results for future research and policy initiatives seeking to promote economic wellbeing through entrepreneurship.},
	annotation = {1 citations (Crossref) [2023-06-08]},
	author = {Auguste, Daniel and Roll, Stephen and Despard, Mathieu},
	date = {2023-01-13},
	doi = {10.1093/sf/soab171},
	file = {Auguste et al_2022_The Precarity of Self-Employment among Low- and Moderate-Income Householdssoab171.pdf;Auguste et al_2023_The Precarity of Self-Employment among Low- and Moderate-Income Households1081-1115.pdf},
	issn = {0037-7732, 1534-7605},
	journaltitle = {Social Forces},
	langid = {english},
	note = {\section{Annotations\\ (6/8/2023, 11:10:59 AM)} \par ``As of May 2020, there were fifteen million incorporated and unincorporated self-employed workers in the United States, representing 11 percent of all workers (United States Bureau of Labor Statistics, 2020).'' (Auguste et al., 2023, p. 1082) \par ``Our study fills this gap in previous research by descriptively examining the extent to which self-employment, compared with wage-and-salary employment, relates to self-reported economic insecurity, including indicators for budgetary constraint (e.g., difficulty managing expenses and having incomes below expenses) and income volatility (e.g., job/income loss and large income fluctuations), among a large sample of LMI workers.'' (Auguste et al., 2023, p. 1082) \par ``Hypothesis 1: Among low-and moderate-income workers, the self-employed are more likely to experience budgetary constraints compared with their wageand-salary counterparts. Hypothesis 2: Among low-and moderate-income workers, the self-employed are more likely to experience income volatility compared with their wage-andsalary counterparts.'' (Auguste et al., 2023, p. 1088) \par ``Household Financial Survey (HFS) at two points in time: immediately after they file their taxes (HFS1) and six months post-filing (HFS2). To qualify for this free tax filing'' (Auguste et al., 2023, p. 1088) \par ``The dependent variables in this study include two indicators for budgetary constraint and four indicators for income volatility. The budgetary constraint indicators are self-reported and capture a household's perceived difficulty in managing their expenses and whether their income was less than their expenses. To measure perceived difficulty in managing expenses, respondents were asked ``in a typical month, how difficult is it for you to cover your expenses and pay all your bills?'' Responses were coded as 1 if respondents reported that this was ``very difficult'' or ``somewhat difficult,'' and were coded as 0 if respondents reported that this was ``not at all difficult.'' To measure whether their income was less than their expenses, respondents were asked ``which of the following comes closest to your household's situation in the last six months?'' Response'' (Auguste et al., 2023, p. 1089) \par ``options ranged from ``Spent a lot more than you made'' to ``Made a lot more than you spent.'' Responses were coded as 1 if they reported spending a lot more than they earned, and 0 otherwise.'' (Auguste et al., 2023, p. 1090) \par ``he employment status variable therefore had four categories: full-time wage-and-salary employment, part-time wage-and-salary employment, full-time self-employment, and part-time self-employment. This measure was collected at HFS1, immediately after-tax filing.'' (Auguste et al., 2023, p. 1090) \par ``The unit of analysis in this study is the tax household, and 98.7 percent of respondents are the tax filer themselves.'' (Auguste et al., 2023, p. 1092) \par ``Notably, the key independent variable in this study, employment status, is also measured at the respondent level. That is, we measure the relationship between a respondent identifying as self-employed and their household outcomes, in essence using a respondent's self-employment status as a proxy for the household's self-employment.'' (Auguste et al., 2023, p. 1093) \par ``We ensure this approach is not biasing our results in two ways: First, by re-estimating the models in the main analysis using a binary household-level indicator for any self-employment in the household, and second, by re-estimating the main analytic models while controlling for the spouse or partner's employment status. Supplementary material, Appendix D presents the results of both these models, and shows that accounting for the spouse/partner's employment status does not notably change the results of the estimates in the main analysis.'' (Auguste et al., 2023, p. 1093) Isn't this surprising? Shouldn't we expect differences in security between some households that have one wage and salaried to be less secure than those with two? \par ``More specifically, we hypothesized that, when compared with wage-andsalary employment, self-employment would be associated with greater economic instability among LMI households. We find partial support for Hypothesis 1 regarding the perceived budgetary constraints among these households. Selfemployed individuals are more likely to report problems covering their expenses and to have income that falls below expenses. However, these differences disappear for full-time self-employed workers after controlling for demographic factors such as age, race/ethnicity, and education. Yet, the part-time self-employed continue to experience significant budgetary constraint even after accounting for demographic characteristics and a set of household financial characteristics such as being able to access \$2,000 in an emergency and having access to health insurance.'' (Auguste et al., 2023, p. 1104) \par ``We also find support for Hypothesis 2 regarding employment and income volatility. Self-employment compared with full-time wage-and-salary employment predicts income declines, and income volatility after controlling for demographic characteristics, financial factors, and access to health insurance.'' (Auguste et al., 2023, p. 1104) \par ``et, we find that the full-time self-employed are as likely as full-time wage-and-salary workers to experience unexpected job losses, underscoring the generally insecure nature of employment among low socioeconomic status workers.'' (Auguste et al., 2023, p. 1104)},
	number = {3},
	pages = {1081--1115},
	title = {The {{Precarity}} of {{Self-Employment}} among {{Low-}} and {{Moderate-Income Households}}},
