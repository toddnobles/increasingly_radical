	shorttitle = {Toward a {{Global Urban Sociology}}},
	title = {Toward a {{Global Urban Sociology}}: {{Keywords1}}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/cico.12502},
	urldate = {2023-09-06},
