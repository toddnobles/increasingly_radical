	journaltitle = {SOCIOLOGIA DEL LAVORO},
	keywords = {reviewed},
	langid = {english},
	number = {163},
	pages = {51--69},
	title = {Introduction. {{Digital}} Labor and Crisis of the Wage Labor System},
	url = {https://www.medra.org/servlet/MREngine?hdl=10.3280/SL2022-163003oa},
	urldate = {2022-12-11},
