	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	title = {Toward a {{Pluralistic Commonwealth}}},
	url = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0009},
	urldate = {2024-11-27},
	bdsk-url-1 = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0009}}

@incollection{thomasPropertyowningDemocracyMarket2016,
	abstract = {John Rawls argued this conception of justice as fairness could be equally well expressed by one of two social systems: a property-owning democracy or liberal market socialism. This chapter argues that this claim needs to be disambiguated: a property-owning democracy must be implemented first or market socialist schemes will become illiberal over time. The chapter evaluates two form of mandatory market socialism: one in which worker cooperatives lease their capital from the state and one in which workers hold capital as partners in their workplace. Both schemes, it is argued, generate new forms of exploitation compared to either free market capitalism or a property-owning democracy. A property-owning democracy is further compared with John Roemer's coupon socialism as a policy approach in transitional justice and with Robert Hockett's proposal to expand asset-based egalitarianism via state underwritten insurance.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0008},
	editor = {Thomas, Alan},
	isbn = {978-0-19-060211-6},
	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	title = {Property-Owning {{Democracy Versus Market Socialism}}},
	url = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0008},
	urldate = {2024-11-27},
	bdsk-url-1 = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0008}}

@incollection{thomasRawlsRepublicanismLiberalRepublicanism2016,
	abstract = {This chapter sets out the idea of a creative synthesis between the Roman republican and politically liberal traditions. It considers arguments from Philip Pettit that the two traditions are inherently rivalrous, before endorsing Charles Larmore's interpretation that Pettit's ``third'' concept of liberty thematizes distinctions about which political liberals have been silent. It is not, however, inconsistent for liberal-republicanism to take over this conception of liberty for its own ends. It is also argued that there is no basis for claiming that John Rawls was solely a ``negative liberty'' theorist. The chapter also considers whether there must be an inherent contrast between the two views when it comes to the goals of any egalitarian view or its constituency. It is argued that Rawls's approach to these two issues does converge with that of the Roman republican.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0001},
	editor = {Thomas, Alan},
	file = {Thomas_2016_Rawls, Republicanism, and Liberal-Republicanism0.pdf;../../../Zotero/storage/GX7QCEQ7/148065917.html},
	isbn = {978-0-19-060211-6},
	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	title = {Rawls, {{Republicanism}}, and {{Liberal-Republicanism}}},
	url = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0001},
	urldate = {2024-11-27},
	bdsk-url-1 = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0001}}

@incollection{thomasRawlssCritiqueWelfareState2016,
	abstract = {This chapter examines John Rawls's critique of welfare-state capitalism. The republican focus on liberty as non-domination that Rawls shares with liberal-republicanism explains its most controversial claims. An argument is identified that has been used to deflate the originality and significance of a property-owning democracy. It has been argued that, given that it shares so many features with a welfare state, a property-owning democracy can be only an expansion of welfare-state capitalist institutions with some ad hoc asset-based policies. This argument is undermined and the difference between the basic minimum payable under justice as fairness and a universal unconditional basic income is explained. Both are compared and contrasted with the liberal-republican restructuring of the market as a whole. Attempts to revise welfare-state capitalism so that it is equally capable of realizing justice are criticized and the concept of reciprocity clarified.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0007},
	editor = {Thomas, Alan},
	isbn = {978-0-19-060211-6},
	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	title = {Rawls's {{Critique}} of {{Welfare-State Capitalism}}},
	url = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0007},
	urldate = {2024-11-27},
	bdsk-url-1 = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0007}}

@incollection{thomasRealisticUtopianism2016,
	abstract = {There has been a persistent confusion between the different ideas of ideal versus nonideal theory and realistic versus unrealistic utopianism. In this chapter, this methodological issue is discussed and the use of these terms disambiguated. It is suggested that an analogy with a parallel discussion in ethics helpfully resolves some of the problems that arise in understanding both sets of terms. It is explained why John Rawls was correct to emphasize that nothing less than justice as a whole should be aimed at and that, in particular, aiming at comparative improvements between two social states may be a mistake. The chapter concludes by explaining how, under a property-owning democracy, capital will be dispersed to as to change our conception of the ``interests of capital''. Control of capital will converge with social democratic values as opposed to being in conflict with them.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0011},
	editor = {Thomas, Alan},
