	number = {1932111},
	pubstate = {prepublished},
	shorttitle = {Early {{Childhood Conditions}} and {{Mortality}}},
	title = {Early {{Childhood Conditions}} and {{Mortality}}: {{Evidence}} from {{Japanese American Internment}}},
