	keywords = {guilt reviewed,reviewed},
	number = {2},
	pages = {318--326},
	shortjournal = {Journal of Communication},
	shorttitle = {Mediating {{Neoliberal Capitalism}}},
	title = {Mediating {{Neoliberal Capitalism}}: {{Affect}}, {{Subjectivity}} and {{Inequality}}},
	url = {https://doi.org/10.1093/joc/jqy002},
	urldate = {2022-06-03},
	volume = {68},
	bdsk-url-1 = {https://doi.org/10.1093/joc/jqy002}}

@book{gimpelSeparateDestinationsMigration1999,
	abstract = {Natives who change residence do not settle in the same places as immigrants. Separate Destinations argues that these distinct mobility patterns, coupled with record levels of immigration from impoverished third world nations, are balkanizing the American electorate. James G. Gimpel examines the consequences of different patterns of movement and settlement on the politics of the communities in which these different groups settle. Newer immigrants are con-strained by a lack of education, money, English literacy, and information--and frequently by discrimination--to live in areas of coethnic settlement. Domestic, native-born migrants--predominantly Caucasian--free of discrimination and possessing more money and information, move where they wish, often to communities where immigrants are not welcome or cannot afford to live. Strong evidence suggests that spatially isolated immigrants are slower to naturalize and get involved in politics than domestic migrants. Gimpel looks closely at states with very different patterns of migration and immigration: California, Colorado, Kansas, Kentucky, Florida, Pennsylvania, and New York. In these states, Gimpel shows the impact of population mobility on party registration, party votes, and voter turnout and asks whether population changes have changed the dominant party in a state or produced a political reaction from natives. Separate Destinations contains a number of thematic maps detailing the settlement patterns of internal migrants and immigrants for both counties and census tracts. Blending insights from a number of social science disciplines, including economics, demography, sociology, political science, and anthropology, this book will be of interest to a wide and diverse readership of scholars, students, and policymakers. James G. Gimpel is Associate Professor of Government, University of Maryland.},
	author = {Gimpel, James Graydon},
	date = {1999},
	file = {../../../Zotero/storage/2QIU39NH/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/6TKCGN8U/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/7YQMF5QV/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/8PIW6B8T/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/9WQMRC8Y/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/A5HN69TD/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/AVL2RR7H/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/CRMUFKAT/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/EJCRLZVC/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/H7KRBNDW/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/JIEMNR44/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/M96D9PF6/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/NRFMFMCK/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/NY6BZY3P/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/PBFRSX5F/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/RXUBLEKK/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/S5MGE99J/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/VA95HVQU/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/VCELPUR3/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;../../../Zotero/storage/ZCK3I9XQ/Gimpel - 1999 - Separate Destinations Migration, Immigration, and.pdf;Gimpel_1999_Separate Destinations.pdf},
