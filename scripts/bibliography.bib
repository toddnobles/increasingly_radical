	issn = {1369-183X},
	journaltitle = {Journal of Ethnic and Migration Studies},
	keywords = {/unread,Europe,Immigration,Policies,Politicisation,Public Opinion},
	number = {9},
	pages = {1495--1516},
	publisher = {Routledge},
	shorttitle = {The {{Gap}} between {{Public Preferences}} and {{Policies}} on {{Immigration}}},
	title = {The {{Gap}} between {{Public Preferences}} and {{Policies}} on {{Immigration}}: {{A Comparative Examination}} of the {{Effect}} of {{Politicisation}} on {{Policy Congruence}}},
	url = {https://doi.org/10.1080/1369183X.2015.1021598},
	urldate = {2024-02-29},
	volume = {41},
	bdsk-url-1 = {https://doi.org/10.1080/1369183X.2015.1021598}}

