@article{brandEffectsJobDisplacement2006,
	abstract = {This study examines the extent to which job displacement divides the career experiences for a cohort of workers. Previous studies of job displacement find nontrivial economic losses for displaced workers, but the effects of displacement on ``non-economic'' properties of jobs have been largely overlooked. Results using the Wisconsin Longitudinal Study indicate that workers who were displaced have lower levels of occupational status, job authority, and employer-offered pension and health insurance than they would have had had they not been displaced. Difference-in-differences estimates, which control for temporally-invariant unobserved heterogeneity, are generally larger than cross-sectional estimates; still, there is a close correspondence of estimates across a range of methodological approaches attesting to the robustness of the estimates in the face of various technical assumptions and model specifications. Effects of displacement on job quality also exhibit conditioning by gender, education, occupation, and industry: while less educated, blue collar and manufacturing workers experience significant losses for employer-offered benefits, more educated, upper white collar and non-manufacturing workers experience significant losses for occupational status, job autonomy, and job authority.},
	annotation = {51 citations (Crossref) [2023-04-10]},
	author = {Brand, Jennie E.},
	date = {2006-07},
	doi = {10.1016/j.rssm.2006.03.001},
	file = {Brand_2006_The effects of job displacement on job quality275-298.pdf},
	issn = {02765624},
	journaltitle = {Research in Social Stratification and Mobility},
	keywords = {ObsCite},
	langid = {english},
	note = {\section{Annotations\\ (4/17/2023, 9:57:57 AM)} \par ``Effects of displacement on job quality also exhibit conditioning by gender, education, occupation, and industry: while less educated, blue collar and manufacturing workers experience significant losses for employer-offered benefits, more educated, upper white collar and non-manufacturing workers experience significant losses for occupational status, job autonomy, and job authority.'' (Brand, 2006, p. 275) \par ``But the effect of job displacement on occupational status, authority, and autonomy has been largely overlooked.'' (Brand, 2006, p. 277) \par ``The central issue is whether observed associations between displacement and measures of subsequent job quality indicate the casual effect of this type of job loss. Are differences in the career achievements of displaced and non-displaced workers due to displacement or due to measured and unmeasured factors associated with being displaced? Do the data warrant the conclusion'' (Brand, 2006, p. 287) \par ``that job displacement causes a worker's career to be different than it otherwise would have been in the absence of job displacement?'' (Brand, 2006, p. 287) \par ``This study asks how economic restructuring is affecting what it means to hold a job and shape a career. I focus on the causal effect of a particular job market process and mobility mechanism, job displacement, on a host of job quality outcomes. In contrast to past research on displacement that has focused exclusively on economic outcomes, this study has examined how job displacement divides other properties of jobs that signal quality: occupational status, job autonomy and authority, and employer-offered pension and health insurance benefits. The analyses presented throughout this study ask whether workers who are displaced from jobs have careers that are different than they otherwise would have been had they not been displaced. That is, does job displacement cause subsequent job quality differences, or are subsequent job quality differences due to factors associated with being displaced? This study has adopted the approach that if we are interested in the causal effect of displacement on career outcomes, we must consider two potential outcomes: outcomes for a displaced worker that are observed and outcomes for the same worker had that worker not been displaced.'' (Brand, 2006, p. 292) \par ``workers displaced from jobs experience statistically and substantively significant occupational status, job authority, and employer-offered benefit losses.'' (Brand, 2006, p. 292)},
	number = {3},
	pages = {275--298},
	shortjournal = {Research in Social Stratification and Mobility},
	shorttitle = {The Effects of Job Displacement on Job Quality},
	title = {The Effects of Job Displacement on Job Quality: {{Findings}} from the {{Wisconsin Longitudinal Study}}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0276562406000291},
	urldate = {2023-04-10},
	volume = {24},
	bdsk-url-1 = {https://linkinghub.elsevier.com/retrieve/pii/S0276562406000291},
	bdsk-url-2 = {https://doi.org/10.1016/j.rssm.2006.03.001}}

@article{brandRecentDevelopmentsCausal2023,
	abstract = {This article reviews recent advances in causal inference relevant to sociology. We focus on a selective subset of contributions aligning with four broad topics: causal effect identification and estimation in general, causal effect heterogeneity, causal effect mediation, and temporal and spatial interference. We describe how machine learning, as an estimation strategy, can be effectively combined with causal inference, which has been traditionally concerned with identification. The incorporation of machine learning in causal inference enables researchers to better address potential biases in estimating causal effects and uncover heterogeneous causal effects. Uncovering sources of effect heterogeneity is key for generalizing to populations beyond those under study. While sociology has long emphasized the importance of causal mechanisms, historical and life-cycle variation, and social contexts involving network interactions, recent conceptual and computational advances facilitate more principled estimation of causal effects under these settings. We encourage sociologists to incorporate these insights into their empirical research.},
	author = {Brand, Jennie E. and Zhou, Xiang and Xie, Yu},
	date = {2023},
	doi = {10.1146/annurev-soc-030420-015345},
	file = {Brand et al_2023_Recent Developments in Causal Inference and Machine Learning81-110.pdf},
	journaltitle = {Annual Review of Sociology},
	keywords = {/unread,causal inference,counterfactuals,external validity,extrapolation,machine learning,mediation,treatment effect heterogeneity},
	number = {1},
	pages = {81--110},
	title = {Recent {{Developments}} in {{Causal Inference}} and {{Machine Learning}}},
	url = {https://doi.org/10.1146/annurev-soc-030420-015345},
	urldate = {2023-09-06},
	volume = {49},
	bdsk-url-1 = {https://doi.org/10.1146/annurev-soc-030420-015345}}

@article{brantonReexaminingRacialAttitudes2005,
	abstract = {Social science research notes that racial context is related to attitudes toward social issues; however, surprisingly little research has examined how the impact of racial context on attitudes is activated. The aim of this article is to examine racial context ``effects'' for policy preferences, but to do so within a broader perspective. This article extends the literature on racial attitudes by considering a conditional relationship between racial and ethnic context and socioeconomic context and expanding racial context to include multiple racial and ethnic groups. The findings indicate that racial and ethnic contextual effects do emerge; however, these effects are conditional on the socioeconomic context in which an individual resides. Specifically, high socioeconomic contexts and highly diverse contexts are related to higher levels of support for racial social issues; however, contexts characterized by low socioeconomic context and high racial and ethnic diversity are associated with lower levels of support for such issues.},
	annotation = {153 citations (Crossref) [2024-05-04]},
