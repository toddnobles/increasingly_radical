	number = {5},
	pages = {1078--1086},
	publisher = {Routledge},
	shorttitle = {Beyond {{Space}} ({{As We Knew It}})},
	title = {Beyond {{Space}} ({{As We Knew It}}): {{Toward Temporally Integrated Geographies}} of {{Segregation}}, {{Health}}, and {{Accessibility}}},
	url = {https://doi.org/10.1080/00045608.2013.792177},
