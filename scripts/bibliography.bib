@article{robinsonEthnicVisibility,
	abstract = {The political utility of ethnicity is typically attributed to the ease with which it can be observed. However, ethnic visibility is not universal, and I argue that its variation has political implications; namely that more visible group members support ethnic parties at higher rates because they have the most to gain (or lose) from ethnopolitical competition. Using original data from Malawi, I find that individual-level ethnic visibility is indeed strongly associated with ethnic party support. I provide further evidence that visibility induces party support instrumentally by shaping expectations about others' ability to correctly infer ethnic belonging. I also show that the theory generalizes to the group level, with more visible ethnic groups across Africa being more likely to vote ethnically. These results qualify a central assumption in instrumental theories of ethnic politics---that ethnic identities are always visible---and help explain variation in the success of ethnic political mobilization.},
	author = {Robinson, Amanda Lea},
	doi = {10.1111/ajps.12795},
	file = {Robinson_Ethnic Visibility.pdf;../../../Zotero/storage/X53DVHQ6/ajps.html},
	issn = {1540-5907},
	journaltitle = {American Journal of Political Science},
	keywords = {/unread},
	langid = {english},
	number = {n/a},
	title = {Ethnic {{Visibility}}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12795},
	urldate = {2023-09-06},
	volume = {n/a},
	bdsk-url-1 = {https://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12795},
	bdsk-url-2 = {https://doi.org/10.1111/ajps.12795}}

@article{robinsonSurvivingCapitalismAffordability2021,
	abstract = {In a time of growing inequality, analysts and commentators increasingly highlight the unaffordability of everyday living under capitalism as a convenient language for diagnosing today's problems and devising policy solutions. This article reconsiders the notion of an ``affordability crisis'' by drawing on Du Bois' conceptualization of the racial ``wage'' to theorize the uneven development of markets: a racial stratification process that renders capitalism affordable and livable for some non-elites, often whites, but not others. One of racism's economic consequences is that it systematically produces affordability crises for market participants on the wrong side of the color line. Drawing on the literature of published studies on white suburbanization combined with historical evidence on the Community Reinvestment movement, this article illustrates the contrasting affordability politics in the homeowner and renter markets, which are divergent both in racial composition and in terms of their affordability to people without wealth. Ultimately, this article explains how and why marginalized groups undertake efforts to politically reconfigure the way markets work from the ground up, albeit through necessarily strained and improvisational means: as in community groups' appropriation of tax shelters to finance affordable rental housing production, marking a precursor to policies subsequently adopted by mainstream officials and legislators.},
	annotation = {5 citations (Crossref) [2023-02-09]},
	author = {Robinson, III, John N},
	date = {2021-05-01},
	doi = {10.1093/socpro/spaa078},
	file = {Robinson_2021_Surviving Capitalism321-339.pdf},
	issn = {0037-7791},
	journaltitle = {Social Problems},
	note = {\section{Annotations\\ (2/16/2023, 2:16:17 PM)} \par ``But this article develops a new theoretical perspective that reconsiders the notion of an ``affordability crisis.'' I draw on DuBois' (1935) conceptualization of the racial ``wage''---with emphasis on the politics of economic self-sufficiency---to interrogate how racism shapes markets in ways that make them relatively affordable for some non-elites, but not others. This new angle on affordability politics highlights the following paradox: while capitalism is hostile by design to people without money and wealth (Harvey 2005), it is also heavily reliant on interventions that facilitate affordable market participation for some, insulating them from capitalism's worst excesses (see Cohen 2003; Prasad 2012). In this way, this article unearths a deeper stratification process whereby public policies and practices sort people into structurally different kinds of markets---some with built-in privileges, including affordability, and others without them---largely (though not exclusively) along racial lines.'' (Robinson, 2021, p. 322) \par ``tax shelters as an instrument for financing affordable housing production, which inspired the later adoption of tax credits as mainstream housing policy (Erickson 2009; Robinson 2019'' (Robinson, 2021, p. 323) \par ``The key implication is that market affordability should be understood as a privilege generally reserved for higher-status groups and denied to marginalized ones: an effect more than an engine of race and class stratification.'' (Robinson, 2021, p. 323) \par ``Markets in this way embody a class project that ideologically favors the interests of economic elites (Harvey 2005), which, especially under conditions of austerity, often produces ``affordability crises'' that non-elites must navigate and survive. But racism exacerbates capitalism's general discriminatory tendencies, as blacks and Hispanics experience cumulative disadvantages that go beyond merely insufficient income (Korver-Glenn 2018; Krysan and Crowder 2017)'' (Robinson, 2021, p. 323) \par ``Du Bois' ideas here converge around what I refer to as the naturalization of white economic self-sufficiency; that is, under capitalism, non-elites of all backgrounds generally face the same challenge of participating in markets without being able to afford a decent life via income alone---but whiteness affords privileges to some non-elites through benefits that allow them to feel self-sufficient in their economic pursuits and enshrine them as the honest winners in an allegedly self-sustaining market economy.'' (Robinson, 2021, p. 324) \par ``This dynamic of stratification, I argue, occurs largely via public policies and practices that sort non-elites into structurally-different kinds of markets, what I refer to as the uneven development of markets.'' (Robinson, 2021, p. 325) \par ``Echoing Du Bois, this perspective assumes that states and markets are mutually constitutive in American social policy: markets are constructed via public policies and practices (Fligstein 1996), and the social safety net is largely oriented around such markets---especially via credit expansionwhich renders it hidden, or otherwise illegible as a form of state intervention (see Quinn 2019). But my analysis illuminates how political and economic elites construct markets to be differentially affordable and livable for white non-elites and communities of color, respectively.'' (Robinson, 2021, p. 325) \par ``Second, and more importantly for this article, most of those excluded from the mainstream are relegated to marginal markets, which are largely devoid of institutional support. Mirroring'' (Robinson, 2021, p. 326) \par ``As compared to the suburban home credit boom, the bottom-up work of market-building, for CRaffiliated groups, would be more improvisational, embodying a more ad hoc, off-the-cuff, and do-ityourself approach to boosting market affordability. For example, TWO and other groups developed a ``creative financing'' innovation that used tax shelters as a means of generating capital and financing affordable rental housing production---an approach later adopted as mainstream low-income housing policy. For CR-affiliated groups, this improvisational tactic was necessary to cope with ``our sad lack of tools''---as the CRN newsletter put it---and reflected their ``commitment to experimenting with new concepts and styles of working together to make change.''14 This improvisation meant procuring institutional support via alternative means: in this case, by appropriating tax shelter provisions that Treasury department officials intended to support the commercial building industry and its ``entrepreneurial risk-taking'' (Bittker, McMahon, and Zelenak 2002). These write-offs allowed builders to recoup the money that they lost as properties depreciated. Treasury officials consistently expanded tax depreciation benefits, up until the mid-1980s (Brazell, Dworin, and Walsh 1989), which in turn ``pump[ed] up the amount of credit available'' to builders (Von Hoffman 2003:184). These moves resulted in the growth of a multi-billion dollar ``tax shelter'' industry in which developers sold these benefits to high-net-worth individuals looking to avoid paying taxes (CBO 1977)'' (Robinson, 2021, p. 332) \par ``The emerging tax shelter industry created unforeseen and unprecedented opportunities for CRaffiliated groups: where the FHA had deemed low-cost rental properties as financially hazardous and urban renewal authorities as ``blighted'' and obsolete, the tax code classified them as products of entrepreneurial risk-taking that deserved ample r'' (Robinson, 2021, p. 332) \par ``However, these bottom-up efforts ultimately fell short of the membership stake that the racial wage afforded to whites. CR-affiliated groups found that the same economic incapacitation that necessitated their improvisational tactics also constrained them. Indeed, my analysis suggests that such improvisation can never match the full-hearted human capital investment that fueled white suburbanization, because it cannot possibly go as far in transforming the larger institutional and political contexts in which market processes and outcomes play out. For example, while many CR-affiliated groups secured the investment necessary to finance housing production through tax shelters, they also consistently ran up against deeply entrenched racial barriers that undercut the sustainability of these developments. Tax shelters failed to address, for example, the problem of most projects developed by CR-affiliated groups: they were sited in racial minority neighborhoods, where racially discriminatory local tax officials routinely appraised properties at lower values to direct investment elsewhere, while at the same assessing them at higher values to extract more tax revenue for the public coffers (Kahrl 2017).'' (Robinson, 2021, p. 333) \par ``In this way, the affordable housing struggles of CR-affiliated groups reflect the broader structural dilemma of economic incapacitation. Even where communities of color have been forced to carry out the political work of market-building from the ground up, they have repeatedly bumped up against the exclusionary limits of a society that still deems them as unworthy of full citizenship. Their improvisational tax shelter partnerships have proved lopsided and inadequate, and have sparked financial panics that have inflamed public perceptions that these groups are incapable of responsible property ownership. Likewise, despite the availability of tax shelter investments, the structural gap between the homeowner and'' (Robinson, 2021, p. 334)},
	number = {2},
	pages = {321--339},
	shortjournal = {Social Problems},
	shorttitle = {Surviving {{Capitalism}}},
	title = {Surviving {{Capitalism}}: {{Affordability}} as a {{Racial}} ``{{Wage}}'' in {{Contemporary Housing Markets}}},
	url = {https://doi.org/10.1093/socpro/spaa078},
	urldate = {2023-02-09},
	volume = {68},
	bdsk-url-1 = {https://doi.org/10.1093/socpro/spaa078}}

