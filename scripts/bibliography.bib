	publisher = {The University of Chicago Press},
	shorttitle = {The {{Transformation}} of {{Morals}} in {{Markets}}},
	title = {The {{Transformation}} of {{Morals}} in {{Markets}}: {{Death}}, {{Benefits}}, and the {{Exchange}} of {{Life Insurance Policies}}},
	url = {http://www.jstor.org/stable/10.1086/592861},
	urldate = {2022-02-18},
	volume = {114},
	bdsk-url-1 = {http://www.jstor.org/stable/10.1086/592861},
