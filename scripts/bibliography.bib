@article{tolbertRevisitingRacialThreat2003,
	abstract = {Are white Americans living among nonwhites more likely to support ending affirmative action than those living in more homogeneous white communities? Previous research on the contextual determinants of white racial attitudes has explored the "racial threat" hypothesis (that white racism increases with the competition posed by a greater proportion of African Americans in a community) and the extent to which these attitudes are driven mainly by cultural and socio-economic contexts. We test these hypotheses by analyzing votes for California's Proposition 209 in 1996, which aimed to end affirmative action in the state. Our census-tract-level analysis suggests that white support for Proposition 209 was higher in tracts with larger Latino, African-American, or Asian-American populations, even after controlling for other factors. Thus, our results support the racial threat hypothesis.},
	author = {Tolbert, Caroline J. and Grummel, John A.},
	date = {2003},
	eprint = {40421487},
	eprinttype = {jstor},
	file = {Tolbert_Grummel_2003_Revisiting the Racial Threat Hypothesis183-202.pdf},
	issn = {1532-4400},
	journaltitle = {State Politics \& Policy Quarterly},
	keywords = {⛔ No DOI found},
	note = {\textbf{Extracted Annotations (3/15/2022, 12:08:13 AM)} \par "Blalock (1967) fine tunes this theory of inter-group competition by suggesting that discrimnation based on such a threat is nonlinear, taking the form of a j-curve. Thus, people living in places with small minority populations will be moderately as the minority population increases and whites come into greater contact and competition with minorities, the perceived threat that the minority group causes will increase" (\href{zotero://open-pdf/library/items/QIULEMH7?page=3}{Tolbert and Grummel 2003:185}) \par "hus, white support for endng affirmative action was higher in census tracts with larger Latino, AfricanAmerican, or Asian-American populations, even after controlling for partisanship, socioeconomic conditions, and the urban nature of the community." (\href{zotero://open-pdf/library/items/QIULEMH7?page=10}{Tolbert and Grummel 2003:192}) \par "hus, our findings that whites oppose affirmative action as their neighborhoods become more racially diverse regardless of race is more consistent with the cultural backlash hypothesis (Green, Strolovitch, and Wong 1998), which emphasizes the social and psychological threat of rapid racial and ethnic change. As immigration has transformed California from a state where the vast majority were white to a multi-ethnic society (Baldassare 2000), whites may feel compelled to defend their cultural prerogatives. Such a compulsion may be strongest in racially diverse neighborhoods, where the perceived threat is most obvious. While our cross-sectional data cannot be used to test the influence of this change on racial attitudes, the cultural backlash hypothesis may account for whites' support for ending affirmative action even in the presence of economically nonthreatening population" (\href{zotero://open-pdf/library/items/QIULEMH7?page=16}{Tolbert and Grummel 2003:198})},
	number = {2},
	pages = {183--202},
	publisher = {Sage Publications, Inc.},
	shorttitle = {Revisiting the {{Racial Threat Hypothesis}}},
	title = {Revisiting the {{Racial Threat Hypothesis}}: {{White Voter Support}} for {{California}}'s {{Proposition}} 209},
	url = {http://www.jstor.org/stable/40421487},
	urldate = {2022-03-10},
	volume = {3},
	bdsk-url-1 = {http://www.jstor.org/stable/40421487}}

