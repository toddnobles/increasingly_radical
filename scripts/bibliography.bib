	eprinttype = {jstor},
	file = {Anyon_1980_Social Class and the Hidden Curriculum of Work67-92.pdf},
	issn = {0022-0574},
	journaltitle = {The Journal of Education},
	note = {generally rote behaviors taught in working class kids' schools \par defining social class \par \begin{itemize} \item relationships between people (relationship one has to authority and control at work and in society) \item ownership relations \item relations between people and their work - working class jobs as routine or mechanical, versus opposite end of spectrum of capitalists on conceptualization, management, control, planning \end{itemize} \par higher class schools asking for students' own thoughts and giving them opportunitis to engage in critical thinking of how to complete tasks. Allow for more autonomy in their activity choices. This is in contrast to the lower class schools that insist on a correct way to do things},
