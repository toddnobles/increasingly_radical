	number = {3},
	pages = {615--635},
	shortjournal = {City \& Community},
	shorttitle = {Eclipsing {{Community}}?},
	title = {Eclipsing {{Community}}? {{Neighborhood Disadvantage}}, {{Social Mechanisms}}, and {{Neighborly Attitudes}} and {{Behaviors}}},
	url = {http://journals.sagepub.com/doi/10.1111/cico.12327},
	urldate = {2022-04-08},
