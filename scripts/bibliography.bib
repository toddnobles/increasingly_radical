	keywords = {Ehlers-Danlos syndrome,hypermobility,musculoskeletal},
	langid = {english},
	number = {3},
	pages = {318--344},
	shorttitle = {Hypermobile {{Ehlers-Danlos}} Syndromes},
	title = {Hypermobile {{Ehlers-Danlos}} Syndromes: {{Complex}} Phenotypes, Challenging Diagnoses, and Poorly Understood Causes},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/dvdy.220},
