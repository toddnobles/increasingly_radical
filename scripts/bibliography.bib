	shorttitle = {Sustainability {{Living}} in a {{Carbon-Priced Economy}}},
	title = {Sustainability {{Living}} in a {{Carbon-Priced Economy}}: ``{{Shoulds}}'' and ``{{Woulds}},'' {{Making Amends}} and {{Sustainability Guilt}}},
