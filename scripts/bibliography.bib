	pages = {25--34},
	shorttitle = {When threat to society becomes a threat to oneself},
	title = {When threat to society becomes a threat to oneself: Implications for right-wing attitudes and ethnic prejudice},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1080/00207594.2012.701747},
	urldate = {2022-03-10},
