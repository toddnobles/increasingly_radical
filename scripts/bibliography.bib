	pages = {1--46},
	publisher = {The University of Chicago Press},
	shorttitle = {Optics of the {{State}}},
	title = {Optics of the {{State}}: {{The Politics}} of {{Making Poverty Visible}} in {{Brazil}} and {{Mexico}}},
	url = {https://www.journals.uchicago.edu/doi/full/10.1086/719936},
	urldate = {2023-02-15},
