	number = {2},
	pages = {342--377},
	publisher = {University of Chicago Press},
	shorttitle = {The {{Social Meaning}} of {{Money}}},
	title = {The {{Social Meaning}} of {{Money}}: "{{Special Monies}}"},
	url = {https://www.jstor.org/stable/2780903},
	urldate = {2023-01-17},
