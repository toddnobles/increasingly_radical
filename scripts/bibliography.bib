	publisher = {SAGE Publications Ltd},
	shorttitle = {The {{Impact}} of {{Remote Work}} on {{Managerial Compliance}}},
	title = {The {{Impact}} of {{Remote Work}} on {{Managerial Compliance}}: {{Changes}} in the {{Control Regime}} over {{Line Managers}}},
	url = {https://doi.org/10.1177/09500170221142713},
