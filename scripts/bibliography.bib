	issn = {1049-5142},
	journaltitle = {Journal of Nonprofit \& Public Sector Marketing},
	keywords = {donation intention,environmental campaigning,environmental concern,guilt,independent study,message framing,self-efficacy,social campaigning},
	number = {2},
