	shorttitle = {New {{Money}}},
	title = {New {{Money}}: {{How Payment Became Social Media}}},
	url = {https://www.jstor.org/stable/j.ctv10sm94k},
	urldate = {2023-02-11},
	bdsk-url-1 = {https://www.jstor.org/stable/j.ctv10sm94k},
