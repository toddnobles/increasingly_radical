@article{monteroCooperativePropertyRights2022,
	abstract = {In cooperative property rights systems, workers jointly own and manage production, whereas in outside-ownership systems, an owner contracts workers. Despite a rich theoretical literature on how the allocation of property rights matters for specialization, efficiency, and equity, little causal evidence of their impacts exists. During a land reform in El Salvador in 1980, the military government expropriated properties owned by individuals with cumulative landholdings over 500 hectares and re-organized them into cooperatives managed by the properties' former workers. Properties belonging to individuals with less than 500 hectares remained as outside-owned properties. Using the discontinuous probability of a property becoming a cooperative and a regression discontinuity design, I present causal evidence on the effects of cooperative property rights relative to outside ownership on crop specialization, productivity, and worker equity. I find that cooperatives are (i) less likely to produce cash crops and more likely to produce staple crops; (ii) less productive when producing cash crops but more productive when producing staple crops; and (iii) have more equitable worker incomes relative to outside-owned properties. The results are consistent with an incomplete contracting model that compares cooperatives and outside-owned properties.},
	author = {Montero, Eduardo},
	date = {2022-01-01},
	doi = {10.1086/717042},
	file = {montero_cooperatives.pdf},
	issn = {0022-3808, 1537-534X},
	journaltitle = {Journal of Political Economy},
	langid = {english},
	number = {1},
	pages = {48--93},
	shortjournal = {Journal of Political Economy},
	shorttitle = {Cooperative {{Property Rights}} and {{Development}}},
	title = {Cooperative {{Property Rights}} and {{Development}}: {{Evidence}} from {{Land Reform}} in {{El Salvador}}},
	url = {https://www.journals.uchicago.edu/doi/10.1086/717042},
	urldate = {2022-02-04},
	volume = {130},
	bdsk-url-1 = {https://www.journals.uchicago.edu/doi/10.1086/717042},
	bdsk-url-2 = {https://doi.org/10.1086/717042}}

