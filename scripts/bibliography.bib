	number = {4},
	pages = {302--319},
	shortjournal = {Sociol Educ},
	shorttitle = {Inhabiting {{Latino Politics}}},
	title = {Inhabiting {{Latino Politics}}: {{How Colleges Shape Students}}' {{Political Styles}}},
