	journaltitle = {Explorations in Economic History},
	keywords = {/unread,Education,Japanese American Internment,Returns to education,School quality},
	pages = {59--78},
	shortjournal = {Explorations in Economic History},
	shorttitle = {School Quality and Educational Attainment},
