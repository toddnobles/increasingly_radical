	publisher = {Routledge},
	shorttitle = {Environmentalism---{{A Question}} of {{Guilt}}?},
	title = {Environmentalism---{{A Question}} of {{Guilt}}? {{Testing}} a {{Model}} of {{Guilt Arousal}} and {{Effects}} for {{Environmental Campaigns}}},
