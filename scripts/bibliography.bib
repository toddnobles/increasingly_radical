@article{calderHalalizationReligiousProduct2020,
	abstract = {In Islam, the extension of religious regulation and certification to new product types and economic sectors---``halalization''---has become widespread. There are now Islamic mortgages, halal ports, halal refrigerators, halal blockchain, and shariah-compliant cryptocurrencies. Yet classical secularization theory says religious authority cannot regulate modern economic activity. So what explains halalization? I point to an elective affinity between fiqh (Islamic jurisprudence) and twenty-first-century markets. Contemporary fiqh offers widely respected religious jurists who issue fatwas certifying products. Entrepreneurs empanel the jurists on certification boards, allowing fiqh to function as a regime of voluntary regulation layered atop secular state law instead of conflicting with it. Indeed, secular liberal markets provide ideal conditions for halalization and religious meaning-making through consumption. Case studies of Islamic finance and halal logistics show how entrepreneurs assuage consumers' religious anxieties---and generate new ones---in the context of globalization and liberalization in secular markets.},
	annotation = {2 citations (Crossref) [2022-06-07]},
	author = {Calder, Ryan},
	date = {2020-12-01},
	doi = {10.1177/0735275120973248},
	file = {Calder_2020_Halalization334-2.pdf},
	issn = {0735-2751},
	journaltitle = {Sociological Theory},
	keywords = {economic secularism and secular markets,guilt actually used,guilt reviewed,halal logistics,Islam and capitalism,Islamic finance,ObsCite,reviewed,voluntary regulation and certification},
	langid = {english},
	note = {\section{Annotations\\ (6/4/2022, 9:32:21 AM)} \par ``However, the principle that modern economic activity is allergic to formal religious regulation remains unchallenged. This article argues that halalization is possible thanks to an elective affinity2 between contemporary fiqh and contemporary liberal markets. Fiqh is Islamic jurisprudence: the science of Islamic law, or religious scholars' attempt to instantiate God's normative ordershariah---through interpretation, reasoning, and scholarship. Fiqh and its community of practitioners offer (1) widely legitimate experts in religious ethics and law (shariah scholars) who can issue (2) an instantly recognizable certification label (the fatwa) in response to ethical anxieties about products and services. Experts in fiqh embrace (3) normative pluralism: the principle that fellow experts may legitimately come to different legal rulings on the same matter. Halalization'' (Calder, 2020, p. 335) \par ``To preview the theoretical argument: Contemporary fiqh offers legitimate experts (shariah scholars), a familiar certification badge (the fatwa), and normative pluralism. These elements mix well with the liberal economic secularism that animates the regulation of many national economies: a permissive attitude toward market exchange in general and voluntary product certification in particular (liberalism) combined with a strong reluctance to make binding economic policy on religious grounds (economic secularism). As a voluntary regulatory system, fiqh can sit inoffensively atop binding state laws and regulations. Customers, not governments, decide whether to apply religious law when they consume. Moreover, when fiqh becomes a formal system of voluntary regulation, a wide range of firms and entrepreneurs---including non-Muslims---can deploy it creatively to new kinds of products. Fiqh is thus compatible with markets whose agents think within the ``immanent frame'' (Taylor 2007). Fiqh's application as product certification in liberal markets also depends on and reproduces secularism as understood by Talal Asad: the power to define and circumscribe religion and assign its proper content (Asad 2003; Mahmood 2016). Asad, Saba Mahmood, and others have investigated how liberal political secularism defines and delimits religion, but this article breaks new ground by exploring how liberal economic secularism and twenty-first-century markets do so.'' (Calder, 2020, p. 336) \par ``mutual funds meet Lutheran, Southern Baptist, Roman Catholic, Mennonite, and Christian Scientist screening criteria (Peifer 2011);'' (Calder, 2020, p. 339) what's the meaningful difference between these sorts of labels or certifications environmental sustainability and governance certifications and labels like organic free range or vegan \par ``Since the late twentieth century, globalization and market liberalization have generated and drawn attention to new connections, risks, and ethical tradeoffs for consumers and firms. Trade and capital-account liberalization, the growth of multinational corporations, and the extension of supply chains across borders have caused consumers and investors to worry they may be complicit in moral transgressions abroad, including inhumane labor practices, environmental despoliation, and corruption (Locke, Amengual, and Mangla 2009; Prakash and Potoski 2006). Consumers also fear contamination at multiple nodes in supply chains (Gereffi, Humphrey, and Sturgeon 2005): unsafe ingredients during production, mislabeling during packaging, and spoilage during warehousing. At the same time, financialization, financial deepening, and increasingly sophisticated mass-market investment technologies have ``compel[led] workers and households to become savvy about financial risk'' and made consumers feel personally responsible for structural inequality even at the global level (Parfitt 2020:575).'' (Calder, 2020, p. 341) use for guilt paper \par ``These trends have spurred the proliferation of voluntary market regulation. The impulse toward voluntary regulation is not new---movements for ethical consumption and consumer protection were a hallmark of the Progressive Era (Wolfe 1975)---but surveys suggest consumers are increasingly turning to voluntarily certified products because globalization amplifies old concerns and raises new ones (Loureiro and Lotade 2005). Indeed, the extension and growing complexity of global value chains has been the most important contributor to voluntary regulation's expansion (Gereffi et al. 2005). Social movements that have grown with globalization---such as those focused on environmental concerns, sweatshop and child labor, and consumer protection---have contributed greatly to this expansion (Esbenshade 2004). So have financialization (Parfitt 2020), shareholder activism, and the spread of corporate social responsibility discourse (Campbell 2007:956--57). The impetus is both ``stick'' and ``carrot'': Voluntary certification allows firms to charge price premiums and target niche market segments, such as ``green'' consumers (Campbell 2007).'' (Calder, 2020, p. 342) use for guilt paper \par ``Since the 1980s, the shariah scholars and bankers who occupy leading positions in Islamic finance (Kahf 2004) have settled on principles that distinguish Islamic finance from conventional finance. First, Islamic finance avoids usury (rib{\=a}; Quran 2:275--79). Many Muslims, including a majority of jurists, believe all interest counts as usury. Second, Islamic finance'' (Calder, 2020, p. 343) \par ``avoids gambling and excessively speculative transactions (maysir). To some, this rules out conventional life insurance.12 Third, Islamic finance eschews major uncertainty (gharar f{\=a}{\d h}ish) in transactions'' (Calder, 2020, p. 344) \par ``Fourth, Islamic finance avoids investment in sinful ({\d h}ar{\=a}m) sectors---such as alcohol, pork, gambling, pornography, and conventional banking---and in highly leveraged companies. Fifth, for a transaction to be Islamic, the person who receives financial reward must take on some liability.13 Most Islamic jurists conclude that prespecified profits on an investment are unlawful (El-Gamal 2006:145; Elgari 2003), although prespecified returns on sales and leases are acceptable.'' (Calder, 2020, p. 344) \par ``Shariah board members are not employees, so they do not receive salaries. However, like members of corporate boards, they receive honoraria'' (Calder, 2020, p. 345) \par ``He engaged in what Daromir Rudnyckyj (2014) called ``economy in practice'': reflecting and acting on economic rationality from an ethical perspective'' (Calder, 2020, p. 347) use for guilt paper \par ``Islamic technoscience'' in Southeast Asia (Fischer 2016) produces research on ritual cleansing. Students at a public Islamic university18 in Indonesia, for example, have written theses on the ideal mixture of kaolin and bentonite clays for ritual cleansing, discussing the clays' viscosity, emulsion stability, sedimentation volume, and antibacterial properties. These theses cite not only chemistry and microbiology texts but also dozens of contemporary shariah scholars as authoritative sources on ritual purity. Halalization is thus opening new paths for scientists to advance fiqh-minded conceptions of purity and piety through their research.'' (Calder, 2020, p. 348) \par ``This configuration differs radically from the illiberal model of economic Islamization, in which the state made such decisions. With halalization, an elective affinity emerges between the fiqh-minded subjectivity of consumers and a neoliberal subjectivity of twenty-first-century market society, in which ethical consumers are encouraged to educate themselves and take responsibility for navigating a world of interconnected risks and novel anxieties'' (Calder, 2020, p. 354) use for guilt paper \par ``Rudnyckyj, Daromir. 2014. ``Economy in Practice: Islamic Finance and the Problem of Market Reason.'' American Ethnologist 41(1):110--27.'' (Calder, 2020, p. 360)},
	number = {4},
	pages = {334--361},
	publisher = {SAGE Publications Inc},
	shortjournal = {Sociological Theory},
	shorttitle = {Halalization},
	title = {Halalization: {{Religious Product Certification}} in {{Secular Markets}}},
	url = {https://doi.org/10.1177/0735275120973248},
	urldate = {2022-05-29},
	volume = {38},
	bdsk-url-1 = {https://doi.org/10.1177/0735275120973248}}

