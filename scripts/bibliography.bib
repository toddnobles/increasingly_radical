	journaltitle = {The Quarterly Journal of Economics},
	number = {3},
	pages = {1187--1234},
	publisher = {Oxford University Press},
	shorttitle = {The {{Fox News Effect}}},
	title = {The {{Fox News Effect}}: {{Media Bias}} and {{Voting}}},
	url = {https://www.jstor.org/stable/25098871},
