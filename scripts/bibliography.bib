	journaltitle = {European Journal of Political Research},
	langid = {english},
	number = {4},
	pages = {516--542},
	shorttitle = {How News Content Influences Anti-Immigration Attitudes},
	title = {How News Content Influences Anti-Immigration Attitudes: {{Germany}}, 1993--2005},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1475-6765.2009.01831.x},
	urldate = {2022-03-10},
