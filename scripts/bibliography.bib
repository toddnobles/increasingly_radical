@article{becherLandInequalitiesUnited2023,
	abstract = {Outside of Indigenous studies, sociologists tend to treat land in the United States as governed exclusively by an entrenched private-property regime: Land is a commodity and an object for individual control. This review presents land in the United States as more complicated and contingent. State law and related ideas comprise a dominant, hegemonic power that often appears unitary, coherent, and all-powerful. And yet, land takes on diverse cultural, legal, and material forms---within written laws and official practices, and in informal practices and cultures. Inequalities emerge as these different forms of land provide power, material goods, and a sense of belonging to some while excluding others, and as marginalized groups assert access, security, and meaning in land. Three sections of the review---land tenures, land regulations, and social identities---present conversations about how human relationships with land diverge from the treatment of land as a settled object for individual control.},
	author = {Becher, Debbie},
	date = {2023},
	doi = {10.1146/annurev-soc-030420-122704},
	file = {Becher_2023_Land Inequalities in the United States421-441.pdf},
	journaltitle = {Annual Review of Sociology},
	keywords = {/unread,economy,environment,law,property,rural,urban},
	number = {1},
	pages = {421--441},
	title = {Land {{Inequalities}} in the {{United States}}},
	url = {https://doi.org/10.1146/annurev-soc-030420-122704},
	urldate = {2023-09-06},
	volume = {49},
	bdsk-url-1 = {https://doi.org/10.1146/annurev-soc-030420-122704}}

@article{beckerCausesConsequencesProtestant2016,
	abstract = {The Protestant Reformation is one of the defining events of the last millennium. Nearly 500 years after the Reformation, its causes and consequences have seen a renewed interest in the social sciences. Research in economics, sociology, and political science increasingly uses detailed individual-level, city-level, and regional-level data to identify drivers of the adoption of the Reformation, its diffusion pattern, and its socioeconomic consequences. We take stock of this research, pointing out what we know and what we do not know and suggesting the most promising areas for future research.},
	author = {Becker, Sascha O. and Pfaff, Steven and Rubin, Jared},
	date = {2016-10},
	doi = {10.1016/j.eeh.2016.07.007},
	file = {Becker et al_2016_Causes and consequences of the Protestant Reformation.pdf},
	issn = {00144983},
	journaltitle = {Explorations in Economic History},
	langid = {english},
	note = {\textbf{Extracted Annotations (10/25/2021, 4:59:04 PM)} \par "Tawney's most influential critique was that important capitalist" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "institutions such as banking and long-distance credit preceded the Reformation" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "Kurt Samuelsson (1957, 1993), who disputed three basic claims of the Weber" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "thesis: (1) that the practices of modern capitalism preceded the Reformation; (2) that Weber misunderstood and ex-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "aggerated the influence of Puritanism; and (3) that capitalism did not require worldly asceticism. Like Tawney, Samuelsson" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "argued that there is abundant evidence that capitalism had already taken firm root prior to the 16th century. He attacked" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "Weber's historical generalizations and his use of empirical evidence, showing that he misstated the supposed advantage" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "that modern Protestants enjoyed in income and education. Samuelsson argued that Calvinists were far more ambivalent" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "toward capitalist ethics than Weber allowed. He also claimed that Protestant thriftiness could not account for sufficient" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "accumulation to have made a difference in capitalist breakthrough.4" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=5}{Becker et al 2016:5}) \par "why did Europe have its Reformation at all? Why did the Reformation spread when and where it did?" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=6}{Becker et al 2016:6}) \par "Although there is much to support the idea of a longed-for reformation, the contemporary understanding is that the" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "Catholic Church was in some regards popular, vital, well entrenched, and serving the needs of its diverse flock" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "There can be little question that the Roman Church faced a dilemma in the early 16th century. Expanding trade and" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "economic development in the 15th and early 16th centuries made it difficult for the Church as a universal supplier of" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "religious goods to meet the demands of increasingly diverse consumers. Popular Catholicism became inadequate or even" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "objectionable to the increasingly literate townsmen. Because of its efforts to exploit popular piety, they regarded the Church" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "as too tolerant of "superstition" and of overly emotional religious practices that lacked Scriptural foundations and seemed to" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "dabble in the realm of the magical" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=8}{Becker et al 2016:8}) \par "The historical picture of the robustness of the Catholic monopoly in the early 16th century is thus a mixed one: The" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "Roman Church was resourceful and well entrenched but, particularly in Central Europe, had substantial liabilities and" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "political vulnerabilities. The key task facing social scientists who want to understand the Reformation is to move beyond" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "broad generalizations and macro-level trends, on the one hand, and, on the other, descriptions of particular towns and" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "regions. The question becomes, in the face of a general Protestant rebellion that very swiftly took off in the decade after" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "1517, why did the Catholic monopoly remain in place in some locations while being overturned in others? Why did some" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "of the likely candidates for the Reformationfrom the perspective of the literatureremain Catholic while seemingl" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=9}{Becker et al 2016:9}) \par "although for different reasons than those espoused by Weber" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=13}{Becker et al 2016:13}) \par "Recent research largely con-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=13}{Becker et al 2016:13}) \par "firms the Weberian insight that the Reformation played an important role in Europe's economic and political trajectory," (\href{zotero://open-pdf/library/items/JT9G6EJW?page=13}{Becker et al 2016:13}) \par "They conclude" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=13}{Becker et al 2016:13}) \par "that their findings are more consistent with a human capital theory of Protestant economic history than with a Protestant" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=13}{Becker et al 2016:13}) \par "(work) ethic {\`a} la Max Webe" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=13}{Becker et al 2016:13}) \par "What the studies in this and the previous subsection show is that human capital has been highlighted as a prime" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=19}{Becker et al 2016:19}) \par "competing hypothesis for the differential economic success of Protestants and Catholics. However, that does not necessarily" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=19}{Becker et al 2016:19}) \par "mean that a Weberian Protestant (work) ethic thesis is outright wrong. In fact, there is evidence for Germany and Swit-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=19}{Becker et al 2016:19}) \par "zerland, as well as from cross-country regressions, that Protestants work more hours, have less of a preference for leisure" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=19}{Becker et al 2016:19}) \par "and suffer more displeasure when they are unemployed, all of which are consistent with the idea that Protestants (want to)" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=19}{Becker et al 2016:19}) \par "work harder." (\href{zotero://open-pdf/library/items/JT9G6EJW?page=19}{Becker et al 2016:19}) \par "Arru{\~n}ada (2010) proposes another twist on the Weberian hypothesis, suggesting that the distinguishing feature of" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "Protestantism was its social ethic. He argues that Reformers were more supportive of secular political and legal institutions" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "than were Catholics, often because they needed political help in their fight against Catholicism. He also suggests that Re-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "formers placed less emphasis on the role of the family and instead wanted Christians to treat strangers equally well. He" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "employs evidence based on cross-country survey data from the International Social Survey Program (ISSP). His results are" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "consistent with the idea that Protestantism is conducive to capitalist economic development, not by the direct psychological" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "route of the Weberian work ethic, but rather by promoting an alternative social ethic that facilitates impersonal trade." (\href{zotero://open-pdf/library/items/JT9G6EJW?page=20}{Becker et al 2016:20}) \par "The first is that long-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "lasting social and cultural upheavals are possible when a confluence of supply-side features coincide to permit challengers" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "to the old regime to become sufficiently entrenched. Demand for reform existed for centuries prior to Luther. However, the" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "reformers of the early 16th century were successful for several reasons having to do with timing and setting. These reasons" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "include recent advances in information technology (the printing press); outside threats (the Ottomans) that sidetracked the" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "attention and resources of the papacy and Habsburgs; the heterogeneous and decentralized nature of the HRE; and net-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "works of sympathetic university students and intellectuals placed in strategic locations throughout the HRE." (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "This literature's second general lesson is that religion can influence long-run economic outcomes. This is not necessarily" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "in a Weberian sense of value orientations, but rather in that religious institutions and religious doctrines affect a host of" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "variables that are important for economic growth, including human capital, governance, entrepreneurship, social ethic," (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "social networks, and missionary work. The literature suggests that each of these variables were encouraged by Protes-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "tantism ideology. Finally, the new literature points to a host of new mechanisms connecting the Reformation to positive" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "economic outcomes. Where the Reformation took hold, it fundamentally altered political, legal, and social institutions," (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "resulting in the ascendancy of parliaments, the secularization of law, increased emphasis on education, and the precursors" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "of the welfare state. The long-run economic effects of the Reformation are therefore only understandable when considered" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=23}{Becker et al 2016:23}) \par "important falsification tests for those works claiming the Reformation entailed long-run socioeconomic effects" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=24}{Becker et al 2016:24}) \par "For example, the boundaries of western Poland changed numerous times throughout its history." (\href{zotero://open-pdf/library/items/JT9G6EJW?page=24}{Becker et al 2016:24}) \par "Many of these cities, such as Wroclaw and Szczecin, were part of the HRE in the 16th century and became Protestant, while" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=24}{Becker et al 2016:24}) \par "nearby neighboring cities remained Catholic." (\href{zotero://open-pdf/library/items/JT9G6EJW?page=24}{Becker et al 2016:24}) \par "Many of the long-run effects found in the literature must have" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=24}{Becker et al 2016:24}) \par "worked via short-run channels. Digging deeper into the shorterand medium-run effects of the Reformation could provide" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=24}{Becker et al 2016:24}) \par "adopted in Africa, Latin America, and Asia" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=25}{Becker et al 2016:25}) \par "Future work might continue to explore if Protestantism influences eco-" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=25}{Becker et al 2016:25}) \par "nomic development through attitudinal, institutional, or human-capital mechanisms in countries where it has been widely" (\href{zotero://open-pdf/library/items/JT9G6EJW?page=25}{Becker et al 2016:25})},
	pages = {1--25},
	shortjournal = {Explorations in Economic History},
	title = {Causes and Consequences of the {{Protestant Reformation}}},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0014498316301085},
	urldate = {2021-10-25},
	volume = {62},
	bdsk-url-1 = {https://linkinghub.elsevier.com/retrieve/pii/S0014498316301085},
	bdsk-url-2 = {https://doi.org/10.1016/j.eeh.2016.07.007}}

@article{beckerHasWorldReally2013,
	abstract = {In his PAA presidential address and corresponding article in Demography, David Lam (Demography 48:1231--1262, 2011) documented the extraordinary progress of humankind---vis-{\`a}-vis poverty alleviation, increased schooling, and reductions in mortality and fertility---since 1960 and noted that he expects further improvements by 2050. However, although Lam briefly covered the problems of global warming and pollution, he did not address several other major environmental problems that are closely related to the rapid human population growth in recent decades and to the progress he described. This commentary highlights some of these problems to provide a more balanced perspective on the situation of the world. Specifically, humans currently are using resources at an unsustainable level. Groundwater depletion and overuse of river water are major problems on multiple continents. Fossil fuel resources and several minerals are being depleted. Other major problems include deforestation, with the annual forest clearing globally estimated to be an area the size of New York State; and species extinction, with rates estimated to be 100 to 1,000 times higher than background rates. Principles of ecological economics are presented that allow an integration of ecology and economic development and better potential for preservation of the world for future generations.},
	author = {Becker, Stan},
	date = {2013-12-01},
	doi = {10.1007/s13524-013-0236-y},
	file = {Becker_2013_Has the iWorld-i Really Survived the Population Bomb2173-2181.pdf},
	issn = {0070-3370, 1533-7790},
	journaltitle = {Demography},
	langid = {english},
	number = {6},
	pages = {2173--2181},
	shorttitle = {Has the {{{\mkbibemph{World}}}} {{Really Survived}} the {{Population Bomb}}?},
	title = {Has the {{{\mkbibemph{World}}}} {{Really Survived}} the {{Population Bomb}}? ({{Commentary}} on ``{{How}} the {{World Survived}} the {{Population Bomb}}: {{Lessons From}} 50 {{Years}} of {{Extraordinary Demographic History}}'')},
	url = {https://read.dukeupress.edu/demography/article/50/6/2173/169605/Has-the-World-Really-Survived-the-Population-Bomb},
	urldate = {2024-10-07},
	volume = {50},
	bdsk-url-1 = {https://read.dukeupress.edu/demography/article/50/6/2173/169605/Has-the-World-Really-Survived-the-Population-Bomb},
	bdsk-url-2 = {https://doi.org/10.1007/s13524-013-0236-y}}

@article{beckerNobelLectureEconomic1993,
	abstract = {An important step in extending the traditional theory of individual rational choice to analyze social issues beyond those usually considered by economists is to incorporate into the theory a much richer class of attitudes, preferences, and calculations. While this approach to behavior builds on an expanded theory of individual choice, it is not mainly concerned with individuals. It uses theory at the micro level as a powerful tool to derive implications at the group or macro level. The lecture describes the approach and illustrates it with examples drawn from my past and current work.},
	author = {Becker, Gary S.},
	date = {1993},
	eprint = {2138769},
	eprinttype = {jstor},
	file = {Becker_1993_Nobel Lecture385-409.pdf},
	issn = {0022-3808},
	journaltitle = {Journal of Political Economy},
	keywords = {ObsCite},
	note = {\section{Annotations\\ (4/5/2022, 3:10:01 PM)} \par ``The analysis assumes that individuals maximize welfare as they conceive it, whether they be selfish, altruistic, loyal, spiteful, or masochistic. Their behavior is forward-looking, and it is also assumed to be consistent over time'' (Becker, 1993, p. 386) \par ``Unfortunately, these studies do not use the correct procedure for assessing whether banks discriminate, which is to determine whether loans are more profitable to blacks (and other minorities) than to whites. This requires examining the default and other payback experiences of loans, the interest rates charged, and so forth. If banks discriminate against minority applicants, they should earn greater profits on the loans actually made to them than on those to whites. The reason is that discriminating banks would be willing to accept marginally profitable white applicants who would be turned down if they were black'' (Becker, 1993, p. 389) this seems to mess a larger understanding of discrimination and exclusion from opportunity \par ``Economists have too narrow a perspective on commitments. "Manipulating" the experiences of others to influence their preferences may appear to be inefficient and fraught with uncertainty, but it can be the most effective way available to obtain commitment. Economic theory, especially game theory, needs to incorporate guilt, affection, and related attitudes into preferences in order to have a deeper understanding of when commitments are "credible"'' (Becker, 1993, p. 400) \par ``This means that programs such as social security that significantly help the elderly would encourage family members to drift apart emotionally, not by accident but as maximizing responses to those policies'' (Becker, 1993, p. 401) \par ``Since the economic, or rational choice, approach to behavior builds on a theory of individual decisions, criticisms of this theory usually concentrate on particular assumptions about how these decisions are made. Among other things, critics deny that individuals act consistently over time, and question whether behavior is forward-looking, particularly in situations that differ significantly from those usually considered by economists-such as those involving criminal, addictive, family, or political behavior. This is not the place to go into a detailed response to the criticisms, so I simply assert that no approach of comparable generality has yet been developed that offers serious competition to rational choice theory'' (Becker, 1993, p. 402) does it have to be a general approach do we need something that answers all questions of human behavior in one theory. who benefits or would you use benefit from being able to model human behavior as one all encompassing theory \par ``Unfortunately, these studies do not use the correct procedure for assessing whether banks discriminate, which is to determine whether loans are more profitable to blacks (and other minorities) than to whites. This requires examining the default and other payback experiences of loans, the interest rates charged, and so forth. If banks discriminate against minority applicants, they should earn greater profits on the loans actually made to them than on those to whites. The reason is that discriminating banks would be willing to accept marginally profitable white applicants who would be turned down if they were black'' (Becker, 1993, p. 389) this seems to mess a larger understanding of discrimination and exclusion from opportunity},
