@article{rohdeAssignPeopleTheir2023,
	abstract = {The political ideal of meritocracy has increasingly come under attack, but con- tinues to figure centrally in the national identity of many self-declared liberal democracies, including Germany. A question which remains underexplored is where and how meritocratic thinking becomes ingrained in individuals to account for its pervasive appeal. This paper argues that the school grade plays a pivotal role. Ethnographic fieldwork in a German comprehensive school revealed that students consistently defended grading even though they often received very low grades themselves. The pupils' arguments evoked core merito- cratic motifs of betterment, hierarchy and social ascent. In order to explain this finding, grades are situated in a wider theory of quantification, arguing that it is in their capacity as numbers that grades encourage meritocratic thinking.},
	author = {Rohde, No{\"e}lle},
	date = {2023-07-11},
	doi = {10.1080/03085147.2023.2225346},
	file = {Rohde_2023_`To assign people their place in society'1-25.pdf},
	issn = {0308-5147, 1469-5766},
	journaltitle = {Economy and Society},
	keywords = {/unread},
	langid = {english},
	pages = {1--25},
	shortjournal = {Economy and Society},
	shorttitle = {`{{To}} Assign People Their Place in Society'},
	title = {`{{To}} Assign People Their Place in Society': {{School}} Grades and the Quantification of Merit},
	url = {https://www.tandfonline.com/doi/full/10.1080/03085147.2023.2225346},
	urldate = {2023-08-25},
	bdsk-url-1 = {https://www.tandfonline.com/doi/full/10.1080/03085147.2023.2225346},
