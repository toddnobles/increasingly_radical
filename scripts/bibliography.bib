	keywords = {democracy,economic growth,GDP,nighttime lights},
	langid = {english},
	location = {Rochester, NY},
	number = {ID 3093296},
	title = {How {{Much Should We Trust}} the {{Dictator}}'s {{GDP Growth Estimates}}?},
	type = {SSRN Scholarly Paper},
