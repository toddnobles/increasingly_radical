	series = {Working {{Paper Series}}},
	shorttitle = {{{COVID-19}} and {{Remote Work}}},
	title = {{{COVID-19}} and {{Remote Work}}: {{An Early Look}} at {{US Data}}},
	type = {Working Paper},
	url = {https://www.nber.org/papers/w27344},
	urldate = {2022-12-11},
	bdsk-url-1 = {https://www.nber.org/papers/w27344},
	bdsk-url-2 = {https://doi.org/10.3386/w27344}}

