	journaltitle = {Sociology Compass},
	langid = {english},
	number = {2},
	pages = {295--309},
	shorttitle = {The {{Immigration Industrial Complex}}},
	title = {The {{Immigration Industrial Complex}}: {{Why We Enforce Immigration Policies Destined}} to {{Fail}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1751-9020.2008.00193.x},
	urldate = {2022-03-10},
