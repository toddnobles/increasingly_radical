	issn = {0038-4941},
	journaltitle = {Social Science Quarterly},
	number = {4},
	pages = {917--937},
	publisher = {Wiley},
	shorttitle = {Rebuilding or {{Intruding}}?},
	title = {Rebuilding or {{Intruding}}? {{Media Coverage}} and {{Public Opinion}} on {{Latino Immigration}} in {{Post-Katrina Louisiana}}},
	url = {http://www.jstor.org/stable/42956556},
	urldate = {2022-03-10},
