@article{mannasooWorkingHoursGender2022,
	abstract = {Using the 2015 American Working Conditions Survey (AWCS), the study investigates gender wage differentials conditional on weekly working hours. Wage estimations controlling for the labour supply at the extensive and intensive margins confirm the presence of a female wage gap. A triangular joint estimation framework that identifies the wage determinants and the gender wage gap controls for the labour supply both in reservation hours and in actual working hours. The joint estimation of hourly wages, desired and actual weekly working hours, with the wages-hours relationship allowed to take non-linear forms, reduces the gender wage differentials and renders the gap insignificant for jobs that do not permit remote work.},
	annotation = {0 citations (Crossref) [2022-12-10]},
