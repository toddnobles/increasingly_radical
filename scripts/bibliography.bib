	number = {2},
	pages = {193--228},
	publisher = {Cambridge University Press},
	title = {Distribution and {{Redistribution}} in {{Postindustrial Democracies}}},
	url = {http://www.cambridge.org/core/journals/world-politics/article/abs/distribution-and-redistribution-in-postindustrial-democracies/23EB837FA0B2DA7F5F3582C3BD54ACB9},
	urldate = {2021-11-16},
