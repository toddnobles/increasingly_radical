@article{newmanAcculturatingContextsAnglo2013,
	abstract = {This article explores the impact of novel change in the ethnic composition of Americans' local context on their attitudes toward immigrants and immigration policy preferences. Adapting the ``defended-neighborhoods hypothesis'' regarding residential integration and black-white interracial relations to the context of immigration and intercultural relations, this article advances the acculturating-contexts hypothesis. This hypothesis argues that a large influx of an immigrant group will activate threat among white citizens when it occurs in local areas where the immigrant group had largely been absent. This theoretical argument is explored within the context of Hispanic immigration and tested using national survey and census data. This article demonstrates that over-time growth in local Hispanic populations triggers threat and opposition to immigration among whites residing in contexts with few initial Hispanics but reduces threat and opposition to immigration among whites residing in contexts with large preexisting Hispanic populations.},
	annotation = {189 citations (Crossref) [2024-05-04]},
	author = {Newman, Benjamin J.},
	date = {2013},
	doi = {10.1111/j.1540-5907.2012.00632.x},
	file = {Newman_2013_Acculturating Contexts and Anglo Opposition to Immigration in the United States374-390.pdf;../../../Zotero/storage/ELC2XJCJ/j.1540-5907.2012.00632.html},
	issn = {1540-5907},
	journaltitle = {American Journal of Political Science},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/14/2022, 4:54:09 PM)} \par "This article demonstrates that over-time growth in local Hispanic populations triggers threat and opposition to immigration among whites residing in contexts with few initial Hispanics but reduces threat and opposition to immigration among whites residing in contexts with large preexisting Hispanic populations." (\href{zotero://open-pdf/library/items/4DYA7WE7?page=1}{Newman 2013:374}) \par "The diminishing marginal effect of immigrant growth (when moving from low to high initial immigrant-population contexts) hypothesized for cultural threat perceptions should not hold for noncultural threat perceptions. Noncultural threat perceptions, such as those pertaining to the economy or crime, should either have no relationship to ethnic context or should be unconditionally enhanced by immigrant growth." (\href{zotero://open-pdf/library/items/4DYA7WE7?page=6}{Newman 2013:379}) \par "H3: The diminishing marginal effect of immigrant growth (when moving from low to high initial immigrant-population contexts) hypothesized for cultural threat perceptions should not hold for noncultural threat perceptions. Noncultural threat perceptions, such as those pertaining to the economy or crime, should either have no relationship to ethnic context or should be unconditionally enhanced by immigrant growth." (\href{zotero://open-pdf/library/items/4DYA7WE7?page=6}{Newman 2013:379})},
	number = {2},
	pages = {374--390},
	title = {Acculturating {{Contexts}} and {{Anglo Opposition}} to {{Immigration}} in the {{United States}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1540-5907.2012.00632.x},
	urldate = {2022-03-10},
	volume = {57},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/abs/10.1111/j.1540-5907.2012.00632.x},
	bdsk-url-2 = {https://doi.org/10.1111/j.1540-5907.2012.00632.x}}

@article{newmanFalseConsciousnessClass2015,
	abstract = {Existing research analyzes the effects of cross-national and temporal variation in income inequality on public opinion; however, research has failed to explore the impact of variation in inequality across citizens' local residential context. This article analyzes the impact of local inequality on citizens' belief in a core facet of the American ethos---meritocracy. We advance conditional effects hypotheses that collectively argue that the effect of residing in a high-inequality context will be moderated by individual income. Utilizing national survey data, we demonstrate that residing in more unequal counties heightens rejection of meritocracy among low-income residents and bolsters adherence among high-income residents. In relatively equal counties, we find no significant differences between high- and low-income citizens. We conclude by discussing the implications of class-based polarization found in response to local inequality with respect to current debates over the consequences of income inequality for American democracy.},
	annotation = {130 citations (Crossref) [2024-05-04]},
	author = {Newman, Benjamin J. and Johnston, Christopher D. and Lown, Patrick L.},
	date = {2015},
	doi = {10.1111/ajps.12153},
	file = {Newman et al_2015_False Consciousness or Class Awareness.pdf;../../../Zotero/storage/JHKBBT7P/ajps.html},
	issn = {1540-5907},
	journaltitle = {American Journal of Political Science},
	keywords = {ObsCite},
	langid = {english},
	number = {2},
	pages = {326--340},
	shorttitle = {False {{Consciousness}} or {{Class Awareness}}?},
	title = {False {{Consciousness}} or {{Class Awareness}}? {{Local Income Inequality}}, {{Personal Economic Position}}, and {{Belief}} in {{American Meritocracy}}},
	url = {http://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12153},
	urldate = {2021-11-17},
	volume = {59},
	bdsk-url-1 = {http://onlinelibrary.wiley.com/doi/abs/10.1111/ajps.12153},
	bdsk-url-2 = {https://doi.org/10.1111/ajps.12153}}

@article{newmanGroupSizeChange2014,
	abstract = {Leading opinion research on immigration has begun to move from size-based to change-based measures of citizens' ethnic context. This shift is based on the theoretical assumption that over-time growth in immigrant populations is more likely to capture citizens' attention than their current size. At present, there is no empirical evidence supporting this assumption. This article demonstrates that while the size of local immigrant populations exerts virtually no effect on perceived immigration, over-time growth strongly influences citizens' perceptions of immigration into their community. In addition, our analyses illuminate the differential contribution of growth in local Hispanic and Asian populations to perceived immigration.},
	annotation = {64 citations (Crossref) [2024-05-04]},
	author = {Newman, Benjamin J. and Velez, Yamil},
	date = {2014-06-01},
	doi = {10.1177/1065912913517303},
	file = {Newman_Velez_2014_Group Size versus Change293-303.pdf},
	issn = {1065-9129},
	journaltitle = {Political Research Quarterly},
	keywords = {contextual effect,ethnic change,immigration,ObsCite,public opinion},
	langid = {english},
	note = {\section{Annotations\\ (10/4/2023, 10:51:27 AM)} \par ``Indeed, Hopkins argues that the empirical weakness of size-based measures may be due to the failure of one of the key preconditions for threat to obtain: citizens' perception of their ethnic context.'' (Newman and Velez, 2014, p. 294) \par ``whether (1) citizens are ``receiving the treatment'' (i.e., aware of immigrant population growth) and (2) whether the ``treatment effect'' of immigrant growth surpasses any observed for immigrant population size.'' (Newman and Velez, 2014, p. 295) \par ``we draw upon the 2006 Poll on Immigration conducted by the Pew Research Center for the People \& the Press and the Pew Hispanic Center. This poll is a nationally representative survey of the adult American population conducted by telephone between February 8 and March 7, and contains a total sample size of N = 2,000.'' (Newman and Velez, 2014, p. 295) \par ``itizens' perception of the amount of recent immigration in their local area strongly tracks with objective growth in the local foreign-born population. Consistent with past research on immigration that emphasizes the strong connection between Hispanic immigration and the perception of immigration-related threats, our analysis finds that citizens' perception of immigration center on changes in local Hispanic populations, rather than the second most numerous immigrant group---Asians.'' (Newman and Velez, 2014, p. 299)},
