	pages = {384--438},
	publisher = {The University of Chicago Press},
	shorttitle = {Money and {{Meaning}} in the {{Climate Change Debate}}},
	title = {Money and {{Meaning}} in the {{Climate Change Debate}}: {{Organizational Power}}, {{Cultural Resonance}}, and the {{Shaping}} of {{American Media Discourse}}},
	url = {https://www.journals.uchicago.edu/doi/abs/10.1086/726747},
	urldate = {2024-04-10},
	volume = {129},
	bdsk-url-1 = {https://www.journals.uchicago.edu/doi/abs/10.1086/726747},
