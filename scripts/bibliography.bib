	shortjournal = {Am Sociol Rev},
	shorttitle = {We {{Built This}}},
	title = {We {{Built This}}: {{Consequences}} of {{New Deal Era Intervention}} in {{America}}'s {{Racial Geography}}},
	url = {http://journals.sagepub.com/doi/10.1177/0003122420948464},
	urldate = {2022-04-21},
