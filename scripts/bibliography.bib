	number = {3},
	pages = {377--413},
	shortjournal = {Journal of Consumer Culture},
	shorttitle = {Emotions, {{Imagination}} and {{Consumption}}},
	title = {Emotions, {{Imagination}} and {{Consumption}}: {{A}} New Research Agenda},
	url = {http://journals.sagepub.com/doi/10.1177/1469540509342053},
	urldate = {2023-05-16},
	volume = {9},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1177/1469540509342053},
