	number = {4},
	pages = {485--501},
	shortjournal = {Sociological Perspectives},
	shorttitle = {Americans' {{Views}} on {{Immigration Policy}}},
	title = {Americans' {{Views}} on {{Immigration Policy}}: {{Testing}} the {{Role}} of {{Threatened Group Interests}}},
	url = {http://spx.sagepub.com/lookup/doi/10.2307/1389655},
	urldate = {2022-03-10},
	volume = {44},
