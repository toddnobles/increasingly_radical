@article{thomask.rudelPoliticalEconomyEnvironment2011,
	abstract = {Sociological theories about the political economy of the environment have appeared in two waves. The first wave has a productivist orientation, showing how the normal workings of industrial production damage the environment. It includes impact theories (IPAT and STIRPAT), the treadmill of production, growth machine theories, and resource extraction/ecologically unequal exchange theories. A second wave of theories focuses on environmental destruction and the social movements that challenge the agents of destruction. To accommodate popular unrest over environmental declines, states have typically created corporatist policymaking circles that include long-established, moderate environmental nongovernmental organizations and exclude disadvantaged and unorganized peoples. Advocates for environmental justice and sustainable consumption have attempted to mobilize the excluded, articulating a just sustainability theory that addresses both concerns. Current controversies in the field focus on the predictive power ...},
	author = {{Thomas K. Rudel} and {J. Timmons Roberts} and {JoAnn Carmin}},
	date = {2011},
	doi = {10.1146/annurev.soc.012809.102639},
	journaltitle = {Review of Sociology},
	keywords = {/unread},
	shortjournal = {Review of Sociology},
	title = {Political {{Economy}} of the {{Environment}}},
	bdsk-url-1 = {https://doi.org/10.1146/annurev.soc.012809.102639}}

@incollection{thomasLiberalRepublicanEconomicSystem2016,
	abstract = {This chapter presents the history of the ideal of a property-owning democracy. It opens by justifying this tradition's focus on capital, before examining the internally complex history of the ideal. The egalitarian form of a property-owning democracy reaches its culmination in the work of mid-twentieth-century economist James Meade. The transposition of his ideas into John Rawls's work is described. It is then argued that these ideas have continuing relevance to policies that address the New Inequality of the present day. In particular, the views of Meade and Rawls are compared and contrasted with those of a recent predistributionist, Jacob S. Hacker, and a proponent of an expanded form of welfare-state capitalism for the United States, Lane Kenworthy. Only Meade and Rawls seek globally to restructure the market and incentives so as to make domination of one economic actor by another structurally impossible.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0006},
	editor = {Thomas, Alan},
	isbn = {978-0-19-060211-6},
	keywords = {/unread},
	pages = {0},
	publisher = {Oxford University Press},
	title = {A {{Liberal-Republican Economic System}}},
	url = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0006},
	urldate = {2024-11-27},
	bdsk-url-1 = {https://doi.org/10.1093/acprof:oso/9780190602116.003.0006}}

@incollection{thomasLiberalRepublicanismBasicLiberties2016,
	abstract = {John Rawls issued a fair value proviso for the political liberties alone to avoid the Marxist critique that the formal equality granted to all citizens by liberalism is practically undermined by the material inequality permitted under Rawls's principles. It is argued that the republican component of liberal-republicanism offers a more robust defense of the political liberties than Rawls's ``insulation strategy'' of keeping money out of politics. By presenting the example of an authoritarian form of capitalism under which some citizens sacrifice some of their basic liberties further to dominate other social groups, it is argued that only a property-owning democracy places a limit on capital-based inequalities. So the commitment to a property-owning democracy can be derived from the fair value proviso; it is then shown that it also follows from the fair equality of opportunity principle. So a property-owning democracy is derivable from all of Rawls's principles.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0004},
	editor = {Thomas, Alan},
	isbn = {978-0-19-060211-6},
