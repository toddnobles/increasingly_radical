@article{greenStigmatizedImmigrantsRadical2016,
	abstract = {This study examines the interplay between presence of stigmatized immigrants, threat, and inter group contact that underlies radical right voting (voting propensity and actual district-level vote results). On the one hand, low-status immigrants are often stigmatized and depicted as threats. Thus, presence of stigmatized immigrants should heighten threat perceptions, thereby increasing radical right voting. On the other hand, as positive contact with stigmatized immigrants is known to reduce anti-immigrant prejudice, it should also attenuate radical right voting. As predicted, multilevel path analyses with the Swiss Election Studies 2011 data (N = 1,736 respondents in 136 districts) revealed that the proportion of stigmatized immigrants (from former Yugoslavia and Albania) in districts heightened perceived threat. Threat perceptions, in turn, increased propensity to vote for the Swiss People's Party, the major radical right party. In contrast, experiencing positive, everyday contact with former Yugoslav and Albanian immigrants reduced voting propensity through attenuated threat perceptions. Contact and threat perceptions were also related to the actual vote through voting propensity.},
	annotation = {61 citations (Crossref) [2024-05-04]},
	author = {Green, Eva G. T. and Sarrasin, Oriane and Baur, Robert and Fasel, Nicole},
	date = {2016},
	doi = {10.1111/pops.12290},
	eprint = {44132902},
	eprinttype = {jstor},
	file = {Green et al_2016_From Stigmatized Immigrants to Radical Right Voting465-480.pdf},
	issn = {0162-895X},
	journaltitle = {Political Psychology},
	note = {\textbf{Extracted Annotations (3/15/2022, 5:00:00 PM)} \par "search, this study highlighted the interplay of contact and threat in explaining radical right voting. The presence of stigmatized immigrants increased threat perceptions and thereby radical right voting. Importantly, individuals with positive contact experiences perceived less threat and had fewer intentions to vote for the far-right. These findings underscore the importance of how diversity is portrayed in multicultural societies and of the encounters native citizens have with immigrants" (\href{zotero://open-pdf/library/items/C6JSGPN4?page=14}{Green et al 2016:478})},
	number = {4},
	pages = {465--480},
	shorttitle = {From {{Stigmatized Immigrants}} to {{Radical Right Voting}}},
	title = {From {{Stigmatized Immigrants}} to {{Radical Right Voting}}: {{A Multilevel Study}} on the {{Role}} of {{Threat}} and {{Contact}}},
	url = {http://www.jstor.org/stable/44132902},
	urldate = {2022-03-12},
	volume = {37},
	bdsk-url-1 = {http://www.jstor.org/stable/44132902},
	bdsk-url-2 = {https://doi.org/10.1111/pops.12290}}

