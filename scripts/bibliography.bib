@article{kennedyTwoCurrenciesRethinking2023,
	abstract = {Beginning with the marginalist revolution of the late nineteenth century, neoclassical economic theory developed by borrowing mathematical constructs from physics, but not the physics itself. Several scholars, including early ecological economists, recognized there was a need to incorporate energy and other resources into economic theory. In recent decades there have been attempts to fuse energy into aggregate neoclassical production functions, but these suffer from several challenges: they do not hold at an aggregate level; do not capture the dynamic evolution of the economy; ignore the universal flow of energy through all of the economy; and there is interdependency between variables. These challenges are largely addressed by energy-linked computable general equilibrium models, although their model formulations still understate the role of energy as the lifeblood of economies. Here I argue that the economy can simultaneously be studied in terms of physical units and monetary units. I contrast physical science and social science views on energy in economies, and demonstrate how thermodynamics and value theory can be used harmoniously with an example of the energy basis to capital formation in the United States. When used to study major transformation of energy systems, equations, or metrics, are required for each type of energy carrier in the economy.},
	author = {Kennedy, Christopher},
	date = {2023-12-01},
	doi = {10.1016/j.ecolecon.2023.107986},
	file = {Kennedy_2023_Two currencies -- Rethinking energy and the economy107986.pdf;../../../Zotero/storage/MSBA98JY/S0921800923002495.html},
	issn = {0921-8009},
	journaltitle = {Ecological Economics},
	keywords = {/unread,Biophysical economics,Capital formation,Neoclassical economics,Production function,Thermodynamics,Value theory},
	pages = {107986},
	shortjournal = {Ecological Economics},
	title = {Two Currencies -- {{Rethinking}} Energy and the Economy},
	url = {https://www.sciencedirect.com/science/article/pii/S0921800923002495},
	urldate = {2023-09-06},
	volume = {214},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/S0921800923002495},
	bdsk-url-2 = {https://doi.org/10.1016/j.ecolecon.2023.107986}}

