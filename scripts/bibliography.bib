	file = {Cho_Gimpel_2012_Geographic Information Systems and the Spatial Dimensions of American Politics.pdf},
	langid = {english},
	pages = {21},
	title = {Geographic {{Information Systems}} and the {{Spatial Dimensions}} of {{American Politics}}}}

