@article{mulderEffectFeedbackSupport2005,
	abstract = {When do people support sanctioning systems in social dilemmas? Sanctions increase collective efficiency, but have the disadvantage of restricting people's autonomy. This paper studies the effects of feedback about collective (in)efficiency and the influence of the presence or absence of a sanctioning system. The results show that, except after feedback about collective inefficiency, people were reluctant to support installation of a sanctioning system. When a sanctioning system was already present, however, sanction support was strong and not affected by feedback. Interestingly, the presence of a sanctioning system increased pessimism about attaining collective efficiency. This suggests that the mere presence of a sanctioning system creates the need to have that sanctioning system, and that installing one can have irreversible consequences.},
	author = {Mulder, Laetitia B. and family=Dijk, given=Eric, prefix=van, useprefix=true and Wilke, Henk A. M. and De Cremer, David},
	date = {2005-06-01},
