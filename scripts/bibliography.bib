	shortjournal = {J Health Soc Behav},
	shorttitle = {Why {{Your Doctor Didn}}'t {{Go}} to {{Class}}},
	title = {Why {{Your Doctor Didn}}'t {{Go}} to {{Class}}: {{Student Culture}}, {{High-Stakes Testing}}, and {{Novel Coupling Configurations}} in an {{Allopathic Medical School}}},
