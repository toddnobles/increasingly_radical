@incollection{zhouInternationalTradeNetwork2021,
	abstract = {This chapter discusses key contributions social network analysis (SNA) has made to knowledge about the international trade network (ITN). The existing literature applies SNA to the ITN in three distinct directions. The first line of inquiry attempts to substantiate the hierarchical structure of the ITN envisioned by world system theory. The second line of inquiry describes the topological structure and evolution of the ITN. The third line of inquiry employs various modeling techniques to explain why the ITN takes place as observed. The existing literature largely builds upon the gravity model borrowed from international economics but makes some improvements. It also makes use of estimating methods developed for network data such as the multivariate regression quadratic assignment procedure. In future research, instead of relying on the gravity model, it is promising to directly use such SNA models as the exponential random graph model to explain the ITN.},
	author = {Zhou, Min},
	booktitle = {The {{Oxford Handbook}} of {{Social Networks}}},
	date = {2021-01-14},
	doi = {10.1093/oxfordhb/9780190251765.013.36},
