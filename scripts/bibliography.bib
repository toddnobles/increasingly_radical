@incollection{thomasPluralisticCommonwealth2016,
	abstract = {For many commentators, workplace democracy lies at the very heart of a property-owning democracy. The chapter criticizes Samuel Freeman's suggestion that a democratic citizen must be given a right to workplace democracy; the associational democracy of G. A. Cohen and Elizabeth Anderson; and the neo-Corporatism of Waheed Hussain. This chapter continues the argument that while liberal-republicanism gives each worker the right to contest managerial decisions it does not mandate workplace control as of right. But if a workplace can be in a democratic deficit, then that deficit must be paid off somewhere: a liberal-republican conception of civil society is explained and defended. A property-owning democracy will, indirectly, shape the background distribution of social capital and contribute to, in Mark Warren's word, a balanced ``ecology'' of associations.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
	date = {2016-12-29},
	doi = {10.1093/acprof:oso/9780190602116.003.0009},
	editor = {Thomas, Alan},
