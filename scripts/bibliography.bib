	pages = {205--226},
	publisher = {Oxford University Press},
	shorttitle = {Interracial {{Contact}} and {{Black Racial Attitudes}}},
	title = {Interracial {{Contact}} and {{Black Racial Attitudes}}: {{The Contact Hypothesis}} and {{Selectivity Bias}}},
	url = {https://www.jstor.org/stable/2580629},
