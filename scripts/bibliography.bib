	file = {Bonica_2018_Inferring Roll-Call Scores from Campaign Contributions Using Supervised Machine830-848.pdf},
	issn = {0092-5853},
	journaltitle = {American Journal of Political Science},
	keywords = {/unread},
	number = {4},
	pages = {830--848},
	title = {Inferring {{Roll-Call Scores}} from {{Campaign Contributions Using Supervised Machine Learning}}},
	url = {https://www.jstor.org/stable/26598786},
	urldate = {2023-11-28},
