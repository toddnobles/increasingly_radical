@article{parkBeingCountedRemaining2021,
	abstract = {Organizations are often pressured to adopt and maintain institutionally supported practices. Why do some companies remain committed to these practices, despite high operational cost and widespread frustration with them? Although prior theorists have emphasized the importance of institutional pressure at the broader population level, less research attention has been paid to the abandonment of a practice as a result of resource dependence between a firm and market intermediaries. In this paper, we theorize intermediary coverage breadth and depth as two important structural indicators of resource dependence. Firms lacking in coverage breadth (as indicated by the degree of reporting by market intermediaries) and firms with deeper coverage (as evidenced by a prolonged relationship with market intermediaries) are less likely to abandon a practice due to an increase in power imbalance and mutual dependence within the firm-intermediary relationships. We also theorize how a firm's resource dependence, as determined by coverage structure, moderates the firm's sensitivity to (1) observed peer support for the practice, (2) the intermediary's expectation regarding the continued use of the practice, and (3) performance deviations that fail to meet intermediary expectations. Our empirical study of the abandonment of quarterly earnings guidance by U.S. public companies during 2001--2010 provides overall support for our theoretical arguments.},
	author = {Park, Sun Hyun and Patterson, Kelly},
	date = {2021-05},
	doi = {10.1287/orsc.2020.1401},
	file = {Park_Patterson_2021_Being Counted and Remaining Accountable544-567.pdf},
	issn = {1047-7039, 1526-5455},
	journaltitle = {Organization Science},
	keywords = {ObsCite},
	langid = {english},
	note = {\section{Annotations\\ (9/29/2022, 1:10:07 PM)} \par ``In the present study, we build on this insight to examine how the structure of the interaction between a firm and market intermediaries influences its decision to abandon an institutionally supported practice.'' (Park and Patterson, 2021, p. 545) \par ``Firms that lack coverage breadth become more dependent on intermediaries in the mediated market, seeking the possibility of being ``counted'' by intermediaries and thus remaining relevant to the final consumers. The other important feature of the firm-intermediary relationship is coverage depth, which is the length of the relationship between market intermediaries and the firm. This relationship forms the basis of market intermediaries' evaluation of the firm's current and future performance (Westphal and Clement 2008, Cohen et al. 2012, Washburn and Bromiley 2014). As the history of interaction grows, social ties become more embedded, which in turn increases the mutual dependence between a firm and the intermediaries and gives rise to the need for the firm to ``remain accountable'' to the requests of the intermediary (Lerner and Tetlock 1999,Jensen2006, Rogan and Greve 2015). Considering these two dimensions of coverage structure, we argue that a firm that is more narrowly covered or has a deeper set of relationships with the intermediaries is less likely to abandon an institutionally supported practice'' (Park and Patterson, 2021, p. 545) \par ``Hypothesis 1. The narrower the analyst coverage of the focal firm compared with its industry peers (relative lack of analyst coverage breadth), the less likely the focal firm will abandon QEG.'' (Park and Patterson, 2021, p. 549) how does the recent development of social media and trading apps that aggregate orders to offer zero trading costs change this dynamic does analyst coverage matter less if you can get your name out as a firm with interesting practices through other avenues? \par ``Thus, we expect that the deeper the coverage relationship, as captured by longer interaction histories between analysts and firm executives, the more important the relationship to the firm and the more likely QEG will be regarded as an element of the social exchange process. Consequently, coverage depth should increase the likelihood that the firm remains committed to QEG. We predict the following.'' (Park and Patterson, 2021, p. 550) \par ``Hypothesis 2. The deeper the analyst coverage of the focal firm compared with its industry peers, the less likely the focal firm will abandon the QEG.'' (Park and Patterson, 2021, p. 550) \par ``Accountability is defined as ``the implicit or explicit expectations that one may be called on to justify one's beliefs, feelings, and action to others'' (Lerner and Tetlock 1999, p. 255)'' (Park and Patterson, 2021, p. 550) \par ``Hypothesis 3. The (a) narrower and (b) deeper the analyst coverage of a focal firm compared with its industry peers, the less likely the firm's QEG abandonment decision will be influenced by the peer firms not providing QEG.'' (Park and Patterson, 2021, p. 551) \par ``Taken together, the reaction to dropped coverage following peer firms' abandonment will be most pronounced among more narrowly covered firms that are more dependent on intermediaries. This leads to the following hypothesis regarding analyst coverage breadth: how it moderates the relationship between analyst sanctions and the focal firm's QEG abandonment decision. Hypothesis 4. The narrower the analyst coverage of the focal firm compared with its industry peers, the more likely the firm's QEG abandonment decision will be influenced by reduced coverage among peers that had previously abandoned QEG.'' (Park and Patterson, 2021, p. 552) \par ``Hypothesis 5. The deeper the analyst coverage of the focal firm compared with its industry peers, the less likely the firm's QEG abandonment decision will be influenced by the negative earnings surprises.'' (Park and Patterson, 2021, p. 553) \par ``We chose 2001--2010 as our sampling frame, since norms and expectations regarding QEG provision significantly changed and the trend toward QEG issuance dramatically shifted after the passage of Regulation Fair Disclosure in August 2000.'' (Park and Patterson, 2021, p. 553) \par ``We first employed an event history model for our main analysis, predicting the timing until QEG abandonment among the sample companies in the risk set. We used Cox regression models with clustered standard errors around the firm (Table 2), after visually confirming the proportional hazard assumption for our dependent variable against Kaplan-Meier curves.'' (Park and Patterson, 2021, p. 556) \par ``Here, firms with relatively narrow or deep levels of intermediary coverage are less likely to abandon a practice that these experts support, due to the way coverage breadth and depth specifically shape this dependency.'' (Park and Patterson, 2021, p. 563) \par ``Second, our findings support our theory of how accountability pressure from intermediaries moderates a firm's sensitivity to the observed peer support of a practice, while at the same time moderating concern for intermediaries' expectations of continued use of a practice. We found that firms with narrower coverage were less likely to follow their peers' decisions to abandon QEG. However, these firms did become more sensitive to the negative outcomes of the peer behavior, especially analyst punishment for QEG abandonment. We also found that firms with deeper coverage were less likely to jeopardize this coverage relationship and abandon QEG, despite disruptive events, such as negative earnings surprises, that would otherwise strongly motivate firms to abandon the practice. Taken together, our theory and empirical findings help us better explain why some firms may remain committed to institutionally supported practices, despite the cost and widespread frustration associated with it.'' (Park and Patterson, 2021, p. 563) \par how does their argument differ from Zuckerman's that they portray as ``an arms-length'' relationship between market intermediaries and firms? \par f},
	number = {3},
	pages = {544--567},
	shortjournal = {Organization Science},
	shorttitle = {Being {{Counted}} and {{Remaining Accountable}}},
	title = {Being {{Counted}} and {{Remaining Accountable}}: {{Maintenance}} of {{Quarterly Earnings Guidance}} by {{U}}.{{S}}. {{Public Companies}}},
	url = {http://pubsonline.informs.org/doi/10.1287/orsc.2020.1401},
	urldate = {2022-09-27},
	volume = {32},
	bdsk-url-1 = {http://pubsonline.informs.org/doi/10.1287/orsc.2020.1401},
	bdsk-url-2 = {https://doi.org/10.1287/orsc.2020.1401}}

@book{parkerChangeTheyCan2014,
	abstract = {Are Tea Party supporters merely a group of conservative citizens concerned about government spending? Or are they racists who refuse to accept Barack Obama as their president because he's not white? Change They Can't Believe In offers an alternative argument---that the Tea Party is driven by the reemergence of a reactionary movement in American politics that is fueled by a fear that America has changed for the worse. Providing a range of original evidence and rich portraits of party sympathizers as well as activists, Christopher Parker and Matt Barreto show that the perception that America is in danger directly informs how Tea Party supporters think and act. In a new afterword, Parker and Barreto reflect on the Tea Party's recent initiatives, including the 2013 government shutdown, and evaluate their prospects for the 2016 election.},
	author = {Parker, Christopher S. and Barreto, Matt A.},
	date = {2014},
	file = {../../../Zotero/storage/43ERAKB8/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/77BCLVBR/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/AQ9EBZZS/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/C5SIV9XG/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/CVKFV2SV/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/G3KRPPY3/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/H4EUFAU8/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/LDV5W9ZA/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/S5RFDBIL/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/SDYB57HT/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/SNE4BFVQ/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/VFU6EVJ3/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/VNTAJUCV/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/VPF2ET23/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/Y9GLT4AC/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;../../../Zotero/storage/YJVKLVCV/Parker et al. - 2014 - Change They Can't Believe In The Tea Party and Re.pdf;Parker et al_2014_Change They Can't Believe In.pdf},
	isbn = {978-1-4008-5231-4},
	location = {Princeton},
	note = {\textbf{Extracted Annotations (3/15/2022, 5:43:36 PM)} \par "and Williamson's work on the Tea Party in The Tea Party and the Remaking of Republican Conservatism, we also included a variable that assesses the extent to which people rely on Fox News as their principal source of information.50 Since they argue that Fox News bears at least partial responsibility for the rise of the Tea Party, we thought it prudent to account for it in our analysis. Sure enough, it affects support for the Tea Party, increasing by 14 percent the likelihood that someone will become a true believer over people who draw on other sources for news." (\href{zotero://open-pdf/library/items/SNE4BFVQ?page=35}{Parker and Barreto 2014:35}) \par \textbf{Extracted Annotations (3/15/2022, 5:43:38 PM)} \par "When the focus shifts to the questions we ask about illegal immigrants, however, the daylight separating Tea Party and nonTea Party conservatives widens considerably. For both questions, the one asking about whether or not the Fourteenth Amendment should be repealed, and whether or not the DREAM Act should be passed, 20- point gaps emerge between Tea Party and nonTea Party conservatives. Indeed, twothirds of Tea Party conservatives favor repealing at least part of the Fourteenth Amendment, and only 30 percent support the DREAM Act. These figures are hard to reconcile with those of their conservative brethren, 46 percent of whom favor repealing part of the Constitution and 50 percent of whom support the DREAM Act. These findings confirm our narrative in which Tea Party conservatives are reactionary, and nonTea Party conservatives are more mainstream. The former are more concerned that immigrants are taking over their country; the latter are more preoccupied with law and order." (\href{zotero://open-pdf/library/items/SDYB57HT?page=21}{Parker and Barreto 2014:21}) \par \textbf{Extracted Annotations (3/15/2022, 5:43:40 PM)} \par "Each of these ideas has some merit. Still, the data we have gathered suggests they all come up short, and that, in fact, Tea Party sympathizers were much more likely than others to wade into the political process. We maintain that their reaction to whom they perceive as an illegitimate president drove sympathizers' political engagement. How else can we explain it? Prior to our analysis a critic could credibly charge that Tea Party supporters were no more committed to opposing Obama's policies than other partisans and conservatives. Now, however, we know this isn't true: sympathizers are motivated by something else. Throughout, we have maintained that beneath the anger and anxiety demonstrated by Tea Party supporters is a sense that Obama and his confederates seek to destroy the country. This chapter demonstrates this sentiment isn't confined to perceptions of freedom and patriotism (chapter 3), intergroup relations (chapter 4), or how people view the president (chapter 5). Our results confirm the explanatory power of reactionary conservatism." (\href{zotero://open-pdf/library/items/VNTAJUCV?page=24}{Parker and Barreto 2014:24})},
	publisher = {Princeton University Press},
	shorttitle = {Change {{They Can}}'t {{Believe In}}},
	title = {Change {{They Can}}'t {{Believe In}}: {{The Tea Party}} and {{Reactionary Politics}} in {{America}}},
	url = {http://muse.jhu.edu/book/40986},
	urldate = {2021-11-16},
	bdsk-url-1 = {http://muse.jhu.edu/book/40986}}

@article{parkerRacePoliticsAge2016,
	abstract = {Race has rarely mattered more in US politics than it does now. The election of President Obama has laid bare the racial divisions that continue to fracture the United States. In this review, I explore the emerging scholarship that assesses Obama's impact on social and political life in the United States. I first examine the symbolic meaning of Obama's election to black and white citizens. Second, I analyze how racism has influenced whites' political behavior and policy preferences. Next, I examine how President Obama has influenced public policy. Then, I suggest that the toxic political climate surrounding Obama is just another installment of a saga in which rapid social change is met with anxiety and anger by some whites who perceive their way of life as being under threat. Finally, I illustrate how the ``Obama effect'' combines with the perceived ``Latino threat'' to affect whites' political behavior.},
	annotation = {25 citations (Crossref) [2024-05-04]},
	author = {Parker, Christopher Sebastian},
	date = {2016-07-30},
	doi = {10.1146/annurev-soc-081715-074246},
	file = {Parker_2016_Race and Politics in the Age of Obama217-230.pdf},
	issn = {0360-0572, 1545-2115},
	journaltitle = {Annual Review of Sociology},
	keywords = {reviewed},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/8/2022, 9:03:09 PM)} \par "In short, with Obama as president, Latinos are perceived as the principal beneficiaries, and whites' political preferences have combined to thwart efforts to pass comprehensive immigration reform. Perhaps the most arresting research reveals that what we now term the Obama effect is likely a part of a longer trend in US politics. What is now termed the Obama effect may have been termed the "civil rights effect" in the 1960s, or the "American effect" in the 1920s. During each era, a reactionary faction of the political right sought to arrest social change by any means necessary. Acting out of anxiety and anger, this reactionary faction was (and is) largely responsible for the toxic political climate that typically ensues. The current iteration begins with the anxiety and fear that characterizes the Tea Party and its adherents and that spills over, pushing the GOP further to the right." (\href{zotero://open-pdf/library/items/EEQD5YGV?page=11}{Parker 2016:227})},
	number = {1},
	pages = {217--230},
	shortjournal = {Annu. Rev. Sociol.},
	title = {Race and {{Politics}} in the {{Age}} of {{Obama}}},
	url = {https://www.annualreviews.org/doi/10.1146/annurev-soc-081715-074246},
	urldate = {2022-03-09},
	volume = {42},
	bdsk-url-1 = {https://www.annualreviews.org/doi/10.1146/annurev-soc-081715-074246},
	bdsk-url-2 = {https://doi.org/10.1146/annurev-soc-081715-074246}}

@book{parkerRadicalRightUnited2018,
	abstract = {This chapter examines the attitudes, beliefs, and behavior of the reactionary right in the United States. It seeks to provide a better understanding of what motivates the reactionary right, and how such motivations inform the policy preferences and behavior of its constituents. However, the paucity of data restricts the analysis of the reactionary right to a fifty-year span, from the 1960s through the Tea Party. It begins with an overview of reactionary thought, including a brief history of reactionary movements through the mid-twentieth century. It then conducts an assessment of the immediate predecessor of the Tea Party: the John Birch Society. This is followed by an analysis of the contemporary reactionary movement in the United States: the Tea Party, and the movement responsible for the election of Donald Trump. The conclusion also briefly touches upon the continuities (and discontinuities) between the Tea Party and its European counterparts.},
	author = {Parker, Christopher},
	date = {2018-02-05},
	doi = {10.1093/oxfordhb/9780190274559.013.31},
	editor = {Rydgren, Jens},
	file = {Rydgren_Parker_2018_The Radical Right in the United States of America.pdf},
	keywords = {radical right,reviewed,use},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/14/2022, 4:44:55 PM)} \par "We turn to Christopher Towler's (2014) work on the re- actionary right in the 1960s for the bulk of the following analysis. He hypothesized that anxiety about communists infiltrating America, and he was right: as anxiety increased among people in the electorate, the probability of identifying with the reactionary right, indexed by support for Goldwater, increased by 33 percent. This effect is above and be- yond that which he found for alternative explanations, including racism, anti-communism, partisanship, and a preference for small government, each of which increased the likeli- hood of identifying with the reactionary right by 21 percent, 11 percent, 52 percent (Re- publican versus Democrat), and 11 percent, respectively." (\href{zotero://open-pdf/library/items/L8DYD9WK?page=6}{Rydgren and Parker 2018:6}) \par "Whether we're talking about blacks or immigrants, the Tea Party and its followers appear to reject the presence of racial "others."" (\href{zotero://open-pdf/library/items/L8DYD9WK?page=9}{Rydgren and Parker 2018:9}) \par "As it turns out, Tea Party conservatives were more politically engaged than oth- er conservatives, and far more so than progressives (Parker and Barreto 2013, ch. 6). The Tea Party, it seems, lives on: they're Trump supporters" (\href{zotero://open-pdf/library/items/L8DYD9WK?page=15}{Rydgren and Parker 2018:15})},
	publisher = {Oxford University Press},
	title = {The {{Radical Right}} in the {{United States}} of {{America}}},
	url = {http://oxfordhandbooks.com/view/10.1093/oxfordhb/9780190274559.001.0001/oxfordhb-9780190274559-e-31},
	urldate = {2022-03-09},
	volume = {1},
	bdsk-url-1 = {http://oxfordhandbooks.com/view/10.1093/oxfordhb/9780190274559.001.0001/oxfordhb-9780190274559-e-31},
	bdsk-url-2 = {https://doi.org/10.1093/oxfordhb/9780190274559.013.31}}

@article{parkerStatusThreatMoving2021,
	abstract = {Abstract             Over the last few years, right-wing movements have proliferated among Western democracies. Although much of the growth has taken place across the ``pond'' in Europe, this phenomenon is not confined to that continent. As recent events make clear, the United States is another major case. In this essay, I offer a theory of the emergence of reactionary movements, fueled by status threat, using the United States as a case. To demonstrate the explanatory range of the theory (and measure), I focus on immigration, impeachment, and support for Donald Trump in the 2020 election. Examining self-identified Republicans only, I argue that status threat motivates the reactionary wing of the GOP in the United States. Drawing on data culled from a national sample, I find support for my expectation that, beyond ideology and racism, status threat furnishes a new explanation for reactionary preferences. I close with a discussion of the implications.},
	annotation = {13 citations (Crossref) [2024-05-04]},
	author = {Parker, Christopher Sebastian},
	date = {2021-01-04},
	doi = {10.1162/daed_a_01846},
	file = {Status Threat.pdf},
	issn = {0011-5266, 1548-6192},
	journaltitle = {Daedalus},
	keywords = {reviewed,use},
	langid = {english},
	number = {2},
	pages = {56--75},
	shorttitle = {Status {{Threat}}},
	title = {Status {{Threat}}: {{Moving}} the {{Right Further}} to the {{Right}}?},
	url = {https://direct.mit.edu/daed/article/150/2/56/98322/Status-Threat-Moving-the-Right-Further-to-the},
	urldate = {2022-03-09},
	volume = {150},
	bdsk-url-1 = {https://direct.mit.edu/daed/article/150/2/56/98322/Status-Threat-Moving-the-Right-Further-to-the},
	bdsk-url-2 = {https://doi.org/10.1162/daed_a_01846}}

@article{parkExceptionalOutgroupStereotypes2015,
	abstract = {Stereotypes of outgroups help create social identificational boundaries for ingroups. When the ingroup is dominant, members employ individualist sentiments to justify their status. In this study, we build on advances in social psychological research that account for multiple outgroup stereotypes. We argue the Asian American model minority stereotype is analogous to the ``cold but competent'' position of perceptions toward Asians in Fiske's stereotype content model. Asian Americans are perceived to be exceptional to other minority groups, and we hypothesize that perceived competence is associated with individualist sentiments directed at Blacks and Latinos. Using data from the National Longitudinal Study of Freshmen, we find support for our hypotheses but find that perceived coldness has no relationship to individualist sentiments. We discuss the implications and directions for further research.},
	author = {Park, Jerry Z. and Martinez, Brandon C. and Cobb, Ryon and Park, Julie J. and Wong, Erica Ryu},
	date = {2015-12-01},
	doi = {10.1177/0190272515606433},
	file = {Park et al_2015_Exceptional Outgroup Stereotypes and White Racial Inequality Attitudes toward399-411.pdf},
	issn = {0190-2725},
	journaltitle = {Social Psychology Quarterly},
	keywords = {Asian Americans,racial attitudes,stereotypes},
	langid = {english},
	number = {4},
	pages = {399--411},
	publisher = {SAGE Publications Inc},
	shortjournal = {Soc Psychol Q},
	title = {Exceptional {{Outgroup Stereotypes}} and {{White Racial Inequality Attitudes}} toward {{Asian Americans}}},
	url = {https://doi.org/10.1177/0190272515606433},
	urldate = {2022-06-09},
	volume = {78},
	bdsk-url-1 = {https://doi.org/10.1177/0190272515606433}}

@article{parkFeelingImmoralMoney2012,
	abstract = {Given the prevalence of bounded morality and possibly tainted financial gains, this research examines how feeling guilty about money changes consumer spending. Extending the research on mental and emotional accounting, we propose that consumers also engage in ``moral accounting'': consumers spend money differently depending on the moral nature of the emotion (i.e., guilt) associated with the money. We show that tainting money with moral guilt resulting from a moral violation increases pro-social spending, whereas tainting money with self-control guilt elicited from a personal self-control failure increases self-improvement spending. Moreover, this effect of moral guilt (but not of self-control guilt) is magnified by consumers' selfimportance of moral identity---confirming the moral nature of guilt as the driving factor underlying the differential guilt effects. We further find that moral guilt can be bound to money, leading to a pre-occupation with cleansing the money by spending some of it pro-socially, rather than engaging in other activities that could more effectively reinforce their moral identity (i.e., volunteering time). These results suggest that associating moral guilt with money---and focusing on that money instead of its moral implications for the self---acts as a proactive self-protection (vs. reactive self-repair) strategy against a self-threat.},
	annotation = {1 citations (Crossref) [2022-06-07]},
	author = {Park, Hyun Young and Meyvis, Tom},
	date = {2012},
	doi = {10.2139/ssrn.2043657},
	file = {Park_Meyvis_2012_Feeling Immoral About Money.pdf},
	issn = {1556-5068},
	journaltitle = {SSRN Electronic Journal},
	langid = {english},
	shortjournal = {SSRN Journal},
	shorttitle = {Feeling {{Immoral About Money}}},
	title = {Feeling {{Immoral About Money}}: {{How Moral Emotions Influence Spending Decisions}}},
	url = {http://www.ssrn.com/abstract=2043657},
	urldate = {2022-06-03},
	bdsk-url-1 = {http://www.ssrn.com/abstract=2043657},
	bdsk-url-2 = {https://doi.org/10.2139/ssrn.2043657}}

