@book{shapiraWaitingJoseMinutemen2013,
	abstract = {They live in the suburbs of Tennessee and Indiana. They fought in Vietnam and Desert Storm. They speak about an older, better America, an America that once was, and is no more. And for the past decade, they have come to the U.S. / Mexico border to hunt for illegal immigrants. Who are the Minutemen? Patriots? Racists? Vigilantes?           Harel Shapira lived with the Minutemen and patrolled the border with them, seeking neither to condemn nor praise them, but to understand who they are and what they do. Challenging simplistic depictions of these men as right-wing fanatics with loose triggers, Shapira discovers a group of men who long for community and embrace the principles of civic engagement. Yet these desires and convictions have led them to a troubling place.           Shapira takes you to that place--a stretch of desert in southern Arizona, where he reveals that what draws these men to the border is not simply racism or anti-immigrant sentiments, but a chance to relive a sense of meaning and purpose rooted in an older life of soldiering. They come to the border not only in search of illegal immigrants, but of lost identities and experiences.},
	author = {Shapira, Harel},
	date = {2013},
