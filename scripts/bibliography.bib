@article{pettigrewINTERGROUPCONTACTTHEORY1998,
	abstract = {? Abstract?Allport specified four conditions for optimal intergroup contact: equal group status within the situation, common goals, intergroup cooperation and authority support. Varied research supports the hypothesis, but four problems remain. 1. A selection bias limits cross-sectional studies, since prejudiced people avoid intergroup contact. Yet research finds that the positive effects of cross-group friendship are larger than those of the bias. 2. Writers overburden the hypothesis with facilitating, but not essential, conditions. 3. The hypothesis fails to address process. The chapter proposes four processes: learning about the outgroup, changed behavior, affective ties, and ingroup reappraisal. 4. The hypothesis does not specify how the effects generalize to other situations, the outgroup or uninvolved outgroups. Acting sequentially, three strategies enhance generalization?decategorization, salient categorization, and recategorization. Finally, both individual differences and societal norms shape intergroup contact effects. The chapter outlines a longitudinal intergroup contact theory. It distinguishes between essential and facilitating factors, and emphasizes different outcomes for different stages of contact.},
	annotation = {3329 citations (Crossref) [2024-05-04]},
	author = {Pettigrew, Thomas F.},
	date = {1998-02-01},
	doi = {10.1146/annurev.psych.49.1.65},
	file = {Pettigrew_INTERGROUP CONTACT THEORY21.pdf},
	issn = {0066-4308},
	journaltitle = {Annual Review of Psychology},
	note = {doi: 10.1146/annurev.psych.49.1.65 \par \textbf{Extracted Annotations (3/14/2022, 5:09:39 PM)} \par "Note that living in an intergroup neighborhood makes it more likely that a European will have an outgroup friend (+.356). There is no direct relationship, however, between mixed neighborhoods and affective prejudice." (\href{zotero://open-pdf/library/items/RMJPRRH8?page=8}{Pettigrew 1998:72}) \par "The power of cross-group friendship to reduce prejudice and generalize to other outgroups demands a fifth condition for the contact hypothesis: The contact situation must provide the participants with the opportunity to become friends." (\href{zotero://open-pdf/library/items/RMJPRRH8?page=12}{Pettigrew 1998:76})},
	number = {1},
	pages = {65--85},
	publisher = {Annual Reviews},
	shortjournal = {Annu. Rev. Psychol.},
	title = {{{INTERGROUP CONTACT THEORY}}},
	url = {https://doi.org/10.1146/annurev.psych.49.1.65},
	urldate = {2022-03-15},
	volume = {49},
	bdsk-url-1 = {https://doi.org/10.1146/annurev.psych.49.1.65}}

