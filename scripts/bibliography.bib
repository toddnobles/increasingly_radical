@incollection{thomasInequalityGlobalization2016,
	abstract = {A liberal-republican approach to global justice shares John Rawls's statist, as opposed to cosmopolitan, focus. It is argued that this does not mean that any domestic nation-state has lost the ``elbow room'' to implement a domestic form of egalitarianism---such as a property-owning democracy. The process of globalization enables, as well as constrains, and accentuates pressures that were present in any case. Comparing inequality within and between countries, it is not true that domestic inequality is the price that must be paid for a more globally just world. Particular attention is paid to the financial sector as a potential source of global instability or constraints on domestic policy; it is argued that effective or expanded regulation is an appropriate response combined with progressive taxation as a measure in transitional justice. The chapter concludes with a discussion of the democratic responsibilities of those who control large-scale holdings of capital.},
	author = {Thomas, Alan},
	booktitle = {Republic of {{Equals}}: {{Predistribution}} and {{Property-Owning Democracy}}},
