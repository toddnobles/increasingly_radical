	journaltitle = {Gender \& Society},
	keywords = {ObsCite},
	number = {4},
	pages = {560--580},
	publisher = {SAGE Publications Inc},
	shortjournal = {Gender \& Society},
	title = {{{MIGRANT FILIPINA DOMESTIC WORKERS AND THE INTERNATIONAL DIVISION OF REPRODUCTIVE LABOR}}},
	url = {https://doi.org/10.1177/089124300014004005},
