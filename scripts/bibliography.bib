@article{derudderThreeGlobalizationsShaping2020,
	author = {Derudder, Ben and Taylor, Peter J.},
	date = {2020-11-01},
	doi = {10.1080/24694452.2020.1727308},
	file = {Derudder and Taylor 2020 Three Globalizations Shaping the Twenty-first Century.pdf},
	issn = {2469-4452, 2469-4460},
	journaltitle = {Annals of the American Association of Geographers},
	keywords = {ObsCite},
	langid = {english},
	note = {\section{Annotations\\ (4/17/2022, 8:16:33 PM)} \par ``Such financial, professional, and creative services have come to be called knowledgeintensive business services or advanced producer services (APS; Shearmur 2016), and these have coevolved with the different phases of economic globalization.'' (Derudder and Taylor, 2020, p. 1833) \par ``This provides for a strong urban grounding of globalization processes. Thus, in addition to globalization being treated as a narrative of international relations---for instance, governments pursuing neoliberal policies---it can equally be studied as a feature of urban studies; for instance, the analysis of cityscapes dominated by high-rise buildings housing major producer service firms across both the Global North and Global South (Lizieri 2009) or the construction of inventories of cities based on their level of APS (Beaverstock, Smith, and Taylor 2000)'' (Derudder and Taylor, 2020, p. 1834) \par ``We treat corporate globalization from the perspective of cities insofar as they are central to the global networks that make large-scale economic processes possible. To this end, we retell the narrative of an unfolding globalization as reflected in the contemporary world city network created by the world's largest producer services firms (Taylor and Derudder 2016).'' (Derudder and Taylor, 2020, p. 1834) \par ``APS-based analyses still have a key role within this literature. Rather than representing but one of many processes that thus results in a ``bias'' toward specific cities in the Global North, we maintain that APS-based analyses have a particular salience to them. To understand this explicit privileging, it is important to continue pointing out that WCN analysis is not just an ``urban analysis,'' but it is about finding out how and which specific cities are central the reproduction of uneven development within globalized capitalism'' (Derudder and Taylor, 2020, p. 1837) \par ``Thus, for each component we will have three measures for each city. Each tells us something different yet complementary about its respective common location strategy. 1. The initial component score---This is what we have used in our previous studies. It describes cities as places with like service profiles; that is to say, housing many of the same service firms. 2. The global network connectivity---Now measured for the first time as component specific, this describes the importance of cities in the practice of the common location strategy. 3. The headquarters network connectivity---This is a new measure that shows the importance of cities specifically as command and control centers within the common location strategy. The addition of the latter two measures provides a critical supplement to standard PCA: It is the methodological contribution of this article. The proof of its utility is found in our unique set of new results on the contemporary WCN.'' (Derudder and Taylor, 2020, p. 1842) \par ``In contemporary circuits of capital, extensive globalization is the global mechanism for the crucial stage of realizing capital: It enables the necessary mass consumptions of global brands across a very diverse humanity'' (Derudder and Taylor, 2020, p. 1846) \par ``Extensive globalization is extensive in its practice and facilitation but not in its control and command. This most common global location strategy is largely orchestrated in New York and London'' (Derudder and Taylor, 2020, p. 1846) \par ``In summary, intensive globalization is a very U.S. product with a London adjunct.'' (Derudder and Taylor, 2020, p. 1848)},
	number = {6},
	pages = {1831--1854},
	shortjournal = {Annals of the American Association of Geographers},
	shorttitle = {Three {{Globalizations Shaping}} the {{Twenty-first Century}}},
	title = {Three {{Globalizations Shaping}} the {{Twenty-first Century}}: {{Understanding}} the {{New World Geography}} through {{Its Cities}}},
	url = {https://www.tandfonline.com/doi/full/10.1080/24694452.2020.1727308},
	urldate = {2022-04-14},
	volume = {110},
	bdsk-url-1 = {https://www.tandfonline.com/doi/full/10.1080/24694452.2020.1727308},
	bdsk-url-2 = {https://doi.org/10.1080/24694452.2020.1727308}}

