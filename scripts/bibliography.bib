@article{hickelUnequalExchangeLabour2024,
	abstract = {Researchers have argued that wealthy nations rely on a large net appropriation of labour and resources from the rest of the world through unequal exchange in international trade and global commodity chains. Here we assess this empirically by measuring flows of embodied labour in the world economy from 1995--2021, accounting for skill levels, sectors and wages. We find that, in 2021, the economies of the global North net-appropriated 826 billion hours of embodied labour from the global South, across all skill levels and sectors. The wage value of this net-appropriated labour was equivalent to €16.9 trillion in Northern prices, accounting for skill level. This appropriation roughly doubles the labour that is available for Northern consumption but drains the South of productive capacity that could be used instead for local human needs and development. Unequal exchange is understood to be driven in part by systematic wage inequalities. We find Southern wages are 87--95\% lower than Northern wages for work of equal skill. While Southern workers contribute 90\% of the labour that powers the world economy, they receive only 21\% of global income.},
	author = {Hickel, Jason and Hanbury Lemos, Morena and Barbour, Felix},
	date = {2024-07-29},
	doi = {10.1038/s41467-024-49687-y},
	file = {../../../Zotero/storage/WMRIHNM4/Hickel et al. - 2024 - Unequal exchange of labour in the world economy.pdf},
	issn = {2041-1723},
	journaltitle = {Nature Communications},
	keywords = {Developing world,Sociology},
	langid = {english},
	number = {1},
	pages = {6298},
	publisher = {Nature Publishing Group},
	shortjournal = {Nat Commun},
	title = {Unequal Exchange of Labour in the World Economy},
	url = {https://www.nature.com/articles/s41467-024-49687-y},
	urldate = {2025-03-31},
	volume = {15},
	bdsk-url-1 = {https://www.nature.com/articles/s41467-024-49687-y},
	bdsk-url-2 = {https://doi.org/10.1038/s41467-024-49687-y}}

@article{higginsRoleRaceEthnicity2010,
	abstract = {This article examines two hypotheses related to public opinion concerning immigration and crime. Using data from a recent Gallup poll with oversamples of Hispanics and Blacks, the research examined whether race/ethnicity and race relations matter in the public's opinion of the connection between immigration and crime. After a series of models were performed, results of the final model revealed that race relations, gender (specifically, being male), race/ethnicity, and immigrant status are influential in contextualizing public opinion on the topic. The meaning and policy implications of these findings are also reviewed.},
	annotation = {23 citations (Crossref) [2024-05-04]},
	author = {Higgins, George E. and Gabbidon, Shaun L. and Martin, Favian},
	date = {2010-01},
	doi = {10.1016/j.jcrimjus.2009.11.007},
	file = {Higgins et al_2010_The role of race-ethnicity and race relations on public opinion related to the51-56.pdf},
	issn = {00472352},
	journaltitle = {Journal of Criminal Justice},
	keywords = {maybe don't use,reviewed},
	langid = {english},
	note = {\textbf{Extracted Annotations (3/14/2022, 5:01:18 PM)} \par "Chandler and Tsai (2001) found that both Blacks and Whites felt that the number of immigrants should be reduced. Their study did find some differences by race, with non-Whites having somewhat more favorable attitudes than Whites towards immigration. It was also found that those who were pessimistic about the economy were more likely to hold anti-immigrant views. In addition, those who were fearful of crime also held such views. The authors found that those who had a college education held more favorable attitudes towards immigration (Chandler \& Tsai, 2001)." (\href{zotero://open-pdf/library/items/W87FWCRN?page=2}{Higgins et al 2010:52}) \par "Neal and Bohon (2003) interviewed residents from Georgia about the increasing Hispanic population. Their research found support for more than one aspect of minority-threat theory. First, those Georgians who resided in the state for an extended period of time were more likely to view immigrants as a social threat, as were those who were pessimistic about the economy (Neal \& Bohon, 2003). Second, if residents viewed the immigrants as an economic threat, they were more likely to express anti-immigrant attitudes. The socioeconomic status of the respondents also influenced respondents' attitudes. Specifically, those respondents who had lower incomes were less likely to be accepting of immigrants" (\href{zotero://open-pdf/library/items/W87FWCRN?page=2}{Higgins et al 2010:52}) \par \subsubsubsection{Major question:} \subsubsubsection{Method:} \subsubsubsection{Variables and definitions:} \subsubsubsection{Study Population} \subsubsubsection{Findings:} \par find that immigrants and hispanics are less prone to believing that immigration contributes to increased crime rates \par \subsubsubsection{Conclusions} \subsubsubsection{Comments} \par national sample. not surprising findings. Suggests contact may be the driving factor shaping views, but can't test it with their sample.},
	number = {1},
	pages = {51--56},
	shortjournal = {Journal of Criminal Justice},
	title = {The Role of Race/Ethnicity and Race Relations on Public Opinion Related to the Immigration and Crime Link},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0047235209001421},
	urldate = {2022-03-10},
	volume = {38},
	bdsk-url-1 = {https://linkinghub.elsevier.com/retrieve/pii/S0047235209001421},
	bdsk-url-2 = {https://doi.org/10.1016/j.jcrimjus.2009.11.007}}

@article{hillmanResourceDependenceTheory2009,
	abstract = {Thirty years have passed since Pfeffer and Salancik's seminal work on resource dependence theory (RDT). During this time RDT has been applied broadly across the research domain to explain how organizations reduce environmental interdependence and uncertainty. In this review, the authors assess the conceptual development, empirical research, and application of RDT. They structure their review around the five options that Pfeffer and Salancik propose firms can enact to minimize environmental dependences: (a) mergers/vertical integration, (b) joint ventures and other interorganizational relationships, (c) boards of directors, (d) political action, and (e) executive succession.The authors summarize past work, synthesize contemporary thought, and propose future research directions.},
