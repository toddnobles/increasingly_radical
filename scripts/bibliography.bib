	pages = {517--532},
	publisher = {Cambridge University Press},
	shorttitle = {Putting {{Inequality}} in {{Its Place}}},
	title = {Putting {{Inequality}} in {{Its Place}}: {{Rural Consciousness}} and the {{Power}} of {{Perspective}}},
	url = {http://www.cambridge.org/core/journals/american-political-science-review/article/putting-inequality-in-its-place-rural-consciousness-and-the-power-of-perspective/A603EA36286F837AEB4F0CF250D4595A},
