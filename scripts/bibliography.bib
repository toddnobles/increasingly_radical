	issn = {2297-900X},
	journaltitle = {Frontiers in Communication},
	pages = {83},
	shorttitle = {Understanding {{Support}} for {{Populist Radical Right Parties}}},
	title = {Understanding {{Support}} for {{Populist Radical Right Parties}}: {{Toward}} a {{Model That Captures Both Demand-and Supply-Side Factors}}},
	url = {https://www.frontiersin.org/article/10.3389/fcomm.2020.557561},
	urldate = {2021-11-16},
	volume = {5},
	bdsk-url-1 = {https://www.frontiersin.org/article/10.3389/fcomm.2020.557561},
