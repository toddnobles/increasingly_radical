	langid = {english},
	number = {4},
	pages = {683--708},
	shortjournal = {Electoral Studies},
	shorttitle = {Endogenous Economic Voting},
	title = {Endogenous Economic Voting: Evidence from the 1997 {{British}} Election},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0261379403000842},
	urldate = {2022-03-23},
	volume = {23},
