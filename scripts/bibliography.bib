	issn = {1541-0986, 1537-5927},
	journaltitle = {Perspectives on Politics},
	langid = {english},
	number = {2},
	pages = {279--287},
	publisher = {Cambridge University Press},
	shorttitle = {Culture {{Clash}}?},
	title = {Culture {{Clash}}? {{Contesting Notions}} of {{American Identity}} and the {{Effects}} of {{Latin American Immigration}}},
	url = {http://www.cambridge.org/core/journals/perspectives-on-politics/article/culture-clash-contesting-notions-of-american-identity-and-the-effects-of-latin-american-immigration/70F4B810B0BEBEA6D7A159B8D11934BB},
