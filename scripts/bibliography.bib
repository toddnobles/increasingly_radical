	pages = {237802312311671},
	shortjournal = {Socius: Sociological Research for a Dynamic World},
	shorttitle = {The {{Inequity Z}}},
	title = {The {{Inequity Z}}: {{Income Fairness Perceptions}} in {{Europe}} across the {{Income Distribution}}},
	url = {http://journals.sagepub.com/doi/10.1177/23780231231167138},
	urldate = {2023-08-25},
