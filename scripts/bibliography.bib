@article{agnewIdentifyingRoleWhere,
	abstract = {This paper provides a general framework to conceptualize and study geography in political science. We begin with a discussion of what is geography? We introduce two important but distinctive conceptions of space/place that often confuse political scientists. We offer a general perspective on how and why geography matters and review some of the recent work that engages with spatial thinking as practiced in political science. We also address gaps and ambiguities in spatial thinking in the current literature and discuss how failure to consider geography or improper understanding of it can threaten the validity of empirical findings.},
	author = {Agnew, John and Hui, Iris},
	file = {Agnew_Hui_Identifying the Role of `Where' in Political Science.pdf},
	langid = {english},
	pages = {27},
	title = {Identifying the {{Role}} of `{{Where}}' in {{Political Science}}: {{The Spatial Dimensions}} of {{Political Analysis}}}}

