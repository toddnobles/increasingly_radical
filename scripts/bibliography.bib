	shortjournal = {Environmental Justice},
	shorttitle = {Envisioning {{Disabled}} and {{Just Futures}}},
	title = {Envisioning {{Disabled}} and {{Just Futures}}: {{Mutual Aid}} as an {{Adaptive Strategy}} for {{Environmental Change}} and {{Ecological Disablement}}},
