@article{jettenProsperousFearfulFalling2021,
	abstract = {Building on growing evidence that relative economic gratification may be associated with prejudice toward minorities, such as immigrants, the question remains when and why prosperity and wealth may enhance opposition to immigration. In a correlational study (Study 1, N = 498), we show that increased fear of falling in the future (individually or collectively) is associated with greater opposition to immigration. We then experimentally studied the effects of potential (Study 2, N = 294) and actual (Study 3, N = 166) downward mobility among the relatively wealthy, as well as of relatively stagnating wealthy in the context where an initially poorer group is quickly gaining wealth over time (Study 4, N = 151). We find that fear of falling among the wealthy is associated with more opposition to immigration, mediated by collective angst. We conclude that the anticipation that the economic future looks less rosy than the present evokes collective angst, which, in turn, fuels prejudice toward immigrants.},
	annotation = {12 citations (Crossref) [2024-05-04]},
	author = {Jetten, Jolanda and Mols, Frank and Steffens, Niklas K.},
	date = {2021-05-01},
	doi = {10.1177/0146167220944112},
	file = {Jetten et al_2021_Prosperous But Fearful of Falling.pdf},
	issn = {0146-1672},
	journaltitle = {Personality and Social Psychology Bulletin},
	keywords = {opposition to immigration,relative gratification,social mobility,wealth,wealth paradox},
	langid = {english},
	number = {5},
	pages = {766--780},
	publisher = {SAGE Publications Inc},
	shortjournal = {Pers Soc Psychol Bull},
	shorttitle = {Prosperous {{But Fearful}} of {{Falling}}},
	title = {Prosperous {{But Fearful}} of {{Falling}}: {{The Wealth Paradox}}, {{Collective Angst}}, and {{Opposition}} to {{Immigration}}},
	url = {https://doi.org/10.1177/0146167220944112},
	urldate = {2021-11-18},
	volume = {47},
	bdsk-url-1 = {https://doi.org/10.1177/0146167220944112}}

@article{jimenezMexicanImmigrantReplenishment2008,
	abstract = {The literature on assimilation and ethnic identity formation largely assumes that the durability of ethnic boundaries is a function of the assimilation measures that sociologists commonly employ. But this literature fails to account adequately for the role of immigration patterns in explaining the durability and nature of ethnic boundaries. Using 123 in‐depth interviews with later‐generation Mexican Americans, this article shows that Mexican immigrant replenishment shapes ethnic boundaries and ethnic identity formation. The sizable immigrant population sharpens intergroup boundaries through the indirect effects of nativism and by contributing to the continuing significance of race in the lives of later‐generation Mexican Americans. The presence of a large immigrant population also creates intragroup boundaries that run through the Mexican‐origin population and that are animated by expectations about ethnic authenticity. The article illustrates the importance of immigrant replenishment to processes of assimilation and ethnic identity formation.},
	author = {Jim{\'e}nez, Tom{\'a}s~R.},
	date = {2008-05-01},
	doi = {10.1086/587151},
	file = {Jimenez_2008_Mexican Immigrant Replenishment and the Continuing Significance of Ethnicity.pdf},
	issn = {0002-9602},
	journaltitle = {American Journal of Sociology},
	note = {\textbf{Extracted Annotations (2/6/2022, 10:31:48 PM)} \par "Many studies of Mexican American intergenerational progress in education and wages support such a view, noting increases in educational attainment and wages from the first to the second generation but a flattening of progress from the second to the third" (\href{zotero://open-pdf/library/items/68P3URDC?page=9}{Jim{\'e}nez 2008:1535}) \par "Taken together, these findings suggest a softening of the boundaries that impede assimilation. If race and ethnicity are weaker barriers to mobility for Mexican Americans than previous research suggests, what remains unclear is whether or not these gains translate into the symbolic form of ethnicity implied by canonical accounts of assimilation." (\href{zotero://open-pdf/library/items/68P3URDC?page=10}{Jim{\'e}nez 2008:1536}) \par "As Barth points out (1969, p. 10), "Ethnic distinctions do not depend on an absence of social interaction and acceptance, but are quite to the contrary often the very foundations on which embracing social systems are built." It is through these interactions that Mexican Americans get an up-close and personal view of nativism and the intergroup boundaries it animates." (\href{zotero://open-pdf/library/items/68P3URDC?page=17}{Jim{\'e}nez 2008:1543}) \par "In the eyes of those who enforce the criteria for authenticity, Mexican ethnicity and "mainstream" American culture are at odds. Tastes and styles perceived to be devoid of Mexican overtones fail to meet the expectations about Mexican ethnicity that many immigrants and young second-generation individuals impose" (\href{zotero://open-pdf/library/items/68P3URDC?page=27}{Jim{\'e}nez 2008:1553})},
	number = {6},
	pages = {1527--1567},
	publisher = {The University of Chicago Press},
	title = {Mexican {{Immigrant Replenishment}} and the {{Continuing Significance}} of {{Ethnicity}} and {{Race}}},
	url = {http://www.journals.uchicago.edu/doi/full/10.1086/587151},
	urldate = {2022-02-07},
	volume = {113},
	bdsk-url-1 = {http://www.journals.uchicago.edu/doi/full/10.1086/587151},
	bdsk-url-2 = {https://doi.org/10.1086/587151}}

@article{jimenezWhenWhiteJust2013,
	abstract = {Research on immigration, educational achievement, and ethnoraciality has followed the lead of racialization and assimilation theories by focusing empirical attention on the immigrant-origin population (immigrants and their children), while overlooking the effect of an immigrant presence on the third-plus generation (U.S.-born individuals of U.S.-born parents), especially its white members. We depart from this approach by placing third-plus-generation individuals at center stage to examine how they adjust to norms defined by the immigrant-origin population. We draw on fieldwork in Cupertino, California, a high-skilled immigrant gateway, where an Asian immigrant-origin population has established and enforces an amplified version of high-achievement norms. The resulting ethnoracial encoding of academic achievement constructs whiteness as having lesser-than status. Asianness stands for high-achievement, hard work, and success; whiteness, in contrast, represents low-achievement, laziness, and academic mediocrity. We argue that immigrants can serve as a foil against which the meaning and status of an ethnoracial category is recast, upending how the category is deployed in daily life. Our findings call into question the position that treats the third-plus generation, especially whites, as the benchmark population that sets achievement norms and to which all other populations adjust.},
	author = {Jim{\'e}nez, Tom{\'a}s R. and Horowitz, Adam L.},
	date = {2013-10-01},
	doi = {10.1177/0003122413497012},
	file = {Jimenez_Horowitz_2013_When White Is Just Alright849-871.pdf},
	issn = {0003-1224},
	journaltitle = {American Sociological Review},
	keywords = {achievement,assimilation,immigration,race,whiteness},
	langid = {english},
	number = {5},
	pages = {849--871},
	publisher = {SAGE Publications Inc},
	shortjournal = {Am Sociol Rev},
	shorttitle = {When {{White Is Just Alright}}},
	title = {When {{White Is Just Alright}}: {{How Immigrants Redefine Achievement}} and {{Reconfigure}} the {{Ethnoracial Hierarchy}}},
	url = {https://doi.org/10.1177/0003122413497012},
	urldate = {2022-03-01},
	volume = {78},
	bdsk-url-1 = {https://doi.org/10.1177/0003122413497012}}

