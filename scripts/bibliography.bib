	keywords = {/unread},
	langid = {english},
	pages = {365--383},
	publisher = {Annual Reviews},
	shorttitle = {A {{Sociology}} of {{Real Estate}}},
	title = {A {{Sociology}} of {{Real Estate}}: {{Polanyi}}, {{Du Bois}}, and the {{Relational Study}} of {{Commodified Land}} in a {{Climate-Changed Future}}},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev-soc-033022-035124},
	urldate = {2024-10-08},
