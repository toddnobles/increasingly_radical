	number = {1},
	pages = {146--165},
	shortjournal = {Management Science},
	title = {The {{Effects}} of {{Tip Recommendations}} on {{Customer Tipping}}, {{Satisfaction}}, {{Repatronage}}, and {{Spending}}},
	url = {http://pubsonline.informs.org/doi/10.1287/mnsc.2019.3541},
