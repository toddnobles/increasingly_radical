@article{adiguzelOutSightOut2020,
	abstract = {Do voters reward incumbents for the provision of public services? In this paper, we study the political economy of catchment areas of public services to answer this question. Rather than examining the binary relationship between health care provision and electoral returns within politically defined borders, we study whether increases in geographic accessibility of health care providers and decreases in congestion in services attract votes for the incumbent. Leveraging a health care reform in Turkey, which substantially impacted the geospatial distribution of public health clinics in Istanbul, we find that decreases in walking time and improvements in congestion levels in the closest clinic from a polling station significantly increase vote share of the AKP, the incumbent party, at that polling station. We also show that poorer communities were more responsive to improvements in spatial accessibility to the local clinics.},
	author = {Adiguzel, Serkant and Cansunar, Asli and Corekcioglu, Gozde},
	date = {2020},
	doi = {10.2139/ssrn.3581761},
	file = {Adiguzel et al_2020_Out of Sight, Out of Mind.pdf},
	issn = {1556-5068},
	journaltitle = {SSRN Electronic Journal},
	langid = {english},
	note = {looking at vote share at polling places and IV is walk time and congestion \par Second, I still find the effect size in the study rather underwhelming. The estimates point to a mean increase in vote share of the AKP by 0.2pp and AKP's vote margin by 0.36pp. These are very small effects. The authors write that these effects are "large enough to swing the winner in a polling station in a local election but not in a general election." Winning a polling station does not have any electoral effects whatsoever, so I do not get the emphasis here. It would be better to make a claim about electoral results (swinging the mayor or an additional seat in the municipal council, for example). In the memo on p.5, the authors report a negative relationship between having a new clinic in the neighborhood and AKP vote share. This is very intriguing and suggests that some unobserved factors might be driving the results. The authors propose an explanation related to the geospatial distribution of new clinics in Istanbul, but they focus only on one district, and the proposed mechanism is not clear. I thought that voters could not visit clinics in other neighborhoods, but I might be wrong. My key empirical concern was that the controls of the authors are not at the level of analyses (catchment areas) but at a higher level (neighborhood). The authors argue that there is not much variation in terms of house prices within neighborhoods in Istanbul. Yet again they present evidence from a single district in this direction. I simply do not know whether this district is representative of others. And I would like to see a more quantified evidence rather than relying on a figure to judge. Also, how reliable are property prices to approximate socio-economic status of localities? If these are assessed values for tax purposes, for example, we know that in many developing countries they are artificially shown to be low to keep taxes low as well. This might lead to an invalid conclusion that there is not much difference within neighborhoods. \par 2) Tables 4 and 5 report regression results, including a set of two-way interactions in a model but without the main effects (i.e., the predictor and the moderator which interacts with each other as a product term). Is it simply the case "not reported here" due to the space limit? If not, which I think not necessarily incorrect and rather debatable, please provide an explanation for why it makes sense to leave them out in your case, or show an extra column for a model that includes the main effects alongside their product term. Reviewer \#4: It was a pleasure to read a new version of "Out of Sight, Out of Mind? Electoral Responses to Proximity of Health Care." In general, I'm happy to endorse this paper for publication. I have a few small questions/concerns outlined below. In my original review I asked the authors to address two things: (1) I hoped the authors would better justify their chosen independent variable of estimated walk time to a clinic, and (2) I hoped the authors would implement and present more intensive design validity checks. On the first, the authors have generally done a good job. But I am not entirely persuaded by the way the authors address the concerns about polling station catchment areas. They say they "created Thiessen polygons around each polling station which is the best approximation to actual catchment areas" but I see no justification for that claim (the "best approximation of actual") - why is that the case? Further, it seems almost mechanically true that the centroid of the Theissen polygon and the true polling station (around which the polygon was drawn) should be very close to each other, so unless the Theissen polygons are better justified, I am not sure this achieves much. On the second, I applaud the authors for their careful assessment of the validity of their design. One thing that is a little unclear to me is the use of the "instrument" for "need for health care." Clearly this isn't being used in the conventional "instrumental variables" approach (and that's good, because I'm not sure that would make sense). So what is the point of this variable? Simply to be used as a control? A little more explanation here would be helpful},
	shortjournal = {SSRN Journal},
	shorttitle = {Out of {{Sight}}, {{Out}} of {{Mind}}?},
	title = {Out of {{Sight}}, {{Out}} of {{Mind}}? {{Electoral Responses}} to {{Proximity}} of {{Healthcare}}},
	url = {https://www.ssrn.com/abstract=3581761},
	urldate = {2021-11-01},
	bdsk-url-1 = {https://www.ssrn.com/abstract=3581761},
	bdsk-url-2 = {https://doi.org/10.2139/ssrn.3581761}}

