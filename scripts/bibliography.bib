@article{castillaBringingManagersBack2011,
	abstract = {While great progress has been made in documenting that organizational practices affect workplace inequality, little is known about how managers in particular may shape the careers of the employees below them. Using unique longitudinal personnel data on managers and their subordinates, this study identifies and tests for evidence of three distinct mechanisms by which managers potentially influence the assessment of employee performance in the workplace: (1) social network influence between employees' current and former managers; (2) manager--manager (horizontal) homophily; and (3) manager--employee (vertical) homophily. I find evidence of the independent effects of all three mechanisms of managerial influence on the outcome of disagreement in the performance evaluation ratings of the same worker between former and current managers. In particular, my results stress that both managerial network influence and horizontal homophily affect the process of employee performance assessments, over and above the well-studied vertical homophily mechanism. I conclude by discussing the theoretical implications of these findings for future research regarding the interactional aspects of workplace inequality within contemporary organizations.},
	annotation = {104 citations (Crossref) [2023-06-04]},
	author = {Castilla, Emilio J.},
	date = {2011-10},
	doi = {10.1177/0003122411420814},
	file = {Castilla_2011_Bringing Managers Back In667-694.pdf},
	issn = {0003-1224, 1939-8271},
	journaltitle = {American Sociological Review},
	langid = {english},
	note = {\section{Annotations\\ (6/23/2023, 3:46:19 PM)} \par ``ocially connected managers will disagree less in their performance evaluation ratings of a given third employee than will independent managers.'' (Castilla, 2011, p. 670) \par ``g managers on disagreement regarding employee performance assessments: demographically similar managers will disagree less in their performance evaluation ratings of a given third employee than will demographically different managers.3'' (Castilla, 2011, p. 671) \par ``This yields the next prediction: demographic similarity between managers and employees decreases disagreement in managers' performance evaluation ratings of a given employee.'' (Castilla, 2011, p. 671)},
	number = {5},
	pages = {667--694},
	shortjournal = {Am Sociol Rev},
	shorttitle = {Bringing {{Managers Back In}}},
	title = {Bringing {{Managers Back In}}: {{Managerial Influences}} on {{Workplace Inequality}}},
	url = {http://journals.sagepub.com/doi/10.1177/0003122411420814},
	urldate = {2023-06-04},
	volume = {76},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1177/0003122411420814},
	bdsk-url-2 = {https://doi.org/10.1177/0003122411420814}}

