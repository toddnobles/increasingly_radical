	publisher = {Routledge},
	shorttitle = {A Global Index of Anti-Immigrant Xenophobia},
	title = {A Global Index of Anti-Immigrant Xenophobia: Associations with Cultural Dimensions, National Well-Being, and Economic Indicators in 151 Nations},
