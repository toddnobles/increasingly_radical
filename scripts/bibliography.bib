@article{zinnRisktakingSocialInequality2023,
	abstract = {Even though risk-taking is a common and widespread social experience sociological theorizing on the concept is scarce. This contribution aims to systematize and advance understanding of risk-taking and its different forms and how these connect to social inequalities and the social machinery. It considers risk-taking in the context of the debate about Bourdieu's theory of practice and Archer's theory of morphogenesis before suggesting a conceptual framework that outlines different rationales, dimensions, and the role of agency for understanding risk-taking as an individual and as a collective activity. The concept highlights the ambivalent character of risk-taking as an expression and mode of reproducing inequalities and a crucial resource to overcome disadvantage and foster social change.},
	author = {Zinn, Jens O},
	date = {2023-03-13},
	doi = {10.1177/14407833231162865},
	file = {Zinn_2023_Risk-taking and social inequality144078332311628.pdf},
	issn = {1440-7833, 1741-2978},
	journaltitle = {Journal of Sociology},
	langid = {english},
	note = {\section{Annotations\\ (8/28/2023, 6:09:58 PM)} \par ``variety of motives for taking risks under different social conditions, such as basic needs (Maslow, 1970), protection of ontological security (Giddens, 1990), material desires, the quest for social recognition (Honneth, 1995) and feelings of self-worth (Mead, 1934), as well as the joy of exercising skills and courage (Lyng, 1990).'' (Zinn, 2023, p. 2) \par ``They underpin three ideal-type forms of risk-taking: when risk-taking is an end in itself, when risk-taking is a means to an end and when risks are taken in response to vulnerability'' (Zinn, 2023, p. 2) \par ``They underpin three ideal-type forms of risk-taking: when risk-taking is an end in itself, when risk-taking is a means to an end and when risks are taken in response to vulnerability. These systematically relate to the different capacities people have for shaping their life in different social contexts. Risk-taking can also become a central resource people from different walks of life use to shape their future and can be seen as an expression of people's everyday struggles patterned by social inequality. But it also indicates attempts to change the future towards more desirable trajectories or to protect one's future against dangers or threats.'' (Zinn, 2023, p. 2) \par ``Nevertheless, since the habitus emphasizes the unconscious or preconscious sources of people's practices, there is little support for ideas of conscious and reflexive responses informing social change. People's actions, whether they just adapt or try to break out from normal modes of behaviour might be, either way, simply a manifestation of the habitus contributing to the struggles within a social field. However, risk-taking might not only be part of the habitual repertoire of a social group but a resource for changing one's life or even social reality more broadly as well (e.g. through consciously opposing normative expectations), therefore conceptual work must consider the possibility of conscious engagement or risk-taking not only reproducing but also (contributing to) transforming the social world. There the article turns to Margaret Archer who, in the past 20 years, has significantly contributed to the systematization of reflexivity as a central dimension for understanding social change.'' (Zinn, 2023, p. 4) \par ``Archer highlights the limits of structural determinism of action when individual action is mainly the result of structural forces (downwards conflation), as she suggests would be the case in Bourdieu's practice theory.'' (Zinn, 2023, p. 4) \par ``This contrasts with individualist determinism of structure, such as in the case of rational choice theory, when structure results from the sum of individual activities (upwards conflation)'' (Zinn, 2023, p. 4) \par ``She also argues that middle conflation, the mutual constitution of structure and agency as posited in Giddens' (1984) structuration theory, fails to acknowledge that social structures as well as individuals follow their own rationales (analytical dualism)'' (Zinn, 2023, p. 4) \par ``morphogenesis (processes which elaborate and change a system) in contrast to morphostasis (processes which preserve a system) emphasizes that there is a time difference between the dynamic of structures and people's relatively independent reflexivity informing their responses.'' (Zinn, 2023, p. 4) \par ``communicative reflexivity people require continuous external confirmation to transform their internal conversation into action. This form of reflexivity would support social immobility and would lead on the macroscopic level to social reproduction.'' (Zinn, 2023, p. 5) \par ``Archer's focus on the mode of reflexivity rather than the consequentiality of different risks can be interpreted as a normative bias towards individualized forms of an autonomous self against which other forms are positioned as inferior (Skeggs, 2004, p. 45ff.). Consequently, social change is attributed to individualized modes of reflection in contrast to collective modes (interactive and collective) of change when people respond to and take risks together in the face of contingent but dangerous futures, seeking support and encouragement from family and extended social networks.'' (Zinn, 2023, p. 6) \par ``Thus, three aspects can be analytically distinguished even when they mix and combine: material gains (e.g. consumption, income), social recognition (cultural, political, legal) and a valued identity (e.g. staying true to oneself, protecting a valued self).'' (Zinn, 2023, p. 8) \par ``Figure 1. Rationales, agency and dimensions of risk-taking.'' (Zinn, 2023, p. 11) \par ``For a basic framework of risktaking, the article suggested that such risk-taking dimensions are observable to different degrees, but each dimension might typically dominate in one of three rationales of risk-taking: when risk-taking is an end in itself,aresponse to vulnerability or a means to an end.'' (Zinn, 2023, p. 14)},
	pages = {144078332311628},
	shortjournal = {Journal of Sociology},
	title = {Risk-Taking and Social Inequality},
	url = {http://journals.sagepub.com/doi/10.1177/14407833231162865},
	urldate = {2023-08-25},
	bdsk-url-1 = {http://journals.sagepub.com/doi/10.1177/14407833231162865},
	bdsk-url-2 = {https://doi.org/10.1177/14407833231162865}}

