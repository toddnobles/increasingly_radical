@article{shawLaboratoriesOligarchyHow2014,
	abstract = {Peer production projects like Wikipedia have inspired voluntary associations, collectives, social movements, and scholars to embrace open online collaboration as a model of democratic organization. However, many peer production projects exhibit entrenched leadership and deep inequalities, suggesting that they may not fulfill democratic ideals. Instead, peer production projects may conform to Robert Michels' ``iron law of oligarchy,'' which proposes that democratic membership organizations become increasingly oligarchic as they grow. Using exhaustive data of internal processes from a sample of 683 wikis, we construct empirical measures of participation and test for increases in oligarchy associated with growth in wikis' contributor bases. In contrast to previous studies, we find support for Michels' iron law and conclude that peer production entails oligarchic organizational forms.},
	author = {Shaw, Aaron and Hill, Benjamin M.},
	date = {2014-04-01},
	doi = {10.1111/jcom.12082},
	file = {Shaw_Hill_2014_Laboratories of Oligarchy215-238.pdf;../../../Zotero/storage/XBX3IPTX/4086105.html},
	issn = {0021-9916},
	journaltitle = {Journal of Communication},
	number = {2},
	pages = {215--238},
	shortjournal = {Journal of Communication},
	shorttitle = {Laboratories of {{Oligarchy}}?},
	title = {Laboratories of {{Oligarchy}}? {{How}} the {{Iron Law Extends}} to {{Peer Production}}},
	url = {https://doi.org/10.1111/jcom.12082},
	urldate = {2022-11-14},
	volume = {64},
	bdsk-url-1 = {https://doi.org/10.1111/jcom.12082}}

@article{shermanLeftDeclineRage2021,
	abstract = {For decades, and particularly since the 2016 election of Donald Trump, scholars and pundits alike have been trying to answer the question of why rural Americans overwhelmingly vote conservatively. Wuthnow's book is squarely located in this genre, alongside recent others such as Cramer's The Politics of Resentment and Hochschild's Strangers in Their Own Land. Based on a decade of research on rural America, the book is well situated to address this question. Wuthnow consciously positions this book as another explanation for the rise of Trump, and attempts to adjudicate between existing explanations of economic suffering versus racism and misogyny. The book does less to resolve this question than it does to elucidate the ways in which these issues are discussed by rural residents, as well as to introduce new explanations for their voting behaviors. Wuthnow presents rural towns as ``moral communities'' that are threatened by forces of modernity including deindustrialization, consolidation in the agricultural industry, population decline, and a host of social problems. The ensuing moral outrage, he argues, comes from ``a mixture of fear and anger'' (p. 6) that rural communities are both disappearing and under siege.},
	annotation = {0 citations (Crossref) [2024-05-04]},
	author = {Sherman, Jennifer},
	date = {2021-12-01},
	doi = {10.1093/sf/soy118},
	file = {Sherman_2021_The Left Behinde2.pdf;../../../Zotero/storage/FVGSYHV4/5239854.html},
	issn = {0037-7732},
	journaltitle = {Social Forces},
	number = {2},
	pages = {e2},
	shortjournal = {Social Forces},
	shorttitle = {The {{Left Behind}}},
	title = {The {{Left Behind}}: {{Decline}} and {{Rage}} in {{Rural America}}},
	url = {https://doi.org/10.1093/sf/soy118},
	urldate = {2024-05-03},
	volume = {100},
	bdsk-url-1 = {https://doi.org/10.1093/sf/soy118}}

